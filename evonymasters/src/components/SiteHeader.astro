---
const {active=''}=Astro.props;
const links=[{href:'/',label:'Home',key:'home'},{href:'/resources/',label:'Resource Finder',key:'resources'},{href:'/chests/',label:'Chest Finder',key:'chests'},{href:'/events/',label:'Events',key:'events'},{href:'/calendar/',label:'Calendar',key:'calendar'},{href:'/troops/',label:'March Preset',key:'troops'},{href:'/training/',label:'Troop Training',key:'training'}];
---
<header class="site-header"><div class="site-nav-wrap"><a class="site-brand" href="/">evony<span>masters</span></a><nav class="site-desktop-nav" aria-label="Main navigation">{links.map(link=><a href={link.href} aria-current={active===link.key?'page':undefined}>{link.label}</a>)}<span class="site-planned" title="Coming soon">Generals <small>Soon</small></span><span class="site-planned" title="Coming soon">Upgrades <small>Soon</small></span></nav><details class="site-mobile-menu"><summary aria-label="Open navigation menu">☰ <span>Menu</span></summary><nav aria-label="Mobile navigation">{links.map(link=><a href={link.href} aria-current={active===link.key?'page':undefined}>{link.label}</a>)}<span class="site-planned">Generals · Coming soon</span><span class="site-planned">Upgrades · Coming soon</span></nav></details></div></header>
<style is:global>
.site-header{background:#11243a;border-bottom:1px solid #30445c;position:relative;z-index:20}.site-nav-wrap{max-width:1440px;min-height:76px;margin:auto;padding:0 22px;display:flex;align-items:center;justify-content:space-between;gap:20px}.site-brand{font-size:1.45rem;font-weight:850;letter-spacing:-.04em;text-decoration:none;color:#eaf0f8;white-space:nowrap}.site-brand span{color:#e6bc73}.site-desktop-nav{display:flex;align-items:center;gap:15px}.site-desktop-nav a{color:#eaf0f8;text-decoration:none;font-size:.93rem;font-weight:700;white-space:nowrap}.site-desktop-nav a:hover,.site-desktop-nav a[aria-current=page]{color:#e6bc73}.site-planned{color:#a9bcd0;font-size:.88rem;white-space:nowrap}.site-planned small{font-size:.68rem;color:#e6bc73}.site-mobile-menu{display:none;position:relative}.site-mobile-menu summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:9px;border:1px solid #58708a;border-radius:9px;padding:9px 12px;color:#eaf0f8;font-weight:750}.site-mobile-menu summary::-webkit-details-marker{display:none}.site-mobile-menu nav{position:absolute;right:0;top:calc(100% + 10px);min-width:225px;display:flex;flex-direction:column;background:#11243a;border:1px solid #58708a;border-radius:12px;box-shadow:0 12px 25px #0008;padding:8px}.site-mobile-menu nav a,.site-mobile-menu nav .site-planned{padding:12px;border-radius:7px;text-decoration:none;color:#eaf0f8;font-size:.95rem}.site-mobile-menu nav a:hover,.site-mobile-menu nav a[aria-current=page]{background:#203a52;color:#e6bc73}.site-mobile-menu nav .site-planned{color:#a9bcd0}@media(max-width:1240px){.site-desktop-nav{display:none}.site-mobile-menu{display:block}}

/* EvonyMasters illustrated page banners. The original site artwork is a
   fallback until the optimized page-specific assets are present. */
.banner-hero{--hero-art:none;position:relative;isolation:isolate;overflow:hidden;
 background-image:linear-gradient(90deg,rgba(5,14,27,.83) 0%,rgba(6,19,35,.76) 44%,rgba(6,19,35,.23) 100%),var(--hero-art),url('/images/home/evonymasters-home-hero.webp') !important;
 background-size:cover,cover,cover !important;background-position:center,center,center !important;
 background-repeat:no-repeat !important;
 border-bottom:1px solid rgba(225,182,105,.48);
}
.banner-hero>*{position:relative;z-index:1}
.banner-hero h1,.banner-hero h2,.banner-hero p,.banner-hero .eyebrow{position:relative;z-index:1;text-shadow:0 2px 8px #03101de0,0 0 24px #03101dce}
.banner-hero h1{color:#f4d18c}
.banner-hero.banner-home{--hero-art:url('/images/banners/home.webp')}
.banner-hero.banner-resources{--hero-art:url('/images/banners/resources.webp')}
.banner-hero.banner-chests{--hero-art:url('/images/banners/chests.webp')}
.banner-hero.banner-events{--hero-art:url('/images/banners/events.webp')}
.banner-hero.banner-calendar{--hero-art:url('/images/banners/calendar.webp')}
.banner-hero.banner-march-preset{--hero-art:url('/images/banners/march-preset.webp')}
.banner-hero.banner-troop-training{--hero-art:url('/images/banners/troop-training.webp')}
.banner-hero.banner-generals{--hero-art:url('/images/banners/generals.webp')}
.banner-home:before{background:linear-gradient(90deg,rgba(4,12,22,.65),rgba(5,16,29,.15)) !important;opacity:1 !important}
.banner-march-preset,.banner-troop-training{border:1px solid #b48b4c;border-radius:14px;margin-bottom:22px;padding:clamp(22px,4vw,50px) clamp(20px,4vw,50px);min-height:235px;display:flex;flex-direction:column;justify-content:center}
.banner-march-preset h1,.banner-troop-training h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(2rem,3.6vw,3.4rem)}
.banner-march-preset p,.banner-troop-training .lead{max-width:760px;background:rgba(5,17,31,.45);padding:10px 12px;border-radius:8px}
.banner-resources,.banner-chests,.banner-events,.banner-calendar,.banner-generals{min-height:220px}
.banner-resources>.wrap,.banner-chests>.wrap,.banner-events>.wrap,.banner-calendar>.wrap,.banner-generals>.wrap{position:relative;z-index:1}
@media(max-width:760px){
 .banner-hero{background-image:linear-gradient(90deg,rgba(5,14,27,.91),rgba(5,14,27,.68)),var(--hero-art),url('/images/home/evonymasters-home-hero.webp') !important;
 background-position:center,center center,center !important}
 .banner-march-preset,.banner-troop-training{min-height:190px}
}

</style>