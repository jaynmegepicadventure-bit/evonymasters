---
const {active=''}=Astro.props;
const links=[
 {href:'/',label:'Home',key:'home',icon:'M3 10.5 12 3l9 7.5M5 9v12h14V9M9 21v-7h6v7'},
 {href:'/resources/',label:'Item Finder',key:'resources',icon:'M11 11m-7 0a7 7 0 1 0 14 0a7 7 0 1 0-14 0M16 16l5 5'},
 {href:'/chests/',label:'Chest Finder',key:'chests',icon:'M3 10h18v11H3zM3 10l3-6h12l3 6M12 10v11M10 14h4'},
 {href:'/loot-compass/',label:'Loot Compass',key:'loot-compass',icon:'M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20M16 8l-3 6-5 2 3-6z'},
 {href:'/calendar/',label:'Calendar',key:'calendar',icon:'M4 5h16v16H4zM4 10h16M8 3v4M16 3v4M8 14h3M13 14h3M8 18h3'},
 {href:'/troops/',label:'March Preset',key:'troops',icon:'M4 20 20 4M3 13l8 8M13 3l8 8M4 4l16 16'},
 {href:'/training/',label:'Troop Training',key:'training',icon:'M12 3 4 7v6c0 5 3 7 8 9 5-2 8-4 8-9V7zM9 11l3 3 4-5'},
 {href:'/building-upgrades/',label:'Building Upgrades',key:'building-upgrades',icon:'M3 21h18M5 21V8l7-5 7 5v13M9 21v-7h6v7M9 10h.01M15 10h.01'},
 {href:'/qa/',label:'Q&A',key:'qa',icon:'M4 4h16v13H9l-5 4zM8 9h8M8 13h5'},
 {href:'/about/',label:'About',key:'about',icon:'M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20M12 11v6M12 7h.01'},
 {href:'/contact/',label:'Feedback',key:'contact',icon:'M3 6h18v12H3zM3 7l9 7 9-7'}
];
---
<header class="site-header">
 <div class="site-nav-wrap">
  <a class="site-brand" href="/" aria-label="EvonyMasters home"><img class="site-brand-icon" src="/favicon.svg" alt="" width="40" height="40" decoding="async"/><span class="brand-wordmark">Evony<span>Masters</span><small>Player strategy tools</small></span></a>
  <nav class="site-desktop-nav" aria-label="Main navigation">
   {links.map(link=><a href={link.href} aria-current={active===link.key?'page':undefined} title={link.label}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={link.icon}/></svg><span>{link.label}</span></a>)}
  </nav>
  <details class="site-mobile-menu"><summary aria-label="Open navigation menu"><span aria-hidden="true">☰</span> Menu</summary><nav aria-label="Mobile navigation">
   {links.map(link=><a href={link.href} aria-current={active===link.key?'page':undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={link.icon}/></svg>{link.label}</a>)}
<a href="/privacy/">Privacy Policy</a>
  </nav></details>
 </div>
</header>
<style is:global>
.site-header{position:relative;z-index:30;background:linear-gradient(180deg,#071322,#0b1b30);border-bottom:1px solid #c39951;box-shadow:0 3px 20px #0007}
.site-nav-wrap{max-width:1560px;min-height:86px;padding:9px 24px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:22px}
.site-brand{display:inline-flex;align-items:center;gap:11px;text-decoration:none;color:#f6f0e6;white-space:nowrap;flex-shrink:0}
.site-brand-icon{width:40px;height:40px;border-radius:10px;box-shadow:0 0 18px #d4a85725}
.brand-wordmark{font-size:1.5rem;font-weight:900;letter-spacing:-.045em;line-height:1.05}.brand-wordmark>span{color:#f2c572}.brand-wordmark small{display:block;font-size:.57rem;color:#afc2d4;letter-spacing:.19em;text-transform:uppercase;margin-top:6px;font-weight:750}
.site-desktop-nav{display:flex;align-items:center;gap:clamp(5px,.65vw,12px);flex-wrap:nowrap}
.site-desktop-nav a{min-width:63px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-decoration:none;color:#e5edf7;padding:9px 5px 7px;border-radius:10px;font-weight:750;font-size:.73rem;white-space:nowrap;transition:background .2s,color .2s,transform .2s}
.site-desktop-nav a svg{width:22px;height:22px;color:#f0bb62;transition:transform .2s}
.site-desktop-nav a:hover,.site-desktop-nav a[aria-current=page]{background:#d9a95c16;color:#ffe1a2}
.site-desktop-nav a:hover svg{transform:translateY(-2px)}
.site-desktop-nav a[aria-current=page]{box-shadow:inset 0 -2px #e7b45b}
.site-planned{font-size:.72rem;color:#9cadbe;white-space:nowrap}.site-planned small{color:#d9ad62;font-size:.64rem}
.site-mobile-menu{display:none;position:relative}
.site-mobile-menu summary{cursor:pointer;display:flex;gap:10px;align-items:center;list-style:none;border:1px solid #b48952;border-radius:9px;padding:10px 14px;color:#f6d495;font-weight:850}
.site-mobile-menu summary::-webkit-details-marker{display:none}
.site-mobile-menu nav{position:absolute;right:0;top:calc(100% + 12px);width:min(330px,calc(100vw - 28px));max-height:75vh;overflow-y:auto;display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:12px;background:#0b1c30;border:1px solid #a47d45;border-radius:14px;box-shadow:0 22px 45px #000c}
.site-mobile-menu nav a,.site-mobile-menu nav .site-planned{display:flex;align-items:center;gap:10px;padding:12px 9px;border-radius:8px;text-decoration:none;font-size:.85rem;color:#e6edf5}
.site-mobile-menu nav a svg{width:19px;height:19px;flex-shrink:0;color:#e4b45f}
.site-mobile-menu nav a:hover,.site-mobile-menu nav a[aria-current=page]{background:#253b52;color:#ffdfa1}
.site-mobile-menu nav .site-planned{color:#aebed0}
.site-header a:focus-visible,.site-mobile-menu summary:focus-visible{outline:2px solid #f6d087;outline-offset:3px}
@media(max-width:1350px){.site-desktop-nav{display:none}.site-mobile-menu{display:block}}
@media(max-width:600px){.site-nav-wrap{min-height:66px;padding:8px 16px}.site-brand-icon{width:34px;height:34px}.brand-wordmark{font-size:1.2rem}.brand-wordmark small{font-size:.46rem}.site-mobile-menu nav{grid-template-columns:1fr 1fr}}
/* EvonyMasters illustrated page banners. When a page-specific image is absent,
   use the navy background instead of repeating the homepage illustration. */
.banner-hero{--hero-art:none;position:relative;isolation:isolate;overflow:hidden;
 background-color:#10273e;
 background-image:linear-gradient(90deg,rgba(5,14,27,.83) 0%,rgba(6,19,35,.76) 44%,rgba(6,19,35,.23) 100%),var(--hero-art) !important;
 background-size:cover,cover !important;background-position:center,center !important;
 background-repeat:no-repeat !important;
 border-bottom:1px solid rgba(225,182,105,.48);
}
.banner-hero>*{position:relative;z-index:1}
.banner-hero h1,.banner-hero h2,.banner-hero p,.banner-hero .eyebrow{position:relative;z-index:1;text-shadow:0 2px 8px #03101de0,0 0 24px #03101dce}
.banner-hero h1{color:#f4d18c}
.banner-hero.banner-home{--hero-art:url('/images/banners/home.webp')}
.banner-hero.banner-resources{--hero-art:url('/images/banners/resources.webp')}
.banner-hero.banner-chests{--hero-art:url('/images/banners/chests.webp')}
.banner-hero.banner-events{--hero-art:url('/images/banners/events.webp')}
.banner-hero.banner-calendar{--hero-art:url('/images/banners/calendar.webp')}
.banner-hero.banner-march-preset{--hero-art:url('/images/banners/march-preset.webp')}
.banner-hero.banner-troop-training{--hero-art:url('/images/banners/troop-training.webp')}
.banner-hero.banner-generals{--hero-art:url('/images/banners/generals.webp')}
.banner-home:before{background:linear-gradient(90deg,rgba(4,12,22,.65),rgba(5,16,29,.15)) !important;opacity:1 !important}
.banner-march-preset,.banner-troop-training{border:1px solid #b48b4c;border-radius:14px;margin-bottom:22px;padding:clamp(22px,4vw,50px) clamp(20px,4vw,50px);min-height:235px;display:flex;flex-direction:column;justify-content:center}
.banner-march-preset h1,.banner-troop-training h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(2rem,3.6vw,3.4rem)}
.banner-march-preset p,.banner-troop-training .lead{max-width:760px;background:rgba(5,17,31,.45);padding:10px 12px;border-radius:8px}
.banner-resources,.banner-chests,.banner-events,.banner-calendar,.banner-generals{min-height:220px}
.banner-resources>.wrap,.banner-chests>.wrap,.banner-events>.wrap,.banner-calendar>.wrap,.banner-generals>.wrap{position:relative;z-index:1}
@media(max-width:760px){
 .banner-hero{background-image:linear-gradient(90deg,rgba(5,14,27,.91),rgba(5,14,27,.68)),var(--hero-art) !important;
 background-position:center,center center !important}
 .banner-march-preset,.banner-troop-training{min-height:190px}
}

</style>