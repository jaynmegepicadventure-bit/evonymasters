---
const {active=''}=Astro.props;
const links=[{href:'/',label:'Home',key:'home'},{href:'/resources/',label:'Resource Finder',key:'resources'},{href:'/events/',label:'Events',key:'events'},{href:'/generals/',label:'Generals',key:'generals'}];
---
<header class="site-header"><div class="site-nav-wrap"><a class="site-brand" href="/">evony<span>masters</span></a><nav class="site-desktop-nav" aria-label="Main navigation">{links.map(link=><a href={link.href} aria-current={active===link.key?'page':undefined}>{link.label}</a>)}<span class="site-planned" title="Coming soon">Upgrades <small>Soon</small></span></nav><details class="site-mobile-menu"><summary aria-label="Open navigation menu">☰ <span>Menu</span></summary><nav aria-label="Mobile navigation">{links.map(link=><a href={link.href} aria-current={active===link.key?'page':undefined}>{link.label}</a>)}<span class="site-planned">Upgrades · Coming soon</span></nav></details></div></header>
<style is:global>
.site-header{background:#11243a;border-bottom:1px solid #30445c;position:relative;z-index:20}.site-nav-wrap{max-width:1150px;min-height:76px;margin:auto;padding:0 22px;display:flex;align-items:center;justify-content:space-between;gap:20px}.site-brand{font-size:1.45rem;font-weight:850;letter-spacing:-.04em;text-decoration:none;color:#eaf0f8;white-space:nowrap}.site-brand span{color:#e6bc73}.site-desktop-nav{display:flex;align-items:center;gap:21px}.site-desktop-nav a{color:#eaf0f8;text-decoration:none;font-size:.93rem;font-weight:700;white-space:nowrap}.site-desktop-nav a:hover,.site-desktop-nav a[aria-current=page]{color:#e6bc73}.site-planned{color:#a9bcd0;font-size:.88rem;white-space:nowrap}.site-planned small{font-size:.68rem;color:#e6bc73}.site-mobile-menu{display:none;position:relative}.site-mobile-menu summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:9px;border:1px solid #58708a;border-radius:9px;padding:9px 12px;color:#eaf0f8;font-weight:750}.site-mobile-menu summary::-webkit-details-marker{display:none}.site-mobile-menu nav{position:absolute;right:0;top:calc(100% + 10px);min-width:225px;display:flex;flex-direction:column;background:#11243a;border:1px solid #58708a;border-radius:12px;box-shadow:0 12px 25px #0008;padding:8px}.site-mobile-menu nav a,.site-mobile-menu nav .site-planned{padding:12px;border-radius:7px;text-decoration:none;color:#eaf0f8;font-size:.95rem}.site-mobile-menu nav a:hover,.site-mobile-menu nav a[aria-current=page]{background:#203a52;color:#e6bc73}.site-mobile-menu nav .site-planned{color:#a9bcd0}@media(max-width:850px){.site-desktop-nav{display:none}.site-mobile-menu{display:block}}
</style>