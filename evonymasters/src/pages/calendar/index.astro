---
import SiteHeader from '../../components/SiteHeader.astro';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="EvonyMasters event planner: browse upcoming events, scheduled monster categories and rewards in Evony UTC."/>
<link rel="icon" href="/favicon.svg"/><title>Event Planner | EvonyMasters</title>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#eef4f9;background:#0a1625}*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at top right,#192e45 0,transparent 54%),#0a1625}a{color:#f4c879}
.wrap{width:min(1240px,100%);margin:auto;padding:0 24px}
.hero{padding:43px 0 28px;background:linear-gradient(112deg,#172e46,#101f34);border-bottom:1px solid #435873}
.eyebrow{font-size:.73rem;font-weight:850;text-transform:uppercase;letter-spacing:.16em;color:#edbe73}
h1{font-family:Georgia,serif;font-size:clamp(2.4rem,5vw,3.8rem);line-height:1.1;letter-spacing:-.04em;margin:12px 0 10px;color:#fff0d3}
.hero p{font-size:.95rem;line-height:1.6;color:#bfcedd;max-width:790px}
.hero-links{display:flex;flex-wrap:wrap;gap:20px;margin-top:15px;font-size:.86rem;font-weight:750}
main{padding:27px 0 65px}.overview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:22px}
.metric{background:#152c40;border:1px solid #365671;border-radius:12px;padding:16px 18px;min-width:0}.metric small{display:block;color:#a8bece;text-transform:uppercase;font-size:.7rem;font-weight:850;letter-spacing:.08em}.metric strong{display:block;font-size:clamp(1.6rem,3vw,2.4rem);margin:5px 0 1px;color:#fff4de;font-variant-numeric:tabular-nums}.metric:first-child strong{color:#92e1ad}
.toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:13px;margin:21px 0 16px}.seg{display:inline-flex;border:1px solid #4f6d87;border-radius:10px;overflow:hidden;background:#172c41}.control{background:#1d3851;color:#dde9f3;border:1px solid #5c7590;border-radius:9px;padding:9px 13px;font:inherit;font-weight:700;cursor:pointer}.seg .control{border:0;border-radius:0}.seg .control+.control{border-left:1px solid #4f6d87}.control[aria-pressed=true],.control.primary{background:#f0c977;color:#14293d}.control:hover{filter:brightness(1.13)}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #f1cb7b;outline-offset:3px}
.range-title{font-size:1.26rem;color:#f0ce90;margin:0}.navigation{display:flex;gap:7px;align-items:center}.filter{display:flex;gap:10px;align-items:center;font-size:.82rem;color:#bdd1e0}.filter select,.filter input{background:#1b334c;border:1px solid #5d7690;border-radius:8px;padding:9px;color:#fff;font:inherit}.filter input{min-width:150px;max-width:235px}
.planner{border:1px solid #3a536c;border-radius:15px;padding:16px;background:#11263a}.week-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}.month-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}
.weekday{font-size:.72rem;color:#abc2d4;font-weight:800;text-align:center;padding:4px}
.date-card{display:flex;flex-direction:column;align-items:stretch;text-align:left;gap:9px;min-width:0;min-height:145px;border:1px solid #385773;border-radius:11px;padding:12px 10px;background:#1b344b;color:#eaf4fb;font:inherit;cursor:pointer}
.date-card:hover{background:#24445d}.date-card.selected{border:2px solid #f0c978;padding:11px 9px;background:#25445b}.date-card.today .date-number{color:#96ebae}
.date-card.outside{opacity:.44}.date-name{font-size:.72rem;color:#aac3d9}.date-number{font-size:1.27rem;color:#f5e1b7;font-weight:850}
.date-summary{display:grid;gap:5px;font-size:.75rem;line-height:1.28}.event-count{color:#f6d48e}.monster-count{color:#91dfb0}.faint{color:#9cb2c6}
.date-card.month{min-height:86px;padding:7px;gap:3px;border-radius:8px}.date-card.month.selected{padding:6px}.date-card.month .date-number{font-size:.93rem}.date-card.month .date-summary{font-size:.65rem}
.details{margin-top:22px;display:grid;grid-template-columns:minmax(0,1fr) minmax(290px,.92fr);gap:17px;align-items:start}
.panel{background:#122a40;border:1px solid #3c5871;border-radius:14px;padding:19px}.panel h2{font-size:1.25rem;color:#f1cf91;margin:0 0 7px}.panel .desc{font-size:.83rem;color:#b6cad9;margin:0 0 18px}
.section-title{margin:18px 0 10px;color:#e9bc71;font-size:.87rem;text-transform:uppercase;letter-spacing:.06em}.section-title:first-child{margin-top:0}
.event-list{display:grid;gap:10px}.event-card{border:1px solid #45647b;background:#1b374f;border-radius:11px;padding:14px;display:flex;gap:13px;align-items:center}.event-symbol{width:44px;height:44px;display:grid;place-items:center;border:1px solid #8b7145;background:#403829;color:#f3d391;border-radius:10px;font-size:1.3rem;flex:none}.event-info{min-width:0;flex:1}.event-info strong{display:block;font-size:.92rem}.event-info small{display:block;color:#b1c8da;margin-top:4px}.event-card a{font-size:.77rem;font-weight:750;white-space:nowrap}.tag{display:inline-block;font-size:.67rem;border-radius:999px;background:#2e4a64;padding:4px 8px;color:#d8e8f4}.tag.live{color:#9aefb7;background:#20503b}
.monster-group{border:1px solid #47657a;border-radius:11px;background:#1a344b;margin:9px 0;overflow:hidden}
.monster-toggle{display:flex;align-items:center;gap:10px;padding:14px;width:100%;background:transparent;border:0;text-align:left;color:#eef5fa;font:inherit;cursor:pointer}.monster-toggle:hover{background:#25435c}.monster-icon{font-size:1.2rem}.monster-label{font-weight:800;flex:1}.monster-count-label{color:#b2cad9;font-size:.75rem}.chevron{color:#e8c579;font-size:1.1rem}.monster-body{border-top:1px solid #3b5970;padding:12px 14px;background:#142b41}
.monster-body[hidden]{display:none!important}.monster-search{display:block;width:100%;margin-bottom:10px;padding:10px 12px;border-radius:8px;background:#edf3f7;border:1px solid #8199aa;color:#132639;font:inherit}
.monster-list{list-style:none;padding:0;margin:0;display:grid;gap:5px;max-height:370px;overflow:auto}
.monster-list li{display:flex;justify-content:space-between;align-items:center;gap:9px;padding:9px;border-radius:7px;background:#1c3850;font-size:.85rem}.monster-list a{font-size:.75rem}
.empty{color:#adc5d5;font-size:.85rem;line-height:1.5;padding:12px 0}.calendar-note{color:#9fb6c8;font-size:.78rem;margin:16px 0}
.agenda-list{display:grid;gap:12px}.agenda-day{border:1px solid #395671;border-radius:11px;background:#1c364f;padding:15px}.agenda-day h3{margin:0 0 10px;font-size:.96rem;color:#f1d08e}.agenda-day .summary-line{display:flex;flex-wrap:wrap;gap:8px;font-size:.82rem}
footer{border-top:1px solid #29445c;color:#9fb5c7;font-size:.8rem;padding:24px 0}
@media(max-width:850px){.details{grid-template-columns:1fr}.week-grid{gap:4px}.date-card{min-height:115px;padding:9px 6px}.date-card.selected{padding:8px 5px}.date-summary{font-size:.68rem}.event-card{flex-wrap:wrap}}
@media(max-width:590px){.wrap{padding:0 13px}.hero{padding:29px 0}.overview{gap:5px}.metric{padding:11px 9px}.metric small{font-size:.59rem}.planner{padding:8px}.week-grid,.month-grid{gap:3px}.date-card{min-height:82px;padding:7px 3px;border-radius:7px;gap:5px}.date-card.selected{padding:6px 2px}.date-number{font-size:1rem}.date-name{font-size:.6rem}.date-summary{font-size:.6rem;gap:3px}.date-card.month{min-height:63px;padding:4px 2px}.date-card.month.selected{padding:3px 1px}.date-card.month .date-summary{font-size:.56rem}.panel{padding:14px}.filter input{min-width:115px;max-width:165px}.event-card a{white-space:normal}}
</style></head>
<body><SiteHeader active="calendar"/>
<header class="hero"><div class="wrap"><div class="eyebrow">EvonyMasters / Event Planner</div><h1>Never miss your next move.</h1>
<p>See what's on the horizon, spot your next monster hunt and line up the events worth watching. Times follow <strong>Evony server time (UTC)</strong>.</p>
<div class="hero-links"><a href="/events/">Explore event rewards ↗</a><a href="/resources/">Resource Finder ↗</a><a href="https://evonymasters-calendar.jaynmegepicadventure.workers.dev/admin/">Admin dashboard ↗</a></div>
</div></header>
<main class="wrap">
<section class="overview" aria-label="Today's schedule summary">
<div class="metric"><small>Events on selected day</small><strong id="metric-events">—</strong></div>
<div class="metric"><small>Monster families on selected day</small><strong id="metric-monsters">—</strong></div>
<div class="metric"><small>Upcoming events in view</small><strong id="metric-upcoming">—</strong></div>
</section>
<div class="toolbar">
<div class="seg" role="group" aria-label="Calendar view">
<button class="control" data-view="week" aria-pressed="true">Week</button><button class="control" data-view="month" aria-pressed="false">Month</button><button class="control" data-view="agenda" aria-pressed="false">Agenda</button>
</div>
<div class="navigation"><button class="control" id="prev" aria-label="Previous date range">‹</button><button class="control primary" id="today">Today</button><button class="control" id="next" aria-label="Next date range">›</button></div>
</div>
<div class="toolbar"><h2 class="range-title" id="heading">Loading calendar…</h2><div class="filter"><label for="category">Show</label><select id="category"><option value="all">Events &amp; monsters</option><option value="Event">Events only</option><option value="monsters">Monsters only</option><option value="Boss">Boss monsters</option><option value="Event Boss">Event bosses</option><option value="Regular Monster">Regular monsters</option></select></div></div>
<div class="planner" id="planner" aria-label="Schedule date navigator"></div>
<div class="details">
<section class="panel" aria-labelledby="day-title"><h2 id="day-title">Selected day</h2><p class="desc" id="day-subtitle">Select a date to view its scheduled activity.</p><div id="day-events"></div></section>
<section class="panel" aria-labelledby="monster-title"><h2 id="monster-title">Monster availability</h2><p class="desc">Categories only. Open a category to see its full list of scheduled monsters and levels.</p><div id="monster-groups"></div></section>
</div>
<p class="calendar-note" id="status" role="status">Loading published schedules…</p>

</main>

<script is:inline>
(()=>{"use strict";
const API="https://evonymasters-calendar.jaynmegepicadventure.workers.dev/api/events";
const $=id=>document.getElementById(id),today=new Date().toISOString().slice(0,10);
const dateFrom=value=>new Date(value+"T00:00:00Z"),dateString=date=>date.toISOString().slice(0,10);
const addDays=(d,count)=>new Date(d.getTime()+count*86400000),weekStart=d=>addDays(d,-((d.getUTCDay()+6)%7));
const monthStart=d=>new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),1));
const format=(d,options={month:"short",day:"numeric",year:"numeric"})=>new Intl.DateTimeFormat("en-GB",{timeZone:"UTC",...options}).format(dateFrom(d));
const collator=new Intl.Collator("en",{numeric:true,sensitivity:"base"});
const kinds=["Boss","Event Boss","Regular Monster"],labels={"Boss":"Boss Monsters","Event Boss":"Event Bosses","Regular Monster":"Regular Monsters"};
const icons={"Boss":"⚔","Event Boss":"🐉","Regular Monster":"♞"};
const text=(v)=>String(v??"").trim();
const el=(tag,cls,content)=>{const x=document.createElement(tag);if(cls)x.className=cls;if(content!==undefined)x.textContent=String(content);return x};
const canonical=e=>text(e.name).replace(/\s*·\s*Lv\s*\d+$/i,"").trim();
let focus=dateFrom(today),selected=today,view="week",events=[],loading=false,error=false,serial=0;
let rangeFrom="",rangeTo="",category="all";
const allowEvents=()=>category==="all"||category==="Event";
const allowKind=kind=>category==="all"||category==="monsters"||category===kind;
const dedupe=items=>{const m=new Map();for(const e of items){const key=e.kind+"|"+canonical(e).toLowerCase();if(!m.has(key))m.set(key,{name:canonical(e),kind:e.kind,level:e.level||"",id:e.sourceId});}return [...m.values()].sort((a,b)=>collator.compare(a.name,b.name))};
const byDay=day=>events.filter(e=>e.date===day);
const summarized=day=>{const rows=byDay(day);const eventsOnly=dedupe(rows.filter(e=>e.kind==="Event"));const monsters={};for(const kind of kinds)monsters[kind]=dedupe(rows.filter(e=>e.kind===kind));return {events:eventsOnly,monsters}};
const totalMonsters=summary=>kinds.reduce((n,k)=>n+(allowKind(k)?summary.monsters[k].length:0),0);
const visibleKinds=summary=>kinds.filter(k=>allowKind(k)&&summary.monsters[k].length);
function createDateButton(day,mode="week"){
 const info=summarized(day),button=el("button","date-card"+(mode==="month"?" month":"")+(day===selected?" selected":"")+(day===today?" today":""));
 button.type="button";button.setAttribute("aria-pressed",String(day===selected));button.setAttribute("aria-label",format(day,{weekday:"long",month:"long",day:"numeric"})+", "+info.events.length+" events, "+totalMonsters(info)+" monster families");
 button.append(el("span","date-name",format(day,{weekday:"short"})),el("span","date-number",String(dateFrom(day).getUTCDate())));
 const summary=el("span","date-summary");
 if(allowEvents()&&info.events.length)summary.append(el("span","event-count",info.events.length+" event"+(info.events.length===1?"":"s")));
 const count=visibleKinds(info).length;
 if(count)summary.append(el("span","monster-count",count+" monster "+(count===1?"type":"types")));
 if(!summary.childElementCount)summary.append(el("span","faint","—"));
 button.append(summary);button.addEventListener("click",()=>{selected=day;focus=dateFrom(day);draw()});
 return button;
}
function eventCard(event,live){
 const card=el("article","event-card"),symbol=el("div","event-symbol","✦"),info=el("div","event-info");
 info.append(el("strong","",event.name));
 const sub=el("small","",live?"● LIVE · Scheduled today":"Scheduled event");
 info.append(sub);card.append(symbol,info);
 const link=el("a","","Rewards ↗");link.href="/events/?q="+encodeURIComponent(event.name);card.append(link);return card;
}
function renderEvents(summary){
 const root=$("day-events");root.replaceChildren();
 if(!allowEvents()){root.append(el("p","empty","Switch to Events or All to see this day's events."));return;}
 if(!summary.events.length){root.append(el("p","empty","No events scheduled on this day."));return;}
 const list=el("div","event-list");for(const event of summary.events)list.append(eventCard(event,selected===today));root.append(list);
}
function renderMonsterGroups(summary){
 const root=$("monster-groups");root.replaceChildren();
 if(category==="Event"){root.append(el("p","empty","Switch to All or a monster category to see available monsters."));return;}
 const active=visibleKinds(summary);
 if(!active.length){root.append(el("p","empty","No monster categories scheduled for this day."));return;}
 for(const kind of active){
  const items=summary.monsters[kind],section=el("section","monster-group"),toggle=el("button","monster-toggle");
  toggle.type="button";toggle.setAttribute("aria-expanded","false");toggle.append(el("span","monster-icon",icons[kind]),el("span","monster-label",labels[kind]),el("span","monster-count-label",items.length+" families"),el("span","chevron","⌄"));
  const body=el("div","monster-body");body.hidden=true;
  const input=el("input","monster-search");input.type="search";input.placeholder="Search "+labels[kind].toLowerCase();input.setAttribute("aria-label","Search "+labels[kind]);
  const list=el("ul","monster-list");
  const populate=()=>{
   const query=input.value.trim().toLowerCase();list.replaceChildren();
   for(const item of items.filter(v=>v.name.toLowerCase().includes(query))){
    const li=el("li"),name=el("span","",item.name),link=el("a","","Find rewards ↗");
    link.href="/resources/?q="+encodeURIComponent(item.name);
    li.append(name,link);list.append(li);
   }
   if(!list.childElementCount)list.append(el("li","empty","No matching monsters."));
  };
  input.addEventListener("input",populate);populate();body.append(input,list);
  toggle.addEventListener("click",()=>{body.hidden=!body.hidden;toggle.setAttribute("aria-expanded",String(!body.hidden));toggle.lastChild.textContent=body.hidden?"⌄":"⌃";if(!body.hidden)input.focus()});
  section.append(toggle,body);root.append(section);
 }
}
function renderSelection(){
 $("day-title").textContent=format(selected,{weekday:"long",month:"long",day:"numeric",year:"numeric"});
 $("day-subtitle").textContent=selected===today?"Today · Evony server time (UTC)":"Scheduled availability · Evony server time (UTC)";
 const info=summarized(selected);renderEvents(info);renderMonsterGroups(info);
}
function renderPlanner(){
 const root=$("planner");root.replaceChildren();$("prev").hidden=view==="agenda";$("next").hidden=view==="agenda";
 if(view==="agenda"){
  $("heading").textContent="Next 60 days";
  const list=el("div","agenda-list"),shown=new Set();
  for(const e of events){
   if(e.date<today)continue;
   const x=summarized(e.date);
   if(!(allowEvents()&&x.events.length||totalMonsters(x)))continue;
   if(shown.has(e.date))continue;
   shown.add(e.date);
   const a=el("article","agenda-day"),head=el("h3","",format(e.date,{weekday:"long",month:"long",day:"numeric"}));
   const lines=el("div","summary-line");
   if(allowEvents())for(const ev of x.events.slice(0,3))lines.append(el("span","tag",ev.name));
   for(const k of visibleKinds(x))lines.append(el("span","tag",labels[k]+" · "+x.monsters[k].length));
   a.append(head,lines);a.tabIndex=0;a.setAttribute("role","button");a.setAttribute("aria-label","View "+format(e.date));
   const select=()=>{selected=e.date;focus=dateFrom(selected);renderSelection();$("day-title").scrollIntoView({block:"nearest",behavior:"smooth"})};
   a.addEventListener("click",select);a.addEventListener("keydown",ev=>{if(ev.key==="Enter"||ev.key===" "){ev.preventDefault();select()}});list.append(a);
  }
  if(!list.childElementCount)list.append(el("p","empty","No upcoming schedules in this period."));
  root.append(list);return;
 }
 const month=view==="month",first=month?weekStart(monthStart(focus)):weekStart(focus);
 $("heading").textContent=month?format(dateString(monthStart(focus)),{month:"long",year:"numeric"}):format(dateString(first))+" – "+format(dateString(addDays(first,6)));
 const grid=el("div",month?"month-grid":"week-grid");
 if(month){for(const d of ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"])grid.append(el("span","weekday",d));}
 const count=month?42:7;
 for(let i=0;i<count;i++){
  const date=addDays(first,i),str=dateString(date),button=createDateButton(str,view);
  if(month&&date.getUTCMonth()!==focus.getUTCMonth())button.classList.add("outside");
  grid.append(button);
 }
 root.append(grid);
}
function renderMetrics(){
 const info=summarized(selected),upcoming=new Set(events.filter(e=>e.kind==="Event"&&e.date>today).map(e=>canonical(e).toLowerCase()));
 $("metric-events").textContent=info.events.length;
 $("metric-monsters").textContent=kinds.reduce((n,k)=>n+info.monsters[k].length,0);
 $("metric-upcoming").textContent=upcoming.size;
}
function draw(){
 for(const button of document.querySelectorAll("[data-view]"))button.setAttribute("aria-pressed",String(button.dataset.view===view));
 renderPlanner();renderSelection();renderMetrics();
}
function bounds(){
 if(view==="month"){const start=weekStart(monthStart(focus));return [dateString(start),dateString(addDays(start,41))];}
 if(view==="week"){const start=weekStart(focus);return [dateString(start),dateString(addDays(start,6))];}
 return [today,dateString(addDays(dateFrom(today),59))];
}
async function load(){
 const current=++serial,[from,to]=bounds();rangeFrom=from;rangeTo=to;
 loading=true;$("status").textContent="Loading published schedules…";
 try{
  const response=await fetch(API+"?"+new URLSearchParams({from,to,kind:"all",includeAlways:"true"}));
  if(!response.ok)throw Error("Calendar unavailable");
  const body=await response.json();if(!Array.isArray(body.events))throw Error("Invalid schedule response");
  if(current!==serial)return;
  events=body.events;events.sort((a,b)=>a.date.localeCompare(b.date)||collator.compare(a.name,b.name));
  error=false;$("status").textContent=body.truncated?"Some schedule records are too numerous to display completely. Try a shorter date range.":"Showing published schedules · Evony UTC.";
 }catch{if(current!==serial)return;error=true;events=[];$("status").textContent="Calendar temporarily unavailable. Your saved schedules have not been changed."}
 loading=false;draw();
}
$("prev").addEventListener("click",()=>{focus=view==="month"?new Date(Date.UTC(focus.getUTCFullYear(),focus.getUTCMonth()-1,1)):addDays(weekStart(focus),-7);selected=dateString(focus);load()});
$("next").addEventListener("click",()=>{focus=view==="month"?new Date(Date.UTC(focus.getUTCFullYear(),focus.getUTCMonth()+1,1)):addDays(weekStart(focus),7);selected=dateString(focus);load()});
$("today").addEventListener("click",()=>{focus=dateFrom(today);selected=today;load()});
for(const button of document.querySelectorAll("[data-view]"))button.addEventListener("click",()=>{view=button.dataset.view;load()});
$("category").addEventListener("change",()=>{category=$("category").value;draw()});
load();
})();
</script></body></html>