---
import SiteHeader from '../../components/SiteHeader.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="EvonyMasters March Preset Builder. Enter Archer, Cavalry, Ground and Siege march sizes, choose unlocked troop tiers, and calculate recommended troop counts."/>
<title>March Preset Builder | EvonyMasters</title><link rel="icon" href="/favicon.svg"/>
<style is:global>
:root{font-family:Inter,system-ui,-apple-system,sans-serif;background:#0a1929;color:#edf3fb}*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at 80% -15%,#253e52,transparent 47%),#0a1929}a{color:#edc77e}button,input,select{font:inherit}
.wrap{max-width:1300px;margin:0 auto;padding:0 24px}
.hero{padding:43px 0 29px;border-bottom:1px solid #415b74;background:linear-gradient(110deg,#162f47dd,#102237b0)}
.kicker{font-size:.74rem;color:#e4bd74;letter-spacing:.15em;font-weight:850;text-transform:uppercase}
h1{font-family:Georgia,serif;font-size:clamp(2.5rem,5.3vw,4rem);letter-spacing:-.045em;color:#fff0d1;line-height:1.1;margin:11px 0 13px}.hero p{line-height:1.65;color:#bed0e0;max-width:880px;margin:0}
.main{padding:28px 0 70px}
.overview{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin:0 0 19px}
.overview h2{font-size:1.27rem;color:#f4d08c;margin:0}.overview p{font-size:.83rem;color:#b4cbdc;margin:6px 0}
.btn{padding:10px 14px;background:#efc679;color:#17293b;border:1px solid #efc679;border-radius:9px;font-weight:800;cursor:pointer}.btn.alt{background:#23415b;color:#e7f0f7;border-color:#607d95}.btn:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #f0ce81;outline-offset:3px}
.columns{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;align-items:start}
.troop-card{border:1px solid #426078;border-radius:14px;background:#132d43;min-width:0;overflow:hidden}
.troop-top{padding:17px;background:linear-gradient(135deg,#20435d,#142e45);border-bottom:1px solid #426078}
.troop-top h3{font-size:1.22rem;color:#f6dbab;margin:0 0 6px;display:flex;align-items:center;gap:8px}
.icon{font-size:1.3rem}.troop-top p{margin:0;color:#bcd0e0;font-size:.77rem}
.troop-inputs{padding:15px}
.field{display:grid;gap:6px;color:#f2d49e;font-size:.79rem;font-weight:800;margin-bottom:14px}
.field input,.field select{width:100%;padding:10px 11px;border-radius:8px;border:1px solid #849bab;background:#f5f8fb;color:#142839;min-width:0}
.level-title{font-size:.77rem;color:#c5d5e1;font-weight:800;letter-spacing:.05em;text-transform:uppercase;margin:11px 0 8px}
.tier-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
.tier-chip{display:flex;align-items:center;gap:6px;background:#213e56;color:#ecf2fa;border:1px solid #4d7188;border-radius:8px;padding:9px 7px;font-weight:700;font-size:.84rem;cursor:pointer}
.tier-chip:has(input:checked){border-color:#eac477;background:#3a453f}.tier-chip input{accent-color:#e9c373;width:17px;height:17px;margin:0;cursor:pointer}
.result{border-top:1px solid #435f77;padding:16px;min-height:240px}
.result h4{font-size:.92rem;color:#f2d398;margin:0 0 12px}.result-status{color:#acbfd0;font-size:.78rem;line-height:1.5}
.result-summary{border:1px solid #376a59;background:#163d38;border-radius:9px;padding:10px;margin:0 0 13px}
.result-summary strong{color:#a6efc4;font-size:1.18rem;display:block}.result-summary small{font-size:.69rem;color:#c0dbce}
.allocation{width:100%;border-collapse:collapse}.allocation td{padding:8px 2px;border-bottom:1px solid #344e66;font-size:.81rem}.allocation td:last-child{text-align:right;color:#fff0d3;font-variant-numeric:tabular-nums;font-weight:750}
.support{color:#bfcedb;font-size:.74rem;line-height:1.5;margin-top:11px}.notice{border-left:3px solid #c9a162;background:#3e3226;color:#f3e0c2;font-size:.76rem;padding:10px;margin-top:10px;line-height:1.5}
.card-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.copy-btn{font-size:.75rem;padding:8px 11px}
.footer-note{margin:22px 0 0;color:#afc2d0;font-size:.78rem;line-height:1.6;padding:15px;border:1px solid #3f566b;border-radius:10px}
.error{color:#ffc0b5;font-size:.82rem;line-height:1.5}footer{border-top:1px solid #28445d;padding:25px 0;color:#a3bbcc;font-size:.8rem}
@media(max-width:1100px){.columns{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:580px){.wrap{padding:0 13px}.columns{grid-template-columns:1fr}.hero{padding:30px 0}.troop-card{display:grid;grid-template-columns:1fr}.troop-inputs{padding:16px}.tier-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.tier-chip{justify-content:center}}
</style></head>
<body><SiteHeader active="march"/>
<header class="hero"><div class="wrap"><span class="kicker">Player tools / Troop planning</span><h1>March Preset Builder</h1>
<p>Set your march size for each troop type, tick the troop levels you've unlocked, and get your recommended march automatically. No percentages to configure and no manual calculations.</p></div></header>
<main class="wrap main">
<div class="overview"><div><h2>Configure your four marches</h2><p>Use one column per troop type. Each march is calculated independently, based on its own size and unlocked tiers.</p></div><button id="all-tiers" class="btn alt" type="button">Unlock T13–T16 for all</button></div>
<div class="columns" id="march-columns">
<section class="troop-card" data-type="ranged"><div class="troop-top"><h3><span class="icon">🏹</span> Archer</h3><p>Ranged attack preset</p></div><div class="troop-inputs"><label class="field">Archer march size <input type="number" data-size min="1" max="100000000" step="1" placeholder="e.g. 7,393,200" inputmode="numeric"></label><div class="level-title">Unlocked troop tiers</div><div class="tier-grid" data-tiers></div></div><div class="result" data-result><p class="result-status">Enter your Archer march size to see a recommendation.</p></div></section>
<section class="troop-card" data-type="cavalry"><div class="troop-top"><h3><span class="icon">🐎</span> Cavalry</h3><p>Mounted attack preset</p></div><div class="troop-inputs"><label class="field">Cavalry march size <input type="number" data-size min="1" max="100000000" step="1" placeholder="e.g. 7,480,700" inputmode="numeric"></label><div class="level-title">Unlocked troop tiers</div><div class="tier-grid" data-tiers></div></div><div class="result" data-result><p class="result-status">Enter your Cavalry march size to see a recommendation.</p></div></section>
<section class="troop-card" data-type="ground"><div class="troop-top"><h3><span class="icon">🛡️</span> Ground</h3><p>Ground attack preset</p></div><div class="troop-inputs"><label class="field">Ground march size <input type="number" data-size min="1" max="100000000" step="1" placeholder="e.g. 7,486,400" inputmode="numeric"></label><div class="level-title">Unlocked troop tiers</div><div class="tier-grid" data-tiers></div></div><div class="result" data-result><p class="result-status">Enter your Ground march size to see a recommendation.</p></div></section>
<section class="troop-card" data-type="siege"><div class="troop-top"><h3><span class="icon">🏰</span> Siege</h3><p>Siege attack preset</p></div><div class="troop-inputs"><label class="field">Siege march size <input type="number" data-size min="1" max="100000000" step="1" placeholder="e.g. 6,013,200" inputmode="numeric"></label><label class="field">Siege preset type<select data-siege><option value="bigSiege">Big Siege</option><option value="smallSiege">Small Siege</option><option value="soloSiege">Solo Siege</option></select></label><div class="level-title">Unlocked troop tiers</div><div class="tier-grid" data-tiers></div></div><div class="result" data-result><p class="result-status">Enter your Siege march size to see a recommendation.</p></div></section>
</div>
<p class="footer-note"><strong>How these recommendations work:</strong> Presets are based on the uploaded <em>Troop Layers 2024.xlsx</em> workbook. Troop quantities are rounded to fit the march size exactly, with a separate lower-tier supporting-layers reserve. T1–T12 are assumed available. Because the 2024 workbook does not include T16, T16 recommendations are estimates. Use these as planning guides and check your troop inventory and actual battle setup before marching.</p>
</main><footer><div class="wrap">EvonyMasters · Independent community reference. The site's administrators maintain preset allocation rules.</div></footer>
<script is:inline>
(()=>{"use strict";
const ENDPOINT="https://evonymasters-calendar.jaynmegepicadventure.workers.dev/api/march-presets/calculate";
const names={ranged:"Archer",cavalry:"Cavalry",ground:"Ground",siege:"Siege"},defaults={ranged:7393200,cavalry:7480700,ground:7486400,siege:6013200};
const fmt=new Intl.NumberFormat("en-GB"),latest=new Map(),serial=new Map();
const node=(tag,cls,value)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(value!==undefined)e.textContent=String(value);return e};
function renderResult(card,data){
 const result=card.querySelector("[data-result]");result.replaceChildren();
 const title=node("h4","",data.label+" recommendation");result.append(title);
 const summary=node("div","result-summary");summary.append(node("small","","Total troops in march"),node("strong","",fmt.format(data.marchSize)));result.append(summary);
 const table=node("table","allocation");
 for(const item of data.rows){const tr=node("tr");tr.append(node("td","",item.tier?"T"+item.tier+" "+item.type:item.label||"Lower-tier support layers"),node("td","",fmt.format(item.count)));table.append(tr)}
 result.append(table);
 const footer=node("p","support","Primary troops: "+fmt.format(data.mainTroops)+" · Supporting layers: "+fmt.format(data.reserve));result.append(footer);
 for(const warning of data.warnings||[])result.append(node("div","notice",warning));
 const actions=node("div","card-actions"),copy=node("button","btn alt copy-btn","Copy this preset");copy.type="button";
 copy.addEventListener("click",async()=>{const lines=[data.label+" · "+fmt.format(data.marchSize)+" troops",...data.rows.map(r=>(r.tier?"T"+r.tier+" "+r.type:r.label)+": "+fmt.format(r.count))];try{await navigator.clipboard.writeText(lines.join("\n"));copy.textContent="Copied!"}catch{copy.textContent="Copy unavailable"}});
 actions.append(copy);result.append(actions);
}
async function calculate(card){
 const type=card.dataset.type,id=(serial.get(type)||0)+1;serial.set(type,id);
 const input=card.querySelector("[data-size]"),raw=input.value.trim(),root=card.querySelector("[data-result]");
 if(!raw){root.replaceChildren(node("p","result-status","Enter your "+names[type]+" march size to see a recommendation."));return}
 const marchSize=Number(raw);
 if(!Number.isSafeInteger(marchSize)||marchSize<1||marchSize>100000000){root.replaceChildren(node("p","error","Enter a valid march size from 1 to 100,000,000."));return}
 const kind=type==="siege"?card.querySelector("[data-siege]").value:type;
 const unlocked={Ranged:{},Cavalry:{},Ground:{},Siege:{}};
 for(const current of document.querySelectorAll("[data-type]")){
  const key=current.dataset.type==="ranged"?"Ranged":current.dataset.type==="cavalry"?"Cavalry":current.dataset.type==="ground"?"Ground":"Siege";
  for(const tier of [13,14,15,16])unlocked[key][tier]=current.querySelector('input[data-tier="'+tier+'"]').checked;
 }
 root.replaceChildren(node("p","result-status","Calculating…"));
 try{const r=await fetch(ENDPOINT,{method:"POST",mode:"cors",headers:{"content-type":"application/json"},body:JSON.stringify({marchSize,preset:kind,unlocked})});const data=await r.json();if(id!==serial.get(type))return;if(!r.ok)throw Error(data.error||"Calculation unavailable");latest.set(type,data);renderResult(card,data)}
 catch(e){if(id!==serial.get(type))return;root.replaceChildren(node("p","error","Couldn't calculate this march. "+(e.message||"Please try again.")))}
}
const timers=new Map();
for(const card of document.querySelectorAll("[data-type]")){
 const type=card.dataset.type,grid=card.querySelector("[data-tiers]");
 for(const tier of [13,14,15,16]){const label=node("label","tier-chip"),check=node("input");check.type="checkbox";check.dataset.tier=tier;check.checked=tier<=14;check.addEventListener("change",()=>{for(const column of document.querySelectorAll("[data-type]"))calculate(column)});label.append(check,document.createTextNode("T"+tier));grid.append(label)}
 const size=card.querySelector("[data-size]");
 size.addEventListener("input",()=>{clearTimeout(timers.get(type));timers.set(type,setTimeout(()=>calculate(card),300))});
 const selector=card.querySelector("[data-siege]");if(selector)selector.addEventListener("change",()=>calculate(card));
}
document.getElementById("all-tiers").addEventListener("click",()=>{for(const card of document.querySelectorAll("[data-type]")){for(const check of card.querySelectorAll("[data-tier]"))check.checked=true;calculate(card)}});
})();
</script></body></html>