---
import SiteHeader from '../../components/SiteHeader.astro';
import defaults from '../../data/troop-layer-percentages.json';
const types=[['ground','Ground'],['ranged','Archers'],['mounted','Mounted'],['siege','Siege']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Troop Calculator Settings | EvonyMasters</title><style>
:root{font-family:Inter,system-ui,sans-serif;color:#ebf2f9;background:#07111e}*{box-sizing:border-box}body{margin:0}main{max-width:1150px;margin:auto;padding:30px 20px 80px}h1{color:#f2c879}p{line-height:1.55;color:#bcd0df}.tabs{display:flex;gap:9px;margin:20px 0}.tab{padding:11px 16px;border-radius:9px;background:#142b41;border:1px solid #5f7386;color:#e2ecf5;font-weight:800}.tab.active{border-color:#ddb36e;color:#f5d293}.panel{background:#12283d;border:1px solid #516c82;border-radius:13px;padding:20px}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:650px}th,td{border-bottom:1px solid #344e65;text-align:left;padding:9px}th{color:#ebc477}td input{width:100%;min-width:88px;padding:10px;background:#0a1c2c;color:white;border:1px solid #58728a;border-radius:7px;font:inherit}.total{font-weight:850;color:#edc574}.controls{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}button,.file-label{cursor:pointer;border:1px solid #bd955b;background:#27435a;border-radius:8px;padding:11px 15px;color:#f8e6c6;font:inherit;font-weight:750}.file-label input{display:none}.warn{border-left:3px solid #e4bb70;background:#24364a;padding:14px;border-radius:5px}.status{min-height:1.3em;color:#c9e4d2}@media(max-width:650px){main{padding:20px 12px}.panel{padding:12px}}</style></head><body><SiteHeader/><main><h1>Admin</h1><div class="tabs"><span class="tab active">Troop Calc %</span></div><section class="panel"><h2>Troop layer percentages</h2><p>Set a weight for each troop tier and type. When a player selects only some tiers, the calculator redistributes these weights over the selected tiers.</p><p class="warn"><strong>Current deployment limitation:</strong> This static site does not have an authenticated admin backend. Saving here updates only this browser, not every visitor. Export your JSON and deploy it as <code>src/data/troop-layer-percentages.json</code> to update the site's default settings. This page is not access-controlled. Do not use it to store secrets.</p><div class="table-wrap"><table><thead><tr><th>Tier</th>{types.map(t=><th>{t[1]} %</th>)}</tr></thead><tbody>{defaults.tiers.map((tier,i)=><tr><th>{tier}</th>{types.map(t=><td><input type="number" min="0" max="100" step=".01" data-type={t[0]} data-index={i} aria-label={t[1]+' '+tier+' percent'}/></td>)}</tr>)}</tbody><tfoot><tr><th>Total</th>{types.map(t=><td class="total" data-total={t[0]}>100%</td>)}</tr></tfoot></table></div><p id="status" class="status" role="status"></p><div class="controls"><button id="save" type="button">Save to this browser</button><button id="download" type="button">Export JSON</button><label class="file-label">Import JSON<input id="import" type="file" accept=".json,application/json"/></label><button id="restore" type="button">Restore site defaults</button><a href="/troops/" style="color:#e7c582;align-self:center">Open troop calculator ↗</a></div></section></main>
<script define:vars={{defaults}}>
const storage='evonymasters.troopCalc.percentages.v1';const names=['ground','ranged','mounted','siege'];const clone=o=>JSON.parse(JSON.stringify(o));
function validate(o){return o&&o.types&&names.every(k=>Array.isArray(o.types[k])&&o.types[k].length===16&&o.types[k].every(n=>Number.isFinite(n)&&n>=0&&n<=100)&&Math.abs(o.types[k].reduce((a,b)=>a+b,0)-100)<.011);}
let config=clone(defaults);try{const parsed=JSON.parse(localStorage.getItem(storage)||'null');if(validate(parsed))config=parsed;}catch{}
const status=document.getElementById('status');
function render(){document.querySelectorAll('input[data-type]').forEach(el=>el.value=config.types[el.dataset.type][Number(el.dataset.index)]);totals();}
function totals(){for(const k of names){const inputs=[...document.querySelectorAll('input[data-type="'+k+'"]')];const sum=inputs.reduce((s,el)=>s+Number(el.value||0),0);const cell=document.querySelector('[data-total="'+k+'"]');cell.textContent=sum.toFixed(2)+'%';cell.style.color=Math.abs(sum-100)<.011?'#aee6bd':'#ff9e90';}}
function read(){const next=clone(defaults);for(const input of document.querySelectorAll('input[data-type]')){const n=Number(input.value);if(input.value===''||!Number.isFinite(n)||n<0||n>100)throw Error('Enter a percentage between 0 and 100 in every cell.');next.types[input.dataset.type][Number(input.dataset.index)]=n;}if(!validate(next))throw Error('Each troop type column must total exactly 100%.');return next;}
document.querySelectorAll('input[data-type]').forEach(el=>el.addEventListener('input',totals));
document.getElementById('save').addEventListener('click',()=>{try{config=read();localStorage.setItem(storage,JSON.stringify(config));status.textContent='Saved in this browser. The public site default has not been changed.';}catch(e){status.textContent=e.message;}});
document.getElementById('download').addEventListener('click',()=>{try{const payload=read();const blob=new Blob([JSON.stringify(payload,null,2)+'\n'],{type:'application/json'});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download='troop-layer-percentages.json';link.click();setTimeout(()=>URL.revokeObjectURL(link.href),1000);status.textContent='JSON exported. Commit it to the data directory to publish defaults.';}catch(e){status.textContent=e.message;}});
document.getElementById('import').addEventListener('change',async e=>{const file=e.target.files[0];if(!file)return;try{const parsed=JSON.parse(await file.text());if(!validate(parsed))throw Error('Invalid config or percentages do not total 100%.');config=parsed;render();status.textContent='Imported. Click Save to store in this browser.';}catch(err){status.textContent=err.message;}e.target.value='';});
document.getElementById('restore').addEventListener('click',()=>{config=clone(defaults);render();localStorage.removeItem(storage);status.textContent='Site defaults restored in this browser.';});render();
</script></body></html>