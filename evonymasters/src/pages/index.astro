---
import monsters from '../data/monsters.json';
import items from '../data/items.json';
const types = ['Regular', 'Boss', 'Event'];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Find Evony monsters by reward, stamina and power. Guaranteed and possible drops are shown separately."/><link rel="icon" href="/favicon.svg"/><title>Monster Finder | evonymasters</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#eaf0f8;background:#0c1726}*{box-sizing:border-box}body{margin:0}a{color:inherit}.wrap{max-width:1150px;margin:auto;padding:0 22px}header{border-bottom:1px solid #30445c;background:#11243a}.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:12px}.brand{font-size:1.45rem;font-weight:850;letter-spacing:-.04em;text-decoration:none}.brand span{color:#e6bc73}.nav small{color:#a9bcd0}.hero{padding:60px 0 40px;background:radial-gradient(circle at 80% 10%,#234667 0,transparent 55%)}.eyebrow{color:#e6bc73;text-transform:uppercase;letter-spacing:.17em;font-size:.76rem;font-weight:800}h1{font-size:clamp(2.3rem,5vw,4rem);line-height:1.07;margin:12px 0 16px;letter-spacing:-.045em}.intro{max-width:680px;color:#bbccdd;line-height:1.65;font-size:1.06rem}.panel{background:#152b43;border:1px solid #35516d;border-radius:18px;padding:24px;margin:26px 0 16px;box-shadow:0 15px 40px #0002}.filters{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:12px}label{font-size:.83rem;font-weight:700;color:#cfdeec;display:block;margin-bottom:8px}input,select{width:100%;border:1px solid #55708b;background:#0b1d30;color:#fff;padding:13px;border-radius:9px;font:inherit;min-height:48px}input:focus,select:focus{outline:2px solid #e6bc73;outline-offset:2px}input::placeholder{color:#a5b8cb}.note{font-size:.87rem;color:#b6c8d9;line-height:1.6}.results-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:28px 0 18px}h2{font-size:1.4rem;margin:0}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:16px;margin-bottom:60px}.card{background:#14283f;border:1px solid #34516b;border-radius:16px;overflow:hidden}.card-top{display:flex;gap:14px;padding:18px;border-bottom:1px solid #30475d}.monster-img{width:80px;height:80px;border-radius:12px;object-fit:cover;background:#213d57;display:grid;place-items:center;font-size:2rem;flex-shrink:0}.card h3{margin:0 0 7px;font-size:1.2rem}.meta{color:#a9bed1;font-size:.85rem}.stats{display:flex;flex-wrap:wrap;gap:8px;margin-top:11px}.pill{font-size:.78rem;border:1px solid #58708a;border-radius:999px;padding:5px 9px}.card-body{padding:16px 18px}.reward-title{font-size:.79rem;text-transform:uppercase;letter-spacing:.07em;font-weight:800;margin:0 0 9px}.guaranteed{color:#9ce0ae}.possible{color:#f2ce88}.reward-list{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:18px}.reward{border:1px solid #466079;background:#203a52;border-radius:8px;padding:7px 9px;font-size:.82rem}.empty{border:1px dashed #56708b;border-radius:15px;padding:40px 24px;text-align:center;color:#c5d5e4;margin-bottom:60px}.empty strong{display:block;color:white;font-size:1.15rem;margin-bottom:8px}footer{border-top:1px solid #30445c;padding:24px 0;color:#a9bdcf;font-size:.82rem}datalist{color:#fff}@media(max-width:820px){.filters{grid-template-columns:1fr 1fr}}@media(max-width:530px){.filters{grid-template-columns:1fr}.hero{padding-top:35px}.nav small{display:none}.panel{padding:17px}}
</style></head><body>
<header><div class="wrap nav"><a class="brand" href="/">evony<span>masters</span></a><small>Independent fan-made monster reference</small></div></header>
<main><section class="hero"><div class="wrap"><div class="eyebrow">Evony: The King's Return · Player tools</div><h1>Find the resource you are missing</h1><p class="intro">Search all monster types by name or reward. Compare stamina, power, guaranteed rewards and possible drops in one place.</p>
<div class="panel"><div class="filters"><div><label for="query">Find your resource</label><input id="query" type="search" placeholder="Search monsters, resources or rewards…" list="suggestions" autocomplete="off"/><datalist id="suggestions"></datalist></div><div><label for="item-search">Reward item</label><input id="item-search" type="search" placeholder="Filter reward list…" aria-label="Filter reward list" style="margin-bottom:7px;min-height:40px;padding:9px"/><select id="item"><option value="">All rewards</option>{items.map(item=><option value={item.id}>{item.name}</option>)}</select></div><div><label for="type">Monster type</label><select id="type"><option value="">All types</option>{types.map(type=><option value={type}>{type}</option>)}</select></div><div><label for="sort">Sort by</label><select id="sort"><option value="name">Name A–Z</option><option value="stamina">Lowest stamina</option><option value="power">Lowest power</option></select></div></div><p class="note">Search for the actual items, including verified boss-chest contents. Guaranteed and possible rewards are separate; a guaranteed chest does not guarantee its contents.</p></div></div></section>
<section class="wrap" aria-live="polite"><div class="results-head"><h2>Monster results</h2><span id="count" class="meta"></span></div><div id="results" class="grid"></div><div id="empty" class="empty" hidden><strong>No monsters available yet</strong><span id="empty-text">Our verified monster database is being prepared. Check back as records are added.</span></div></section></main>
<footer><div class="wrap">evonymasters is an independent fan project and is not affiliated with or endorsed by the game publisher. Monster data may change with game updates.</div></footer>
<script id="monster-data" type="application/json" set:html={JSON.stringify({monsters,items}).replace(/</g, "\\u003c")} />
<script>
  import { searchMonsters, suggestions } from '../lib/search.mjs';
  const { monsters, items } = JSON.parse(document.querySelector('#monster-data').textContent);
  const byId = new Map(items.map(i => [i.id, i]));
  const query = document.querySelector('#query');
  const item = document.querySelector('#item');
  const itemSearch = document.querySelector('#item-search');
  const type = document.querySelector('#type');
  const sort = document.querySelector('#sort');
  const results = document.querySelector('#results');
  const empty = document.querySelector('#empty');
  const count = document.querySelector('#count');
  const emptyText = document.querySelector('#empty-text');
  const datalist = document.querySelector('#suggestions');
  const format = n => n == null ? 'Not verified' : new Intl.NumberFormat('en-US').format(n);
  function element(tag, className, value) { const el = document.createElement(tag); if(className) el.className=className; if(value != null) el.textContent=value; return el; }
  function rewards(container, monster, kind) {
    const title = element('p', 'reward-title '+(kind==='guaranteed'?'guaranteed':'possible'), kind==='guaranteed'?'Guaranteed rewards':'Possible drops');
    container.append(title);
    const list = element('div','reward-list');
    const matches = monster.rewards.filter(r=>r.kind===kind);
    if(!matches.length) list.append(element('span','meta','None verified'));
    for(const r of matches){const label=byId.get(r.itemId)?.name || r.itemId;const isChest=/^lv\\d+-boss-monster-chest$/.test(r.itemId);const reward=element(isChest?'a':'span','reward',`${label}${r.quantity == null?'':` · ${format(r.quantity)}${r.unit?' '+r.unit:''}`}${r.origin==='boss_chest'?' · from boss chest':r.origin==='other_chest'?' · from special chest':''}${r.notes?' · '+r.notes:''}`);if(isChest)reward.href='/items/'+r.itemId+'/';list.append(reward);}
    container.append(list);
  }
  function render(){
    const filtered=searchMonsters(monsters,{query:query.value,item:item.value,type:type.value,sort:sort.value});
    results.replaceChildren(); count.textContent=`${filtered.length} monster${filtered.length===1?'':'s'}`;
    empty.hidden=filtered.length>0; emptyText.textContent=monsters.length?'Try a different keyword, reward or monster type.':'Our verified monster database is being prepared. Check back as records are added.';
    for(const m of filtered){
      const card=element('article','card');const top=element('div','card-top');
      if(m.image){const img=element('img','monster-img');img.src=m.image;img.alt=`${m.name} monster`;img.loading='lazy';top.append(img);}else{const placeholder=element('div','monster-img','⚔');placeholder.setAttribute('aria-label','Monster image not yet available');top.append(placeholder);}
      const info=element('div');const heading=element('h3');const bossLink=element('a','',m.name);bossLink.href='/bosses/'+m.id+'/';heading.append(bossLink);info.append(heading,element('div','meta',`${m.type}${m.level==null?'':' · Level '+m.level}${m.event?' · '+m.event:''}`));
      const stats=element('div','stats');stats.append(element('span','pill','Stamina: '+format(m.stamina)),element('span','pill','Power: '+format(m.power)));info.append(stats);top.append(info);card.append(top);
      const body=element('div','card-body');rewards(body,m,'guaranteed');rewards(body,m,'possible');if(m.verification){const v=element('p','note',m.verification.inGameVerified?'Verified in game':'Guide-sourced · Not yet verified in game');body.append(v);for(const url of m.verification.sourceUrls||[]){if(!/^https:\/\//.test(url))continue;const a=element('a','note','View source ↗');a.href=url;a.target='_blank';a.rel='noopener noreferrer';body.append(a);}}card.append(body);results.append(card);
    }
  }
  itemSearch.addEventListener('input',()=>{const term=itemSearch.value.trim().toLowerCase();for(const option of item.options){option.hidden=!!option.value&&!option.textContent.toLowerCase().includes(term);}});
  for(const control of [query,item,type,sort])control.addEventListener(control===query?'input':'change',render);
  query.addEventListener('input',()=>{datalist.replaceChildren(...suggestions(monsters,items,query.value).map(value=>{const option=document.createElement('option');option.value=value;return option;}));});
  render();
</script></body></html>
