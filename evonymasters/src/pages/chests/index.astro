---
import SeoMetadata from '../../components/SeoMetadata.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---
<!doctype html>
<html lang="en"><head><SeoMetadata title="Evony Chest Finder: Rewards & Contents | EvonyMasters" description="Search Evony reward chests, explore recorded contents and compare rewards from boss monsters and events. Find chest sources and item quantities."/><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="Search Evony reward chests, explore recorded contents and compare rewards from boss monsters and events. Find chest sources and item quantities."/>
<link rel="icon" href="/favicon.svg"/><title>Evony Chest Finder: Rewards & Contents | EvonyMasters</title>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#eaf0f8;background:#0b1727}
*{box-sizing:border-box}body{margin:0}.wrap{max-width:1260px;margin:0 auto;padding:0 20px}
.hero{padding:30px 0 25px;background:linear-gradient(110deg,#182e49,#11263c);border-bottom:1px solid #385672}.eyebrow{font-weight:800;color:#e7be72;font-size:.78rem;letter-spacing:.14em}
h1{font-size:clamp(2rem,4vw,3rem);margin:7px 0 9px;letter-spacing:-.04em}.subtitle{color:#c8d7e6;line-height:1.55;margin:0}
.search{display:flex;gap:10px;flex-wrap:wrap;margin-top:19px}.search input,.search select{background:#f4f8fb;color:#162a41;border:1px solid #b1c1ce;border-radius:9px;padding:12px 14px;font:inherit}.search input{flex:1;min-width:220px}.search select{min-width:180px}.advanced{display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin-top:12px}.advanced label{display:flex;flex:1;min-width:180px;flex-direction:column;gap:5px;color:#c8d7e6;font-size:.84rem}.advanced select,.advanced input{padding:11px 12px;background:#f4f8fb;color:#162a41;border:1px solid #b1c1ce;border-radius:9px;font:inherit;width:100%}.advanced[hidden]{display:none}
.controls{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:20px 0;flex-wrap:wrap}
.controls h2{font-size:1.24rem;margin:0}.controls p{font-size:.86rem;color:#adc5d9;margin:5px 0 0}
.pill{background:#f4c772;border:1px solid #f4c772;color:#14263b;border-radius:99px;padding:9px 14px;font:inherit;font-weight:750;cursor:pointer}
.pill.secondary{background:#1d364f;border-color:#647c95;color:#e2eaf3}.pill:disabled{opacity:.45;cursor:default}
.chest-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:14px}
.chest{border:1px solid #435f79;border-radius:13px;background:linear-gradient(#1b344e,#11263c);padding:17px;display:flex;flex-direction:column;gap:10px}
.chest-head{display:flex;align-items:center;gap:12px}
.chest img{width:84px;height:66px;object-fit:cover;border:1px solid #58738b;border-radius:9px}
.chest h3{margin:0;font-size:1.05rem}.source-availability{display:block;color:#b8cad8;font-size:.75rem;margin-top:5px}.source-availability.live{color:#7ae5a6;font-weight:850}.sub{font-size:.79rem;color:#b6cadc;margin-top:4px;line-height:1.5}
.chest .items{list-style:none;margin:0;padding:9px 0;border-top:1px solid #35506b;flex:1}
.chest li{display:flex;justify-content:space-between;gap:12px;padding:4px 0;font-size:.86rem;color:#e3edf5}
.chest li span:last-child{white-space:nowrap;color:#edcb82}
.card-actions{display:flex;align-items:center;justify-content:space-between;gap:10px}
.card-actions label{cursor:pointer;font-size:.9rem}.card-actions input{accent-color:#f4c772;vertical-align:middle}
.muted{color:#afc1d3}.status{margin:12px 0;color:#d9e6f0}.panel{border:1px solid #3f5e79;border-radius:12px;background:#152c44;padding:18px;margin:18px 0}
.panel h2{font-size:1.16rem;margin:0 0 14px}.selection{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.table-wrap{overflow-x:auto}.comparison{border-collapse:collapse;width:100%;min-width:620px}
.comparison th,.comparison td{padding:12px 13px;border-bottom:1px solid #3d5770;text-align:left;vertical-align:top;font-size:.88rem}
.comparison th{color:#f0cf8a;background:#1d3853}.comparison th:first-child{min-width:200px}
.comparison td:first-child{font-weight:750}.classification{display:block;font-size:.72rem;color:#aec9dd;margin-top:3px}
.detail{margin-top:10px;color:#ccdae7;font-size:.83rem;line-height:1.6}.detail strong{color:#f4d396}
.expand-btn{border:1px solid #ba985b;border-radius:8px;padding:9px 15px;background:#edc574;color:#13283c;font:inherit;font-size:.85rem;font-weight:800;cursor:pointer}.expand-btn:hover{background:#ffda92}.expand-btn:focus-visible{outline:3px solid #fff;outline-offset:3px}.expand-btn:disabled{opacity:.6;cursor:wait}
.chest-expanded{border-top:1px solid #48627b;padding-top:12px;margin-top:4px}.chest-expanded[hidden]{display:none}
.chest-expanded h4{margin:0 0 8px;color:#f2d08a;font-size:.95rem}
.reward-table{width:100%;border-collapse:collapse;font-size:.83rem}.reward-table th{text-align:left;color:#f1ce8d;border-bottom:1px solid #47627d;padding:8px 6px}.reward-table td{border-bottom:1px solid #344e68;padding:9px 6px;vertical-align:top}.reward-table th:nth-child(2),.reward-table td:nth-child(2){text-align:right;white-space:nowrap}.reward-table th:nth-child(3),.reward-table td:nth-child(3){text-align:right;white-space:nowrap}.reward-table .muted{font-size:.75rem}.reward-path{display:block;color:#acc2d5;font-size:.73rem;margin-top:4px}.reward-heading{margin:14px 0 5px;color:#b9d7eb;font-weight:750;font-size:.82rem}.chest-note{font-size:.78rem;color:#a9c2d6;line-height:1.5;margin:6px 0}
@media(max-width:640px){.reward-table{font-size:.76rem}.reward-table th,.reward-table td{padding:8px 3px}}
.more{margin:19px auto 36px;display:block}
.empty{padding:25px;border:1px dashed #57718a;text-align:center;border-radius:10px;color:#bcd0df}
footer{margin-top:30px;border-top:1px solid #334f69;padding:25px 0;color:#b5c8d9;font-size:.82rem}
@media(max-width:640px){.wrap{padding:0 14px}.hero{padding:23px 0}.search input,.search select{width:100%}.chest-list{display:block}.chest{margin:10px 0}}
.search-add{border:1px solid #dfad5e;border-radius:8px;padding:10px 13px;background:#efca7d;color:#17293a;font-weight:850;cursor:pointer}
.search-add:disabled{opacity:.55;cursor:not-allowed}
.search-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.search-chips:empty{display:none}
.search-chip{display:inline-flex;align-items:center;gap:10px;background:#223d55;color:#f3d497;border:1px solid #b18b52;border-radius:999px;padding:7px 11px;font-size:.84rem;font-weight:800}
.search-chip button{background:transparent;border:0;color:inherit;cursor:pointer;font:inherit;font-weight:900}
.search-help{font-size:.78rem;color:#bcd1e0;margin:9px 0 0}
.chest-matches{color:#9ae1b1;font-size:.78rem;font-weight:800;margin:7px 0}


/* Compact, source-first chest finder */
.finder-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.finder-tab{border:1px solid #64819b;border-radius:999px;background:#142c42;color:#ebf2f9;font:inherit;font-size:.92rem;font-weight:800;cursor:pointer;padding:11px 19px}
.finder-tab[aria-selected="true"]{background:#f0c778;color:#14263c;border-color:#f0c778}
.finder-tab:focus-visible{outline:3px solid white;outline-offset:3px}
.finder-help{color:#d1e0ed;font-size:.87rem;line-height:1.5;margin:13px 0 2px;max-width:790px}
.finder-filters{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px}
.finder-filters label{color:#c7daea;font-size:.83rem;display:flex;align-items:center;gap:8px}
.finder-filters select{color:#ecf3f8;background:#1b3851;border:1px solid #6b8298;border-radius:8px;font:inherit;padding:9px}
.finder-filters input{accent-color:#f2c778;width:17px;height:17px}
.chest-list{grid-template-columns:repeat(2,minmax(0,1fr))}
.chest{gap:9px;padding:14px}
.chest-head{align-items:flex-start}
.chest img{width:62px;height:58px;flex:none}
.chest .items{display:none}
.chest .items:has(+.detail){display:none}
.chest .detail{margin-top:1px;font-size:.79rem;line-height:1.5}
.chest .sub{font-size:.76rem}
.chest h3{font-size:1.02rem;line-height:1.4}
.chest-matches{display:inline-block;margin:7px 0 0;padding:4px 8px;border:1px solid #70aa83;background:#1d4639;border-radius:7px;color:#b4f6c6;font-size:.77rem}
.chest-matches.best-match{background:#f1d28a;color:#152d40;border-color:#f1d28a}
.chest-expanded{overflow-x:auto}
.chest-expanded .reward-table{min-width:425px}
.chest-expanded .reward-path,.chest-note{display:none}
.chest-expanded .reward-heading{margin-top:12px}
.comparison-dock{position:fixed;bottom:14px;left:50%;transform:translateX(-50%);width:min(860px,calc(100% - 24px));z-index:15;max-width:860px;margin:0;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding:13px 17px;background:#203950;border:1px solid #d3a865;border-radius:13px;box-shadow:0 8px 28px #050d19ba}
.comparison-dock[hidden]{display:none}
main.wrap{padding-bottom:120px}
.comparison-dock .selection{justify-content:flex-end}
.comparison-dock .dock-title{font-weight:800;color:#f2cf8e}
.chest-results-order{font-size:.8rem;color:#9ff1bc}
.chest.card-match-0{opacity:.92}
@media(max-width:740px){.chest-list{grid-template-columns:1fr}.finder-tab{flex:1;padding:10px 8px}.comparison-dock{bottom:4px;padding:10px}.comparison-dock .selection{width:100%;justify-content:space-between}}

.chest-guide{margin:36px 0 0;padding:24px;border:1px solid #405e79;background:#152b42;border-radius:14px}
.chest-guide h2{font-size:1.45rem;margin:0 0 12px;color:#f3d18f}
.chest-guide h3{font-size:1.1rem;margin:20px 0 8px;color:#f3d18f}
.chest-guide p,.chest-guide li{color:#d0deeb;line-height:1.65}
.chest-guide ol{padding-left:22px;display:grid;gap:8px}
.chest-guide strong{color:#ffe0a9}
.chest-guide a{color:#f4cf8f;text-underline-offset:3px}
</style></head><body>
<SiteHeader active="chests"/>
<header class="hero banner-hero banner-chests"><div class="wrap"><div class="eyebrow">PLAYER TOOLS / CHEST FINDER</div><h1>Crack the chest code.</h1>
<p class="subtitle">Don't leave your loot to guesswork. Peek inside reward chests, compare up to four side by side and find the bosses or events that can deliver them.</p>
<div class="finder-tabs" id="finder-tabs" role="tablist" aria-label="Chest source">
<button type="button" class="finder-tab" role="tab" aria-selected="false" data-tab="monsters">⚔️ Monsters</button>
<button type="button" class="finder-tab" role="tab" aria-selected="false" data-tab="events">🏆 Events</button>
<button type="button" class="finder-tab" role="tab" aria-selected="true" data-tab="all">📦 All Chests</button>
</div>
<p class="finder-help" id="tab-description">Find boss and monster chests, then check which rewards they contain.</p>
<div class="search"><label for="q" style="position:absolute;clip:rect(0,0,0,0);width:1px;height:1px;overflow:hidden">Chest or reward item</label><input id="q" type="search" placeholder="Search chest names or rewards…" autocomplete="off" list="chest-suggestions"/><datalist id="chest-suggestions"></datalist>
<button type="button" id="add-item-search" class="search-add">+ Add item</button>
<label for="source" class="source-control" hidden>Source <select id="source"><option value="all">All sources</option><option value="bosses">Bosses</option><option value="events">Events</option><option value="activities">Activities</option><option value="unlinked">Source not recorded</option></select></label></div><div id="search-items" class="search-chips" aria-live="polite"></div><p class="search-help">Select up to 3 items to find chests and activities that offer your rewards.</p>
<div class="finder-filters"><label><input type="checkbox" id="live-filter"/> Live sources only</label>
<label id="monster-level-wrap">Monster level <select id="monster-level"><option value="all">All levels</option><option value="1-10">1–10</option><option value="11-20">11–20</option><option value="21+">21+</option></select></label><label>Drop type <select id="drop-type"><option value="all">All drops</option><option value="guaranteed">Guaranteed</option><option value="possible">Possible / chance</option></select></label>
<button type="button" class="pill secondary" id="clear-filters">Clear filters</button></div>
<div class="advanced" id="event-search" hidden>
<label for="event-filter">Event name<select id="event-filter"><option value="">All events</option></select></label>
<label for="participation-filter">Participation<select id="participation-filter"><option value="all">Personal + Alliance</option><option value="personal">Personal</option><option value="alliance">Alliance</option></select></label>
<label for="rank-filter">Ranking position<input id="rank-filter" type="search" placeholder="e.g. 1 or 11–20" autocomplete="off"/></label>
</div></div></header>
<main class="wrap">
<div class="controls"><div><h2>Matching chests</h2><p id="count">Loading recorded chests…</p><span class="chest-results-order">Best matches first, based on your selected rewards</span></div></div>
<div id="status" class="status" role="status"></div>
<div class="chest-list" id="chests"></div>
<button id="more" class="pill more" hidden>Show more chests</button>
<section class="panel" id="comparison-panel" hidden><h2>Compare chest contents</h2><p class="muted">Every recorded item is shown. A possible reward is not a guaranteed payout. Nested chests are listed separately from the contents of their child chests.</p>
<div class="table-wrap"><table class="comparison"><thead id="compare-head"></thead><tbody id="compare-body"></tbody></table></div></section>
<div class="comparison-dock" id="comparison-dock" hidden><span class="dock-title">Compare chests · <span id="selected-count">0 of 4 selected</span></span>
<div class="selection"><button class="pill" id="compare" disabled>Compare selected</button><button class="pill secondary" id="reset" disabled>Clear selection</button></div></div>
<section class="chest-guide" aria-labelledby="chest-guide-title">
<h2 id="chest-guide-title">How to find and compare Evony chest rewards</h2>
<p>Chest Finder helps you browse recorded Evony chests, review their item contents and compare possible rewards. Begin with <strong>All Chests</strong>, or switch to the Monsters or Events tab when you know the source you want to explore.</p>
<ol>
<li><strong>Search a chest or reward item.</strong> Enter a chest name or an item you hope to obtain.</li>
<li><strong>Refine the results.</strong> Filter by source, monster level or drop type when those details are recorded.</li>
<li><strong>Compare up to four chests.</strong> Select chests to review their recorded contents side by side before deciding what to pursue.</li>
</ol>
<p><strong>Important:</strong> A listed possible drop is not a guaranteed reward. Contents and availability may change in-game or be incomplete in the source records.</p>
<h3>Related EvonyMasters tools</h3>
<p>Use <a href="/resources/">Item Finder</a> to locate an item across reward sources, <a href="/calendar/">Event Calendar</a> to check recorded schedules, or <a href="/loot-compass/">Loot Compass</a> to plan reward opportunities with a stamina budget.</p>
</section>
</main>
<script is:inline>
(()=>{
"use strict";
const API="https://evonymasters-sheet-sync.jaynmegepicadventure.workers.dev";
const q=document.getElementById("q"),source=document.getElementById("source"),eventFilter=document.getElementById("event-filter"),participationFilter=document.getElementById("participation-filter"),rankFilter=document.getElementById("rank-filter"),eventSearch=document.getElementById("event-search"),cards=document.getElementById("chests"),more=document.getElementById("more"),status=document.getElementById("status"),count=document.getElementById("count"),compare=document.getElementById("compare"),reset=document.getElementById("reset"),selection=document.getElementById("selected-count"),panel=document.getElementById("comparison-panel"),head=document.getElementById("compare-head"),body=document.getElementById("compare-body");
const selected=new Map();let page=0,hasMore=false,serial=0,timer=null,request=null,availability=null;
const tabStrip=document.getElementById("finder-tabs"),tabHelp=document.getElementById("tab-description"),dock=document.getElementById("comparison-dock");
const liveFilter=document.getElementById("live-filter"),monsterLevel=document.getElementById("monster-level"),monsterLevelWrap=document.getElementById("monster-level-wrap"),dropType=document.getElementById("drop-type");
const suggest=document.getElementById("chest-suggestions");
let currentTab="all",allFound=new Map(),searchComplete=true;

const selectedItems=[],itemChips=document.getElementById("search-items"),addItemButton=document.getElementById("add-item-search");
let shownChestIds=new Set(),totalChests=0;
function terms(){
 const value=q.value.trim(),list=[...selectedItems];
 if(value.length>=2&&list.length<3&&!list.some(item=>item.toLowerCase()===value.toLowerCase()))list.push(value);
 return list.length?list:[""];
}
function renderItemChips(){
 itemChips.replaceChildren();
 for(const item of [...selectedItems]){
  const chip=document.createElement("span");chip.className="search-chip";chip.append(document.createTextNode(item));
  const remove=document.createElement("button");remove.type="button";remove.textContent="×";remove.setAttribute("aria-label","Remove "+item);
  remove.addEventListener("click",()=>{
   const idx=selectedItems.indexOf(item);if(idx>=0)selectedItems.splice(idx,1);
   renderItemChips();schedule();
  });
  chip.append(remove);itemChips.append(chip);
 }
 addItemButton.disabled=selectedItems.length===3;q.disabled=selectedItems.length===3;
 addItemButton.textContent=selectedItems.length===3?"3 items selected":"+ Add item";
}
function addSearchItem(){
 const value=q.value.trim();
 if(value.length<2||selectedItems.length>=3||selectedItems.some(v=>v.toLowerCase()===value.toLowerCase()))return;
 selectedItems.push(value);q.value="";renderItemChips();schedule();
}
addItemButton.addEventListener("click",addSearchItem);
q.addEventListener("keydown",event=>{if(event.key==="Enter"){event.preventDefault();addSearchItem();}});

const sourceKey=v=>String(v??"").trim().toLowerCase().replace(/\s*·\s*lv\s*\d+$/i,"").replace(/\s+/g," ");
function paintAvailability(article,c){const badge=article.querySelector(".source-availability");if(!badge)return;if(!availability){badge.textContent="Source availability: checking…";return}const matches=(c.sources||[]).map(src=>availability.get(sourceKey(src.name))).filter(Boolean);const live=matches.some(v=>v.live),upcoming=matches.map(v=>v.next).filter(Boolean).sort()[0];badge.classList.toggle("live",live);badge.textContent=live?"● Source LIVE":upcoming?"Source upcoming · "+upcoming+" UTC":"Source schedule not recorded";}
async function loadAvailability(){try{const today=new Date().toISOString().slice(0,10),to=new Date(Date.parse(today+"T00:00:00Z")+92*86400000).toISOString().slice(0,10);const r=await fetch("https://evonymasters-calendar.jaynmegepicadventure.workers.dev/api/events?"+new URLSearchParams({from:today,to,kind:"all",includeAlways:"true"}));if(!r.ok)throw Error("Calendar unavailable");const d=await r.json(),next=new Map();for(const e of d.events||[]){const key=sourceKey(e.name),old=next.get(key)||{live:false,next:""};if(e.date===today)old.live=true;else if(!old.next||e.date<old.next)old.next=e.date;next.set(key,old);}availability=next;renderResults()}catch{availability=new Map();renderResults()}}
const toText=x=>String(x??"").trim();
const collator=new Intl.Collator("en",{numeric:true,sensitivity:"base"});
const sortedRewards=rows=>[...rows].sort((a,b)=>collator.compare(a.item,b.item)
 || (parseFloat(String(a.quantity).replace(/,/g,""))||0)-(parseFloat(String(b.quantity).replace(/,/g,""))||0)
 || collator.compare(a.quantity||"",b.quantity||""));
const chestFamily=name=>toText(name).replace(/^(?:common|uncommon|rare|super rare|epic|legendary|excellent|junior|medium|senior)\s+/i,"").trim();
const firstNumber=value=>{const n=toText(value).replace(/,/g,"").match(/\d+(?:\.\d+)?/);return n?Number(n[0]):Infinity};
const compareChest=(a,b)=>collator.compare(chestFamily(a.name),chestFamily(b.name))
 ||(firstNumber(a.level)-firstNumber(b.level)||0)
 ||(firstNumber(a.rank)-firstNumber(b.rank)||0)
 ||collator.compare(a.name,b.name);

const el=(tag,cls,value)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(value!==undefined)n.textContent=toText(value);return n;};
function refreshSelected(){selection.textContent=selected.size+" of 4 selected";compare.disabled=selected.size<2;reset.disabled=!selected.size;dock.hidden=!selected.size;}
function card(c){
 const article=el("article","chest"),top=el("div","chest-head"),pic=document.createElement("img");
 pic.src="/images/item-finder/box.svg";pic.alt="";pic.width=84;pic.height=66;pic.loading="lazy";
 const labels=el("div");labels.append(el("h3","",c.name),el("div","sub",[c.level?"Tier "+c.level:"",c.rank?"Rank "+c.rank:"",c.itemCount+" recorded rewards"].filter(Boolean).join(" · ")),el("span","source-availability","Checking source availability…"));article._chestRecord=c;
 if(c._matchedItems?.length){
 const matches=el("div","chest-matches"+(c._matchedItems.length===terms().filter(Boolean).length&&terms().filter(Boolean).length>1?" best-match":""),c._matchedItems.length+" of "+terms().filter(Boolean).length+" rewards matched");
 labels.append(matches);
}
 top.append(pic,labels);article.append(top);paintAvailability(article,c);
 const list=el("ul","items");
 for(const item of sortedRewards(c.items).slice(0,5)){
  const li=el("li");li.append(el("span","",item.item),el("span","",item.quantity||"Quantity missing"));list.append(li);
 }
 if(c.itemCount>5)list.append(el("li","muted","+"+(c.itemCount-5)+" additional recorded items"));
 if(c.nestedCount)list.append(el("li","muted",c.nestedCount+" nested reward paths"));
 article.append(list);
 const origin=(c.sources||[]).slice(0,2).map(s=>s.type+": "+s.name+(s.rank?" (Rank "+s.rank+")":s.level?" (Lv "+s.level+")":""));
 if(origin.length)article.append(el("div","detail","Where to get it: "+origin.join(" · ")));
 
 else article.append(el("div","detail","Source not yet linked in data"));
 const actions=el("div","card-actions"),label=document.createElement("label"),cb=document.createElement("input");
 cb.type="checkbox";cb.checked=selected.has(c.id);cb.disabled=!cb.checked&&selected.size>=4;
 cb.addEventListener("change",()=>{
  if(cb.checked&&selected.size<4)selected.set(c.id,c);
  else selected.delete(c.id);
  refreshSelected();
  for(const checkbox of cards.querySelectorAll('input[type="checkbox"]'))checkbox.disabled=!checkbox.checked&&selected.size>=4;
 });
 label.append(cb,document.createTextNode(" Compare"));
 const expand=el("button","expand-btn","View chest contents");expand.type="button";expand.setAttribute("aria-expanded","false");
 const expanded=el("section","chest-expanded");expanded.hidden=true;expanded.id="chest-"+Math.random().toString(36).slice(2);expand.setAttribute("aria-controls",expanded.id);
 const openDetails=async()=>{
  expanded.replaceChildren();expanded.append(el("p","chest-note","Loading all recorded rewards…"));expanded.hidden=false;expand.disabled=true;
  try{
   const params=new URLSearchParams();params.append("id",c.id);
   const response=await fetch(API+"/v4/chests/compare?"+params);
   if(!response.ok)throw Error("Detail lookup unavailable");
   const payload=await response.json(),chest=payload.chests?.[0];
   if(!chest)throw Error("No chest data");
   expanded.replaceChildren();
   expanded.append(el("h4","","All "+chest.items.length+" recorded rewards"));

   const table=el("table","reward-table"),thead=el("thead"),tr=el("tr");
   for(const name of ["Reward","Quantity","Chance"]){const th=el("th","",name);th.scope="col";tr.append(th)}
   thead.append(tr);table.append(thead);
   const tbody=el("tbody");
   for(const item of sortedRewards(chest.items)){
    const row=el("tr"),name=el("td","",item.item);
    
    row.append(name,el("td","",item.quantity||"Not recorded"),el("td","",item.classification==="Unspecified"?"Not recorded":item.classification||"Not recorded"));
    tbody.append(row);
   }
   table.append(tbody);expanded.append(table);
   if(chest.nestedItems?.length){
    const nestedTitle=el("div","reward-heading","Inside other chests (nested rewards)");
    expanded.append(nestedTitle);
    const nestedTable=el("table","reward-table"),nh=el("thead"),nr=el("tr");
    for(const name of ["Reward","Quantity","Chance"]){const th=el("th","",name);th.scope="col";nr.append(th)}
    nh.append(nr);nestedTable.append(nh);const nb=el("tbody");
    for(const item of sortedRewards(chest.nestedItems)){
     const row=el("tr"),name=el("td","",item.item);
     
     row.append(name,el("td","",item.quantity||"Not recorded"),el("td","",item.classification==="Unspecified"?"Not recorded":item.classification||"Not recorded"));nb.append(row);
    }
    nestedTable.append(nb);expanded.append(nestedTable);
    
   }
   if(chest.sources?.length){
    const sourceText=[...new Set(chest.sources.map(s=>[s.type,s.name,s.rank?"Rank "+s.rank:"",s.participation||""].filter(Boolean).join(" · ")))];
    expanded.append(el("div","reward-heading","Where it comes from"));
    for(const line of sourceText)expanded.append(el("p","detail",line));
   }
   expand.textContent="Hide contents";expand.setAttribute("aria-expanded","true");
  }catch{
   expanded.replaceChildren(el("p","chest-note","Unable to load the full chest record. Please try Expand again."));
   expand.textContent="Retry";
  }finally{expand.disabled=false;}
 };
 expand.addEventListener("click",()=>{
  if(!expanded.hidden){expanded.hidden=true;expand.textContent="View chest contents";expand.setAttribute("aria-expanded","false");}
  else if(expanded.dataset.loaded==="true"){expanded.hidden=false;expand.textContent="Hide contents";expand.setAttribute("aria-expanded","true");}
  else {openDetails().then(()=>{if(expand.textContent==="Hide contents")expanded.dataset.loaded="true";});}
 });
 actions.append(label,expand);article.append(actions,expanded);
 return article;
}
const matchCount=chest=>(chest._matchedItems||[]).length;
const matchReward=(chest,term)=>{
 const phrase=term.trim().toLowerCase();
 return [...(chest.items||[]),...(chest.nestedItems||[])].some(item=>toText(item.item).toLowerCase().includes(phrase));
};
async function verifyFullRewards(merged,phrases,signal){
 if(phrases.filter(Boolean).length<2)return true;
 const all=[...merged.values()],batches=[];
 for(let i=0;i<all.length;i+=4)batches.push(all.slice(i,i+4));
 let complete=true;
 // The compact search endpoint exposes only the first 12 direct rewards.
 // Use the full contents endpoint for multi-reward ranking, so a reward
 // further down the list cannot be overlooked.
 for(let index=0;index<batches.length;index+=4){
  const chunk=batches.slice(index,index+4);
  await Promise.all(chunk.map(async batch=>{
   try{
    const params=new URLSearchParams();
    for(const chest of batch)params.append("id",chest.id);
    const response=await fetch(API+"/v4/chests/compare?"+params,{signal});
    if(!response.ok)throw Error("Full rewards unavailable");
    const data=await response.json();
    for(const full of data.chests||[]){
     const found=merged.get(full.id);
     if(found){
      found._matchedItems=phrases.filter(term=>term&&matchReward(full,term));
      found.items=full.items;found.nestedItems=full.nestedItems;
      found.itemCount=full.items.length;found.nestedCount=full.nestedItems.length;
     }
    }
   }catch(error){
    if(error.name==="AbortError")throw error;
    complete=false;
   }
  }));
 }
 return complete;
}
function sourceMatchesTab(chest){
 // The sheet-sync endpoint already performs the source filter against ALL
 // source records. A chest may have more than 12 links, so checking the
 // shortened card metadata here would incorrectly hide valid matches.
 return true;
}
function passesLevel(chest){
 if(currentTab!=="monsters"||monsterLevel.value==="all")return true;
 const values=(chest.sources||[]).filter(s=>/boss|monster/i.test(s.type||""))
  .map(s=>Number.parseInt(toText(s.level).replace(/,/g,""),10)).filter(Number.isFinite);
 if(!values.length)return false;
 return values.some(n=>monsterLevel.value==="1-10"?n>=1&&n<=10:monsterLevel.value==="11-20"?n>=11&&n<=20:n>=21);
}
function passesDrop(chest){
 if(dropType.value==="all")return true;
 return [...(chest.items||[]),...(chest.nestedItems||[])].some(item=>toText(item.classification).toLowerCase()===dropType.value);
}
function availableNow(chest){
 if(!availability)return false;
 return (chest.sources||[]).some(src=>availability.get(sourceKey(src.name))?.live);
}
function renderResults(){
 const all=[...allFound.values()];
 const visible=all.filter(chest=>sourceMatchesTab(chest)&&passesLevel(chest)&&passesDrop(chest)&&(!liveFilter.checked||availableNow(chest)));
 // The first ranking key is the number of DISTINCT selected reward items
 // actually found inside the chest (directly or in nested chests).
 visible.sort((a,b)=>matchCount(b)-matchCount(a)||compareChest(a,b));
 cards.replaceChildren();
 for(const chest of visible)cards.append(card(chest));
 count.textContent=visible.length+" matching "+(visible.length===1?"chest":"chests")+
  (hasMore?" shown · more to load":"")+
  (terms().filter(Boolean).length>1?" · most matched rewards first":"");
 more.hidden=!hasMore;
 status.textContent=visible.length?"":liveFilter.checked&&!availability?"Checking live schedules…":
   "No matching chests for these filters. Try another reward, level or source.";
 refreshSelected();
}
async function load(append=false){
 const my=++serial;
 if(request)request.abort();request=new AbortController();
 if(!append){page=0;allFound=new Map();shownChestIds=new Set();hasMore=false;cards.replaceChildren();more.hidden=true;panel.hidden=true;}
 status.textContent="Finding your best matches…";
 const list=terms(),searching=list.some(Boolean),maxPages=searching?50:1;
 try{
  // Read all available result pages for a reward query BEFORE ranking. Sorting
  // only the first 15 results would hide three-item matches on later pages.
  const batches=await Promise.all(list.map(async term=>{
   const records=[];
   let offset=append?page:0,morePages=false,passes=0;
   do{
    const params=new URLSearchParams({q:term,source:source.value,event:eventFilter.value,
      participation:participationFilter.value,rank:rankFilter.value.trim(),page:String(offset)});
    const response=await fetch(API+"/v4/chests?"+params,{signal:request.signal});
    if(!response.ok)throw Error("Chest search unavailable");
    const data=await response.json();
    records.push(...data.chests||[]);
    morePages=Boolean(data.hasMore);
    offset++;passes++;
   }while(morePages&&passes<maxPages);
   return {term,records,morePages,pages:passes};
  }));
  if(my!==serial)return;
  const merged=append?new Map(allFound):new Map();
  for(const {term,records} of batches){
   for(const chest of records){
    const old=merged.get(chest.id);
    if(old){
     if(term&&matchReward(chest,term)&&!old._matchedItems.includes(term))old._matchedItems.push(term);
    }else{
     merged.set(chest.id,{...chest,_matchedItems:term&&matchReward(chest,term)?[term]:[]});
    }
   }
  }
  const verified=await verifyFullRewards(merged,list,request.signal);
  if(my!==serial)return;
  allFound=merged;
  hasMore=batches.some(x=>x.morePages);
  if(hasMore)page+=Math.max(...batches.map(x=>x.pages));
  renderResults();
  if(!verified)status.textContent="Some full chest details could not be verified; match rankings may be incomplete.";
 }catch(error){
  if(error.name!=="AbortError")status.textContent="Chest Finder is temporarily unavailable. Please try again.";
 }
}
const schedule=()=>{clearTimeout(timer);if(request)request.abort();timer=setTimeout(()=>load(),280)};
const tabSettings={
 monsters:{source:"bosses",help:"Explore monster and boss chests. Filter by monster level and see exactly what they can drop."},
 events:{source:"events",help:"Find chests from events, milestones and rankings. Focus on the rewards worth pursuing."},
 all:{source:"all",help:"Browse every recorded chest, including chests without a confirmed source."}
};
function selectTab(tab){
 currentTab=tab;
 for(const button of tabStrip.querySelectorAll("[data-tab]"))
  button.setAttribute("aria-selected",String(button.dataset.tab===tab));
 tabHelp.textContent=tabSettings[tab].help;
 source.value=tabSettings[tab].source;
 document.querySelector(".source-control").hidden=tab!=="all";
 monsterLevelWrap.hidden=tab!=="monsters";
 if(tab!=="monsters")monsterLevel.value="all";
 setEventMode();
 schedule();
}
function setEventMode(){
 const show=currentTab==="events"||currentTab==="all"&&["events","activities"].includes(source.value);
 eventSearch.hidden=!show;
 if(!show){eventFilter.value="";participationFilter.value="all";rankFilter.value="";}
}
tabStrip.addEventListener("click",event=>{
 const button=event.target.closest("[data-tab]");
 if(button)selectTab(button.dataset.tab);
});
liveFilter.addEventListener("change",renderResults);
monsterLevel.addEventListener("change",renderResults);
dropType.addEventListener("change",renderResults);
document.getElementById("clear-filters").addEventListener("click",()=>{
 selectedItems.splice(0);q.value="";renderItemChips();
 liveFilter.checked=false;monsterLevel.value="all";dropType.value="all";eventFilter.value="";
 participationFilter.value="all";rankFilter.value="";schedule();
});
let suggestionTimer;
q.addEventListener("input",()=>{
 clearTimeout(suggestionTimer);
 const term=q.value.trim();if(term.length<2)return;
 suggestionTimer=setTimeout(async()=>{
  try{
   const response=await fetch(API+"/v2/suggest?q="+encodeURIComponent(term));
   if(!response.ok)return;
   const data=await response.json();
   if(q.value.trim()!==term)return;
   suggest.replaceChildren(...(data.items||[]).map(item=>{const option=document.createElement("option");option.value=item;return option;}));
  }catch{}
 },300);
});
async function loadEventChoices(){
 try{
  const result=await fetch(API+"/v4/chests/events");
  if(!result.ok)return;
  const data=await result.json();
  for(const entry of data.events||[]){
   const option=document.createElement("option");option.value=entry.name;option.textContent=entry.name+" ("+entry.count+")";eventFilter.append(option);
  }
  const initial=new URLSearchParams(location.search),requested=initial.get("event");
  if(requested&&[...eventFilter.options].some(option=>option.value===requested)){
   eventFilter.value=requested;load();
  }
 }catch{/* The main chest search remains functional if event suggestions are unavailable. */}
}
q.addEventListener("input",schedule);
source.addEventListener("change",()=>{setEventMode();schedule()});
eventFilter.addEventListener("change",schedule);
participationFilter.addEventListener("change",schedule);
rankFilter.addEventListener("input",schedule);
more.addEventListener("click",()=>{if(hasMore)load(true);});
reset.addEventListener("click",()=>{selected.clear();for(const cb of cards.querySelectorAll('input[type="checkbox"]')){cb.checked=false;cb.disabled=false}refreshSelected();panel.hidden=true;});
compare.addEventListener("click",async()=>{
 const ids=[...selected.keys()],params=new URLSearchParams();ids.forEach(id=>params.append("id",id));
 status.textContent="Preparing comparison…";
 try{
  const r=await fetch(API+"/v4/chests/compare?"+params);
  if(!r.ok)throw Error("Compare "+r.status);
  const data=await r.json();data.chests.sort(compareChest);head.replaceChildren();body.replaceChildren();
  const hr=el("tr"),first=el("th","","Reward item");first.scope="col";hr.append(first);
  for(const chest of data.chests){const th=el("th","",chest.name+(chest.level?" · "+chest.level:"")+(chest.rank?" · Rank "+chest.rank:""));th.scope="col";hr.append(th)}
  head.append(hr);
  const names=[...new Set(data.chests.flatMap(c=>[...c.items,...(c.nestedItems||[])].map(i=>i.item)))].sort(collator.compare);
  for(const name of names){
   const row=el("tr");row.append(el("td","",name));
   for(const chest of data.chests){
    const matches=[...chest.items,...(chest.nestedItems||[])].filter(i=>i.item===name),cell=el("td");
    if(!matches.length)cell.textContent="—";
    else for(const item of matches){
     const part=el("div","",item.quantity||"Quantity missing");
     const className=toText(item.classification)==="Unspecified"?"Data missing":item.classification;
     part.append(el("span","classification",className));
     if(item.via?.length)part.append(el("span","classification","Via "+item.via.join(" → ")+" (nested reward)"));
     cell.append(part);
    }
    row.append(cell);
   }
   body.append(row);
  }
  panel.hidden=false;status.textContent="";panel.scrollIntoView({behavior:"smooth",block:"start"});
 }catch{status.textContent="Could not compare these chests. Try again."}
});
const initial=new URLSearchParams(location.search);q.value=initial.get("q")||"";
const requestedSource=initial.get("source"),requestedEvent=initial.get("event");
const initialTab=requestedEvent||["events","activities"].includes(requestedSource)?"events":requestedSource==="bosses"?"monsters":"all";
loadEventChoices();renderItemChips();refreshSelected();selectTab(initialTab);
if(requestedSource==="unlinked")source.value="unlinked";
loadAvailability();
})();
</script></body></html>