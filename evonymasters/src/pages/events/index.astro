---
import events from '../../data/events.json';
const how = event => event.how || event.steps?.join(' ') || event.summary;
const rewards = event => event.rewards?.length ? event.rewards : [event.rewardStatus || 'Specific rewards have not yet been verified from the announcement.'];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Search Evony event activities, how to play and rewards from official announcements."/><title>Evony Events | evonymasters</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#eaf0f8;background:#0c1726}*{box-sizing:border-box}body{margin:0}a{color:#e6bc73}.wrap{max-width:1200px;margin:auto;padding:0 22px}header{background:#11243a;border-bottom:1px solid #30445c}.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between}.brand{font-size:1.45rem;font-weight:850;letter-spacing:-.04em;text-decoration:none;color:#eaf0f8}.brand span{color:#e6bc73}.hero{padding:55px 0 35px;background:radial-gradient(circle at 80% 10%,#234667 0,transparent 55%)}.eyebrow{color:#e6bc73;text-transform:uppercase;letter-spacing:.13em;font-size:.8rem;font-weight:800}h1{font-size:clamp(2.4rem,5vw,4rem);margin:12px 0}p{line-height:1.65}.muted{color:#b6c8d9}.search{display:block;width:100%;max-width:680px;border:1px solid #55708b;background:#0b1d30;color:#fff;padding:15px;border-radius:10px;font:inherit;margin:25px 0}.notice{border:1px solid #58708a;border-radius:10px;padding:14px 18px;background:#203a52}.table-wrap{overflow-x:auto;margin:22px 0 65px;border:2px solid #eaf0f8;border-radius:16px}table{width:100%;border-collapse:collapse;table-layout:fixed;background:#152b43}th{text-align:left;background:#203a52;color:#e6bc73;font-size:1rem;padding:18px;border-bottom:2px solid #eaf0f8}th:nth-child(1){width:24%}th:nth-child(2){width:37%}th:nth-child(3){width:39%}td{vertical-align:top;padding:19px 18px;line-height:1.65;border-bottom:1px solid #67819a;border-right:1px solid #45617b;overflow-wrap:anywhere}td:last-child,th:last-child{border-right:0}tr:last-child td{border-bottom:0}tbody tr:nth-child(even){background:#11243a}tbody tr:hover{background:#203a52}.event-name{font-size:1.12rem;font-weight:800;display:block;margin-bottom:7px}.meta{color:#b6c8d9;font-size:.83rem;display:block;margin-bottom:10px}.source{font-size:.85rem}.rewards{padding-left:20px;margin:0}.rewards li{margin-bottom:10px}.rewards li:last-child{margin-bottom:0}footer{border-top:1px solid #30445c;padding:24px 0;color:#a9bdcf;font-size:.82rem}@media(max-width:680px){.table-wrap{border:0;overflow:visible}table,tbody,tr,td{display:block;width:100%}thead{display:none}tr{display:block;border:2px solid #eaf0f8;border-radius:15px;overflow:hidden;margin-bottom:17px;background:#152b43}td{border-right:0;border-bottom:1px solid #45617b;padding:15px 18px}td:last-child{border-bottom:0}td:before{content:attr(data-label);display:block;color:#e6bc73;text-transform:uppercase;font-weight:800;font-size:.76rem;letter-spacing:.09em;margin-bottom:8px}.nav{gap:12px}}
</style></head><body><header><div class="wrap nav"><a class="brand" href="/">evony<span>masters</span></a><a href="/resources/">Resource Finder →</a></div></header><main><section class="hero"><div class="wrap"><div class="eyebrow">Evony: The King's Return · Player tools</div><h1>Events</h1><p class="muted">Search Evony events and activities to see how they work and what rewards are offered.</p><input id="event-search" class="search" type="search" placeholder="Search events, activities or rewards…" aria-label="Search events"/><p class="notice">This is an event reference, not a live schedule. Announcement dates are historical; check your in-game Event Center for current availability, requirements and prize pools.</p></div></section><section class="wrap"><p id="count" class="muted"></p><div class="table-wrap"><table><thead><tr><th scope="col">Event</th><th scope="col">How it works</th><th scope="col">Rewards</th></tr></thead><tbody>{events.map(event=><tr class="event-row" data-search={[event.name,event.category,event.parent||'',event.summary,how(event),...rewards(event)].join(' ').toLowerCase()}><td data-label="Event"><span class="event-name">{event.name}</span><span class="meta">{event.parent?event.parent+' · ':''}{event.category} · Announced {event.date}</span><a class="source" href={event.source} target="_blank" rel="noopener noreferrer">Official announcement ↗</a></td><td data-label="How it works">{how(event)}</td><td data-label="Rewards"><ul class="rewards">{rewards(event).map(reward=><li>{reward}</li>)}</ul></td></tr>)}</tbody></table></div><p id="empty" class="muted" hidden>No matching events. Try another keyword.</p></section></main><footer><div class="wrap">Independent fan-made reference. Not affiliated with the game publisher. Event availability and rewards may change.</div></footer><script>const search=document.querySelector('#event-search');const rows=[...document.querySelectorAll('.event-row')];const count=document.querySelector('#count');const empty=document.querySelector('#empty');function render(){const q=search.value.trim().toLowerCase();let n=0;for(const row of rows){row.hidden=!row.dataset.search.includes(q);if(!row.hidden)n++}count.textContent=n+' documented event'+(n===1?'':'s');empty.hidden=n>0}search.addEventListener('input',render);render();</script></body></html>