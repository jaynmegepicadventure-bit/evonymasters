---
import events from '../../data/events.json';
const promotion={name:'Regata Storica 2026',announced:'September 11, 2026',start:'September 11, 2026',end:null,source:'https://info.topgamesinc.com/evony-news/',activities:['Regata Storica celebration','New general and Decoration Collection','Monarch Images','Domain of Sea Spirit']};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Find Evony event activities and their rewards, plus the latest announced promotion."/><title>Evony Events | evonymasters</title><style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#eaf0f8;background:#0c1726}*{box-sizing:border-box}body{margin:0}[hidden]{display:none!important}a{color:#e6bc73}.wrap{max-width:1150px;margin:auto;padding:0 22px}header{background:#11243a;border-bottom:1px solid #30445c}.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:15px}.brand{font-size:1.45rem;font-weight:850;letter-spacing:-.04em;text-decoration:none;color:#eaf0f8}.brand span{color:#e6bc73}.hero{padding:55px 0 36px;background:radial-gradient(circle at 80% 10%,#234667 0,transparent 55%)}.eyebrow{color:#e6bc73;text-transform:uppercase;letter-spacing:.13em;font-size:.8rem;font-weight:800}h1{font-size:clamp(2.4rem,5vw,4rem);margin:12px 0}h2{font-size:1.45rem}.muted{color:#b6c8d9;line-height:1.65}.promo{border:2px solid #e6bc73;background:#152b43;border-radius:18px;padding:25px;margin-top:26px}.promo h2{margin:10px 0}.promo ul{display:flex;flex-wrap:wrap;gap:9px;list-style:none;padding:0}.promo li{background:#203a52;border:1px solid #58708a;border-radius:9px;padding:9px 12px}.notice{color:#d6e1ec;font-size:.9rem;line-height:1.6}.search-panel{background:#152b43;border:1px solid #35516d;border-radius:18px;padding:24px;margin:28px 0}.search-panel label{display:block;font-weight:750;margin-bottom:10px}.search{width:100%;border:1px solid #55708b;background:#0b1d30;color:#fff;padding:15px;border-radius:10px;font:inherit}.search:focus{outline:2px solid #e6bc73;outline-offset:2px}.results-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:25px 0 18px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:17px;margin-bottom:65px}.card{background:#14283f;border:2px solid #fff;border-radius:18px;overflow:hidden;box-shadow:0 5px 18px #0004}.card-top{padding:19px;border-bottom:1px solid #45617b}.card h3{font-size:1.25rem;margin:0 0 9px}.card-body{padding:17px 19px}.reward-title{color:#9ce0ae;font-size:.79rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em}.reward-list{display:flex;flex-direction:column;gap:8px;margin:12px 0}.reward{display:block;background:#203a52;border:1px solid #466079;border-radius:9px;padding:10px 12px;line-height:1.55;font-size:.91rem}.source{font-size:.85rem}.count{color:#b6c8d9}.empty{border:1px dashed #55708b;border-radius:15px;padding:28px;text-align:center}footer{border-top:1px solid #30445c;padding:24px 0;color:#a9bdcf;font-size:.82rem;line-height:1.6}@media(max-width:530px){.hero{padding-top:35px}.search-panel{padding:17px}.promo{padding:19px}.nav a:last-child{font-size:.85rem}}
</style></head><body><header><div class="wrap nav"><a class="brand" href="/">evony<span>masters</span></a><a href="/resources/">Resource Finder →</a></div></header><main><section class="hero"><div class="wrap"><div class="eyebrow">Evony: The King's Return · Player tools</div><h1>Find your event rewards</h1><p class="muted">Search event names to find the resources and featured items offered. Reward pools may change with each event round.</p><section class="promo" aria-labelledby="promo-title"><div class="eyebrow">Latest official promotion announcement · Status not confirmed</div><h2 id="promo-title">{promotion.name}</h2><p class="muted">Announced {promotion.announced} · Start: {promotion.start} · End: {promotion.end||'Not specified in the available announcement'}</p><p class="notice">The official news hub lists this as its latest promotion. Its end date and whether it is still running have not been confirmed; check the in-game Event Center.</p><h3>Announced activities and features</h3><ul>{promotion.activities.map(activity=><li>{activity}</li>)}</ul><a href={promotion.source} target="_blank" rel="noopener noreferrer">Official Evony announcements ↗</a></section></div></section><section class="wrap"><div class="search-panel"><label for="event-search">Find an event or reward</label><input id="event-search" class="search" type="search" placeholder="Search event names, resources or rewards…" autocomplete="off"/></div><div class="results-head"><h2>Event results</h2><span id="count" class="count">{events.length} events</span></div><div id="results" class="grid">{events.map(event=><article class="card" data-search={[event.name,...event.rewards,event.notes].join(' ').toLowerCase()}><div class="card-top"><h3>{event.name}</h3><a class="source" href={event.source} target="_blank" rel="noopener noreferrer">Official source ↗</a></div><div class="card-body"><p class="reward-title">Resources &amp; featured rewards</p><div class="reward-list">{event.rewards.map(reward=><div class="reward">{reward}</div>)}</div><p class="muted">{event.notes}</p></div></article>)}</div><p id="empty" class="empty" hidden>No matching events or rewards. Try another search.</p></section></main><footer><div class="wrap">Independent fan-made Evony reference. Not affiliated with the game publisher. Rewards, availability and promotion dates can change; verify details in game.</div></footer><script>const input=document.querySelector('#event-search');const cards=[...document.querySelectorAll('.card')];const count=document.querySelector('#count');const empty=document.querySelector('#empty');function render(){const term=input.value.trim().toLowerCase();let n=0;for(const card of cards){card.hidden=!card.dataset.search.includes(term);if(!card.hidden)n++}count.textContent=n+' event'+(n===1?'':'s');empty.hidden=n>0}input.addEventListener('input',render);render();</script></body></html>