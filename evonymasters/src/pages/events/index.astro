---
import events from '../../data/events.json';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Search Evony event guides, participation steps and historical announcements."/><title>Evony Events | evonymasters</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#eaf0f8;background:#0c1726}*{box-sizing:border-box}body{margin:0}a{color:#e6bc73}.wrap{max-width:1150px;margin:auto;padding:0 22px}header{background:#11243a;border-bottom:1px solid #30445c}.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between}.brand{font-size:1.45rem;font-weight:850;letter-spacing:-.04em;text-decoration:none;color:#eaf0f8}.brand span{color:#e6bc73}.hero{padding:55px 0 35px;background:radial-gradient(circle at 80% 10%,#234667 0,transparent 55%)}.eyebrow{color:#e6bc73;text-transform:uppercase;letter-spacing:.13em;font-size:.8rem;font-weight:800}h1{font-size:clamp(2.4rem,5vw,4rem);margin:12px 0}p{line-height:1.65}.muted{color:#b6c8d9}.search{display:block;width:100%;max-width:680px;border:1px solid #55708b;background:#0b1d30;color:#fff;padding:15px;border-radius:10px;font:inherit;margin:25px 0}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px;margin:24px 0 65px}.card{background:#152b43;border:2px solid #597b9b;border-radius:16px;padding:23px}.card h2{margin:10px 0;font-size:1.4rem}.badge{color:#e6bc73;font-size:.8rem;font-weight:800}.card ol{padding-left:23px;line-height:1.65}.card li{margin-bottom:10px}.reward-list{padding-left:23px;line-height:1.65}.reward-list li{padding:8px 0;border-bottom:1px solid #55708b}.card .source{font-size:.84rem}.notice{border:1px solid #58708a;border-radius:10px;padding:14px 18px;background:#203a52}footer{border-top:1px solid #30445c;padding:24px 0;color:#a9bdcf;font-size:.82rem}@media(max-width:530px){.nav{gap:15px}.nav a:last-child{font-size:.86rem}}
</style></head><body><header><div class="wrap nav"><a class="brand" href="/">evony<span>masters</span></a><a href="/resources/">Resource Finder →</a></div></header><main><section class="hero"><div class="wrap"><div class="eyebrow">Evony: The King's Return · Player tools</div><h1>Events</h1><p class="muted">Search event guides and learn how to participate. We're expanding this reference as events are documented.</p><input id="event-search" class="search" type="search" placeholder="Search events, activities or rewards…" aria-label="Search events"/><p class="notice">These are documented event rounds, not a live event calendar. Dates below refer to their announcements; check your in-game Event Center for current availability and rules.</p></div></section><section class="wrap"><p id="count" class="muted"></p><div id="event-grid" class="grid">{events.map(event=><article class="card" data-search={[event.name,event.category,event.summary,...event.steps,...(event.rewards||[])].join(' ').toLowerCase()}><div class="badge">{event.category} · Announced {event.date}</div><h2>{event.name}</h2><p class="muted">{event.summary}</p><h3>How to participate</h3><ol>{event.steps.map(step=><li>{step}</li>)}</ol><h3>Featured rewards</h3>{event.rewards?.length?<ul class="reward-list">{event.rewards.map(reward=><li>{reward}</li>)}</ul>:<p class="muted">{event.rewardStatus||"Specific rewards have not yet been verified from the announcement."}</p>}<p class="source"><a href={event.source} target="_blank" rel="noopener noreferrer">Official announcement ↗</a></p></article>)}</div><p id="empty" class="muted" hidden>No matching events. Try a different keyword.</p></section></main><footer><div class="wrap">Independent fan-made reference. Not affiliated with the game publisher. Event availability and rules may change.</div></footer><script>const search=document.querySelector('#event-search');const cards=[...document.querySelectorAll('.card')];const count=document.querySelector('#count');const empty=document.querySelector('#empty');function render(){const q=search.value.trim().toLowerCase();let n=0;for(const card of cards){card.hidden=!card.dataset.search.includes(q);if(!card.hidden)n++}count.textContent=n+' documented event'+(n===1?'':'s');empty.hidden=n>0}search.addEventListener('input',render);render();</script></body></html>