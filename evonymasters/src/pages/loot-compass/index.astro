---
import SiteHeader from '../../components/SiteHeader.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Loot Compass (Beta) | EvonyMasters</title><meta name="description" content="Loot Compass finds confirmed LIVE event rewards and guaranteed monster rewards for your Evony farming goals."/>
<style is:global>
:root{font:16px Inter,system-ui,sans-serif;color:#edf3fa;background:#0b1929}*{box-sizing:border-box}body{margin:0}a{color:#f2ce8e}
.wrap{max-width:1180px;padding:28px 22px 70px;margin:auto}.eyebrow{color:#f6cb84;text-transform:uppercase;font-size:.74rem;letter-spacing:.13em;font-weight:800}
h1{font-size:clamp(2rem,4vw,3.15rem);margin:10px 0}h2{font-size:1.35rem;margin:0 0 12px}p{line-height:1.55;color:#c4d1dd}.muted{color:#a6bed1;font-size:.85rem}
.panel{background:#172d43;border:1px solid #36516b;border-radius:14px;padding:22px;margin-top:19px}
.inputs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}
label{display:grid;gap:7px;font-size:.82rem;color:#dbcaac;font-weight:750}input,select{font:inherit;width:100%;padding:12px;border:1px solid #60758c;border-radius:8px;background:#f6fafc;color:#13233a}
button{font:inherit;cursor:pointer;border:0;border-radius:8px;background:#f0c779;color:#13283b;padding:12px 18px;font-weight:850}button:disabled{opacity:.45;cursor:not-allowed}
form .actions{display:flex;align-items:center;gap:15px;margin-top:15px;flex-wrap:wrap}.summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.stat{border:1px solid #45617b;background:#203b53;border-radius:10px;padding:15px}.stat strong{display:block;font-size:1.65rem;color:#ffe2a6;margin-top:5px}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:12px 10px;border-bottom:1px solid #36516b;vertical-align:top;font-size:.9rem}th{color:#e5be7d}td:nth-child(n+2),th:nth-child(n+2){text-align:right}.scroll{overflow:auto}
.note{background:#233a50;border-left:3px solid #dab56d;padding:13px;border-radius:5px;font-size:.85rem;color:#d8e4ee}.error{color:#ffb9aa}.badge{border:1px solid #7599b0;border-radius:99px;padding:3px 7px;font-size:.73rem}
#suggestions{max-width:490px}section[hidden]{display:none!important}@media(max-width:750px){.inputs{grid-template-columns:repeat(2,1fr)}.summary{grid-template-columns:1fr}}@media(max-width:460px){.inputs{grid-template-columns:1fr}}
.spotlight{background:linear-gradient(115deg,#233b50,#162a40);border-color:#b9965b}.recommend-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.recommend-grid .panel{margin-top:19px}.rec-number{font-weight:800;color:#ffe0a2;font-size:1.5rem;margin:8px 0}.opportunities{display:grid;gap:9px}.opportunity{padding:12px 14px;border:1px solid #395873;border-radius:10px;display:flex;justify-content:space-between;gap:18px}.opportunity strong{color:#f6d18c}.opportunity small{display:block;color:#a8bed1;margin-top:4px}.spotlight h2{font-size:1.7rem;color:#f6d18c}@media(max-width:760px){.recommend-grid{grid-template-columns:1fr}} 
</style></head><body><SiteHeader/><main class="wrap">
<div class="eyebrow">Player tools · Your next haul, mapped</div>
<h1>Loot Compass <span style="color:#e6bc73;font-size:.48em;vertical-align:middle">BETA</span></h1>
<p>Pick an item, enter your total stamina and how many days you have. Loot Compass estimates the rewards you could earn from confirmed Calendar events and monster farming. One search, no goal quantity or activity checklist.</p>
<div class="panel" style="border-color:#a38a58;background:#25364a;margin-top:15px;padding:15px 20px" role="note"><strong>Accuracy notice · Beta</strong><p style="margin:6px 0 0">This planner reads the latest synced EvonyMasters rewards and published Calendar schedules. Drop rates, chest values, milestone rules and availability may be incomplete or change in-game. Guaranteed rewards still require completing the activity. Possible drops are excluded entirely. Verify rewards in-game before committing stamina or resources. When LIVE availability cannot be checked, this planner does not guess.</p></div>
<div class="panel"><form id="form">
<div class="inputs">
<label>Item
<input id="item" list="suggestions" placeholder="Gems, Ore, Refining Stone…" required autocomplete="off"/>
<datalist id="suggestions"></datalist></label>
<label>Total stamina across the period<input id="stamina" placeholder="e.g. 10000" inputmode="numeric" required/></label>
<label>Number of days (1–60)<input id="days" placeholder="e.g. 7" inputmode="numeric" required/></label>
</div>
<div class="actions"><button type="submit" id="calculate">Estimate my rewards</button><span class="muted">Stamina is your TOTAL budget, not an amount per day. Estimates only use confirmed Calendar dates.</span></div>
</form></div>
<p id="status" role="status" class="muted">Search to check confirmed LIVE schedules and freshly synced rewards.</p>
<section id="result" hidden aria-live="polite">
<div class="panel spotlight">
<div class="eyebrow">Confirmed calendar reward outlook</div>
<h2 id="recommend-title">Loot Compass</h2>
<p id="recommend-intro"></p>
<p id="no-results-explanation" class="note" hidden></p>
<div class="summary" id="summary"></div>
<p id="combined-estimate" class="note" style="margin-top:15px"></p>
</div>
<div class="panel" id="event-card">
<div class="eyebrow">01 · Event rewards (not stamina-limited)</div>
<h2>Events contributing to your total</h2>
<p class="muted">Assumes all qualifying activities are completed, the highest documented tier is reached, and first place is achieved for ranking prizes. These are conditional guaranteed prize entries, not automatically received items.</p>
<div class="scroll"><table><thead><tr><th>LIVE event</th><th>Confirmed days</th><th>Per qualifying day</th><th>Event total</th></tr></thead><tbody id="event-breakdown"></tbody></table></div>
<p class="note" id="event-estimate"></p>
</div>
<div class="panel" id="monster-card">
<div class="eyebrow">02 · Monster farming (stamina only)</div>
<h2>Top 10 highest-returning LIVE monsters</h2>
<p class="muted">Each row independently spends your full total stamina budget on that monster. These are alternatives, not rewards that can all be collected with the same stamina.</p>
<div class="scroll"><table><thead><tr><th>Monster</th><th>Stamina / kill</th><th>Item / kill</th><th>Number to kill</th><th>Return</th></tr></thead><tbody id="monster-breakdown"></tbody></table></div>
<p id="monster-empty" class="note" hidden>No live monsters provide this item.</p>
</div>
<div class="panel">
<h2>How the estimate works</h2>
<p id="caveat" class="note"></p>
</div>
</section>
</main>
<script>
import {normalise,parseAmount,dayUTC,dayAdd,liveIndex,eligibleRecord,periodBreakdown} from '../../lib/reward-planner.mjs';
const SHEET="https://evonymasters-sheet-sync.jaynmegepicadventure.workers.dev";
const CALENDAR="https://evonymasters-calendar.jaynmegepicadventure.workers.dev/api/events";
const $=id=>document.getElementById(id),fmt=n=>n===null||n===undefined?"—":new Intl.NumberFormat("en-US",{maximumFractionDigits:0}).format(n);
const line=(container,name,reward,detail)=>{
 const row=document.createElement("div");row.className="opportunity";
 const left=document.createElement("div"),label=document.createElement("strong"),small=document.createElement("small"),amount=document.createElement("strong");
 label.textContent=name;small.textContent=detail||"";amount.textContent=fmt(reward);
 left.append(label,small);row.append(left,amount);container.append(row);
};
const stateMsg=(message,error=false)=>{$("status").textContent=message;$("status").className=error?"error":"muted"};
function terms(target) {
 const aliases={
  food:["Food","Safe Food"],
  wood:["Wood","Lumber","Safe Wood","Safe Lumber"],
  stone:["Stone","Safe Stone"],
  ore:["Ore","Safe Ore"]
 };
 const canonical=normalise(target);
 const expanded=canonical==="combined resources"
  ?Object.values(aliases).flat()
  :Object.entries(aliases).find(([,names])=>names.some(name=>normalise(name)===canonical))?.[1];
 if(expanded) {
  return [...new Set([...expanded,"Super Resources Chest","Super Resource Chest","Super Safe Resource Chest","Super Safe Resources Chest"])];
 }
 return [target];
}
function stableRecordKey(row){
 return [row.source,row.title,row.context?.subEvent,row.context?.detail,row.context?.level,row.context?.activity].map(normalise).join("|");
}
async function fetchSearch(term,signal) {
 const groups=[];let truncated=false,compatibility=false;
 for(let page=0;page<20;page++){
  let data=null,failures=[];
  // Prefer guaranteed-only results to avoid a 12-detail cap. Older Worker
  // deployments may only accept the Item Finder search parameters.
  for(const guaranteed of [true,false]){
   const args=new URLSearchParams({q:term,type:"all",page:String(page),sort:"suggested"});
   if(guaranteed)args.set("drop","Guaranteed");
   try{
    const response=await fetch(SHEET+"/v3/search?"+args,{signal,mode:"cors"});
    if(!response.ok)throw Error("HTTP "+response.status);
    const next=await response.json();
    if(!Array.isArray(next.groups))throw Error("Invalid search response");
    data=next;compatibility ||= !guaranteed;break;
   }catch(error){
    if(error.name==="AbortError")throw error;
    failures.push((guaranteed?"guaranteed":"standard")+" request: "+(error.message||"network failure"));
   }
  }
  if(!data)throw Error(term+": "+failures.join("; "));
  groups.push(...data.groups.filter(x=>x.source!=="boxes"));
  if(!data.hasMore)break;
  if(page===19)truncated=true;
 }
 return {groups,truncated,compatibility};
}
async function calendarWindow(today,span,signal){
 const params=new URLSearchParams({from:today,to:dayAdd(today,span-1),kind:"all",includeAlways:"true"});
 let response;
 try{response=await fetch(CALENDAR+"?"+params,{signal})}
 catch(e){if(e.name==="AbortError")throw e;throw Error("Calendar connection failed. Check that the Calendar Worker is deployed and allows this site.")}
 if(!response.ok)throw Error("Calendar returned HTTP "+response.status);
 const data=await response.json();
 if(!Array.isArray(data.events))throw Error("Calendar response has no schedules");
 return data;
}
async function fetchCalendar(today,desiredDays,signal){
 // Check the entire requested period in small consecutive windows so the
 // Calendar 9,000-entry response cap cannot silently shorten estimates.
 const events=[];let daysChecked=0;
 for(let offset=0;offset<desiredDays;){
  let span=Math.min(7,desiredDays-offset),window=null;
  while(span>=1){
   try{
    const fetched=await calendarWindow(dayAdd(today,offset),span,signal);
    if(!fetched.truncated){window=fetched;break;}
   }catch(error){
    if(error.name==="AbortError")throw error;
    if(offset===0&&span===1)throw error;
   }
   if(span===1)break;
   span=Math.max(1,Math.floor(span/2));
  }
  if(!window)break;
  events.push(...window.events);
  offset+=span;daysChecked=offset;
 }
 if(daysChecked===0)throw Error("Calendar could not verify today's LIVE availability");
 return {events,daysChecked,forecastLimited:daysChecked<desiredDays};
}
async function fetchAllRewards(target,signal){
 const requested=terms(target),searches=[],failures=[];
 // Limit simultaneous Worker requests to avoid overloading a busy search endpoint.
 for(let i=0;i<requested.length;i+=2){
  const batch=await Promise.allSettled(requested.slice(i,i+2).map(q=>fetchSearch(q,signal)));
  for(let j=0;j<batch.length;j++){
   const x=batch[j];
   if(x.status==="fulfilled")searches.push(x.value);
   else if(x.reason?.name==="AbortError")throw x.reason;
   else failures.push(requested[i+j]+": "+(x.reason?.message||"connection failed"));
  }
 }
 if(!searches.length)throw Error("Reward Worker could not be reached for any item. "+failures.slice(0,3).join(" | ")+". Open "+SHEET+"/health to test the Worker. If health responds but search fails, check its deployment, CORS allowance for this Pages domain, and DATA binding.");
 // Food inside a monster chest is returned as a nested route, with the food
 // amount PER CHEST. Look up the direct guaranteed parent chest entry to
 // verify how many chests the monster awards per hunt. Never assume one.
 const parents=[...new Set(searches.flatMap(result=>result.groups).filter(row=>row.source!=="events"&&row.source!=="boxes")
  .flatMap(row=>(row.items||[]).filter(item=>item.classification==="Guaranteed"&&
    item.route?.length===2&&item.route[0]&&item.route[0].length>=2&&item.route[0].length<=100)
    .map(item=>item.route[0])))];
 const limit=30;
 for(let i=0;i<Math.min(limit,parents.length);i+=2){
  const batch=await Promise.allSettled(parents.slice(i,i+2).map(name=>fetchSearch(name,signal)));
  for(let j=0;j<batch.length;j++){
   const outcome=batch[j];
   if(outcome.status==="fulfilled")searches.push(outcome.value);
   else if(outcome.reason?.name==="AbortError")throw outcome.reason;
   else failures.push("Chest "+parents[i+j]+": "+(outcome.reason?.message||"connection failed"));
  }
 }
 if(parents.length>limit)failures.push("Chest verification limited to "+limit+" of "+parents.length+" distinct chest types.");
 return {searches,failures};
}
function mergeGroups(groups) {
 const unique=new Map();
 for(const row of groups){
  const key=stableRecordKey(row);
  let target=unique.get(key);
  if(!target){target={...row,items:[]};unique.set(key,target)}
  const seen=new Set(target.items.map(x=>JSON.stringify([x.item,x.quantity,x.classification,x.route])));
  for(const item of row.items||[]){
   const signature=JSON.stringify([item.item,item.quantity,item.classification,item.route]);
   if(!seen.has(signature)){target.items.push(item);seen.add(signature)}
  }
 }
 return [...unique.values()];
}
function show(rows,target,stamina,days,index,today,calendar,diagnostics,partialRewards) {
 const forecast=periodBreakdown(rows,index,{stamina,days,start:today,checkedDays:calendar.daysChecked});
 if(!forecast)throw Error("Enter valid total stamina and a number of days from 1 to 60");
 const title=$("recommend-title");
 title.textContent="Your "+target+" outlook for "+forecast.days+" day"+(forecast.days===1?"":"s");
 $("recommend-intro").textContent="Event qualifying rewards are separate from monster stamina. Monster rankings use "+fmt(forecast.stamina)+" TOTAL stamina, once, across the period.";
 const summary=$("summary");summary.replaceChildren();
 for(const [label,value] of [
  ["Event total (assuming completion)",fmt(forecast.eventTotal)+" "+target],
  ["Best monster with full stamina",forecast.topMonster?fmt(forecast.topMonster.total)+" "+target:"No qualifying monster return"],
  ["Confirmed Calendar days",fmt(forecast.checkedDays)+" / "+fmt(forecast.days)]
 ]) {
  const card=document.createElement("div");card.className="stat";
  const name=document.createElement("span");name.className="muted";name.textContent=label;
  const valueNode=document.createElement("strong");valueNode.textContent=value;
  card.append(name,valueNode);summary.append(card);
 }
 const note=[];
 if(!forecast.complete)note.push("Calendar coverage is incomplete: only "+forecast.checkedDays+" of "+forecast.days+" days verified. All event amounts below cover only those days.");
 if(partialRewards)note.push("Some reward queries used compatibility search, failed or were truncated. Returned entries are still filtered to direct Guaranteed rewards, but results may be incomplete.");
 note.push("Events assume qualification for the stated reward, including highest documented Tier N and rank 1 where applicable. Event rewards may require overlapping actions or costs. The event total is the sum of the event rows below, not a guaranteed amount already earned.");
 $("combined-estimate").textContent=note.join(" ");
 const eb=$("event-breakdown");eb.replaceChildren();
 for(const event of forecast.events){
  const tr=document.createElement("tr");
  for(const value of [event.name,event.occurrences,fmt(event.perCompletion),fmt(event.conditionalTotal)]){
   const td=document.createElement("td");td.textContent=String(value);tr.append(td);
  }
  eb.append(tr);
 }
 if(!forecast.events.length){
  const tr=document.createElement("tr"),td=document.createElement("td");
  td.colSpan=4;td.textContent="No confirmed LIVE events have qualifying guaranteed "+target+" rewards in the verified period.";tr.append(td);eb.append(tr);
 }
 $("event-estimate").textContent="Event subtotal: "+fmt(forecast.eventTotal)+" "+target+" assuming all listed completion and first-place requirements are fulfilled. Ranking rewards without identifiable first-place values are excluded.";
 const mb=$("monster-breakdown");mb.replaceChildren();
 for(const monster of forecast.monsters) {
  const tr=document.createElement("tr");
  const displayName=monster.name+(monster.level?" · Lv "+monster.level:"");
  for(const value of [displayName,fmt(monster.staminaPerKill),fmt(monster.perKill),fmt(monster.kills),fmt(monster.total)]){
   const td=document.createElement("td");td.textContent=String(value);tr.append(td);
  }
  mb.append(tr);
 }
 $("monster-empty").hidden=forecast.monsters.length>0;
 $("caveat").textContent="Only quantified Guaranteed reward entries and verified guaranteed monster chest contents are included. Event rewards and event bosses require confirmed Calendar dates. First-place rankings and highest documented tiers are assumptions, not guaranteed achievements. For each event activity, the largest qualifying entry is used rather than stacking mutually exclusive prize variants. The event subtotal adds all shown events and assumes their conditions can all be met. Regular monsters and ordinary bosses are persistent, while event bosses require a confirmed LIVE Calendar schedule. Guaranteed monster chest contents count only when the chest award quantity and its guaranteed contents are both documented. Each monster row is an alternative use of the SAME stamina budget: floor(total stamina ÷ stamina per kill) × recorded guaranteed item per kill. Possible drops, nested chests, unknown quantities and stamina regeneration are excluded. Food includes Safe Food and the Food portion of Super and Super Safe Resource Chests.";
 const empty=$("no-results-explanation");
 empty.hidden=forecast.events.length>0||forecast.monsters.length>0;
 if(!empty.hidden)empty.textContent="No qualifying guaranteed "+target+" matches were found. Calendar supplied "+diagnostics.confirmed+" confirmed occurrences and reward search returned "+diagnostics.groups+" groups before LIVE and ranking checks.";
 $("result").hidden=false;
}
let abort=null;
$("form").addEventListener("submit",async event=>{
 event.preventDefault();if(abort)abort.abort();abort=new AbortController();
 const target=$("item").value.trim(),stamina=$("stamina").value.trim(),days=$("days").value.trim();
 const staminaAmount=parseAmount(stamina),dayCount=parseAmount(days);
 if(!target||staminaAmount===null||dayCount===null||!Number.isInteger(dayCount)||dayCount<1||dayCount>60){
  stateMsg("Choose an item, a nonnegative total stamina budget and a whole number of days from 1 to 60.",true);return;
 }
 $("result").hidden=true;$("calculate").disabled=true;
 stateMsg("Checking confirmed Calendar dates and guaranteed reward entries…");
 try{
  const today=dayUTC();
  const [calendar,rewards]=await Promise.all([
   fetchCalendar(today,dayCount,abort.signal),fetchAllRewards(target,abort.signal)
  ]);
  const searches=rewards.searches,index=liveIndex(calendar.events,today);
  const allGroups=mergeGroups(searches.flatMap(x=>x.groups));
  const rows=allGroups.map(row=>{
   if(row.source!=="events")return eligibleRecord(row,target,index,today);
   for(let offset=0;offset<calendar.daysChecked;offset++){
    const found=eligibleRecord(row,target,index,dayAdd(today,offset));
    if(found)return found;
   }
   return null;
  }).filter(Boolean);
  show(rows,target,stamina,days,index,today,calendar,{
   confirmed:calendar.events.filter(x=>x.status==="Confirmed").length,
   groups:allGroups.length
  },searches.some(x=>x.truncated||x.compatibility)||rewards.failures.length>0);
  stateMsg(rows.length?
    "Forecast uses "+calendar.daysChecked+" confirmed Calendar day(s), "+rows.length+" matching reward sources.":
    "No recorded guaranteed LIVE matches found; see details below.");
 }catch(error){
  if(error.name!=="AbortError")stateMsg("Unable to estimate rewards: "+error.message+". Unverified LIVE dates are not substituted.",true);
 }finally{$("calculate").disabled=false}
});
// Start a clean one-time search even when the browser restores this page from cache.
window.addEventListener("pageshow",()=>{
 if(abort)abort.abort();
 $("form").reset();
 $("item").value="";
 $("stamina").value="";
 $("days").value="";
 $("suggestions").replaceChildren();
 $("result").hidden=true;
 $("calculate").disabled=false;
 stateMsg("Choose an item to start a new one-time LIVE search.");
});
let timer;
$("item").addEventListener("input",()=>{
 clearTimeout(timer);const query=$("item").value.trim();if(query.length<2)return;
 timer=setTimeout(async()=>{try{const r=await fetch(SHEET+"/v2/suggest?"+new URLSearchParams({q:query}));if(!r.ok)return;const data=await r.json(),list=$("suggestions");list.replaceChildren();for(const name of data.items||[]){const option=document.createElement("option");option.value=name;list.append(option)}}catch{}},240);
});
</script></body></html>
