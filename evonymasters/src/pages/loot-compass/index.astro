---
import SiteHeader from '../../components/SiteHeader.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Loot Compass (Beta) | EvonyMasters</title><meta name="description" content="Loot Compass finds confirmed LIVE event rewards and guaranteed monster rewards for your Evony farming goals."/>
<style is:global>
:root{font:16px Inter,system-ui,sans-serif;color:#edf3fa;background:#0b1929}*{box-sizing:border-box}body{margin:0}a{color:#f2ce8e}
.wrap{max-width:1180px;padding:28px 22px 70px;margin:auto}.eyebrow{color:#f6cb84;text-transform:uppercase;font-size:.74rem;letter-spacing:.13em;font-weight:800}
h1{font-size:clamp(2rem,4vw,3.15rem);margin:10px 0}h2{font-size:1.35rem;margin:0 0 12px}p{line-height:1.55;color:#c4d1dd}.muted{color:#a6bed1;font-size:.85rem}
.panel{background:#172d43;border:1px solid #36516b;border-radius:14px;padding:22px;margin-top:19px}
.inputs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}
label{display:grid;gap:7px;font-size:.82rem;color:#dbcaac;font-weight:750}input,select{font:inherit;width:100%;padding:12px;border:1px solid #60758c;border-radius:8px;background:#f6fafc;color:#13233a}
button{font:inherit;cursor:pointer;border:0;border-radius:8px;background:#f0c779;color:#13283b;padding:12px 18px;font-weight:850}button:disabled{opacity:.45;cursor:not-allowed}
form .actions{display:flex;align-items:center;gap:15px;margin-top:15px;flex-wrap:wrap}.summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.stat{border:1px solid #45617b;background:#203b53;border-radius:10px;padding:15px}.stat strong{display:block;font-size:1.65rem;color:#ffe2a6;margin-top:5px}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:12px 10px;border-bottom:1px solid #36516b;vertical-align:top;font-size:.9rem}th{color:#e5be7d}td:nth-child(n+2),th:nth-child(n+2){text-align:right}.scroll{overflow:auto}
.note{background:#233a50;border-left:3px solid #dab56d;padding:13px;border-radius:5px;font-size:.85rem;color:#d8e4ee}.error{color:#ffb9aa}.badge{border:1px solid #7599b0;border-radius:99px;padding:3px 7px;font-size:.73rem}
#suggestions{max-width:490px}section[hidden]{display:none!important}@media(max-width:750px){.inputs{grid-template-columns:repeat(2,1fr)}.summary{grid-template-columns:1fr}}@media(max-width:460px){.inputs{grid-template-columns:1fr}}
.spotlight{background:linear-gradient(115deg,#233b50,#162a40);border-color:#b9965b}.recommend-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.recommend-grid .panel{margin-top:19px}.rec-number{font-weight:800;color:#ffe0a2;font-size:1.5rem;margin:8px 0}.opportunities{display:grid;gap:9px}.opportunity{padding:12px 14px;border:1px solid #395873;border-radius:10px;display:flex;justify-content:space-between;gap:18px}.opportunity strong{color:#f6d18c}.opportunity small{display:block;color:#a8bed1;margin-top:4px}.spotlight h2{font-size:1.7rem;color:#f6d18c}@media(max-width:760px){.recommend-grid{grid-template-columns:1fr}} 
</style></head><body><SiteHeader/><main class="wrap">
<div class="eyebrow">Player tools · Your next haul, mapped</div>
<h1>Loot Compass <span style="color:#e6bc73;font-size:.48em;vertical-align:middle">BETA</span></h1>
<p>Choose an item, total stamina and number of days. Loot Compass estimates how much you could obtain from LIVE events and the best matching monster. No target quantity or extra steps.</p>
<div class="panel" style="border-color:#a38a58;background:#25364a;margin-top:15px;padding:15px 20px" role="note"><strong>Accuracy notice · Beta</strong><p style="margin:6px 0 0">This planner reads the latest synced EvonyMasters rewards and published Calendar schedules. Drop rates, chest values, milestone rules and availability may be incomplete or change in-game. Guaranteed rewards still require completing the activity. Possible drops are excluded entirely. Verify rewards in-game before committing stamina or resources. When LIVE availability cannot be checked, this planner does not guess.</p></div>
<div class="panel"><form id="form">
<div class="inputs">
<label>Item
<input id="item" list="suggestions" placeholder="Gems, Ore, Refining Stone…" required autocomplete="off"/>
<datalist id="suggestions"></datalist></label>
<label>Total stamina (for the whole period)<input id="stamina" placeholder="e.g. 10000" required inputmode="numeric"/></label>
<label>Number of days<input id="days" placeholder="e.g. 7" required inputmode="numeric"/></label>
</div>
<div class="actions"><button type="submit" id="calculate">Find my best route</button><span class="muted">Stamina is your total budget, not a daily allowance.</span></div>
</form></div>
<p id="status" role="status" class="muted">Search to check confirmed LIVE schedules and freshly synced rewards.</p>
<section id="result" hidden aria-live="polite">
<div class="panel spotlight">
<div class="eyebrow">Your recommended route</div>
<h2 id="recommend-title">Loot Compass recommendation</h2>
<p id="no-results-explanation" class="note" hidden></p>
<p id="recommend-intro"></p>
<div class="summary" id="summary"></div>
<p id="combined-estimate" class="note" style="margin-top:15px"></p>
</div>
<div class="recommend-grid">
<article class="panel" id="event-card">
<div class="eyebrow">01 · Events first</div>
<h2 id="event-name">Recommended LIVE event</h2>
<p class="rec-number" id="event-reward"></p>
<p id="event-explanation"></p>
<div class="note" id="event-estimate"></div>
</article>
<article class="panel" id="monster-card">
<div class="eyebrow">02 · Monster farming</div>
<h2 id="monster-name">Recommended LIVE monster</h2>
<p class="rec-number" id="monster-reward"></p>
<p id="monster-explanation"></p>
<div class="note" id="monster-estimate"></div>
</article>
</div>
<div class="panel">
<h2>Other confirmed LIVE opportunities</h2>
<p class="muted">Automatically ranked. No need to select, tick or claim anything here.</p>
<div id="other-results" class="opportunities"></div>
</div>
<div class="panel">
<h2>How reliable is this plan?</h2>
<p id="caveat" class="note"></p>
</div>
</section>
</main>
<script>
import {normalise,parseAmount,dayUTC,dayAdd,liveIndex,eligibleRecord,yieldForecast} from '../../lib/reward-planner.mjs';
const SHEET="https://evonymasters-sheet-sync.jaynmegepicadventure.workers.dev";
const CALENDAR="https://evonymasters-calendar.jaynmegepicadventure.workers.dev/api/events";
const $=id=>document.getElementById(id),fmt=n=>n===null||n===undefined?"—":new Intl.NumberFormat("en-US",{maximumFractionDigits:0}).format(n);
const line=(container,name,reward,detail)=>{
 const row=document.createElement("div");row.className="opportunity";
 const left=document.createElement("div"),label=document.createElement("strong"),small=document.createElement("small"),amount=document.createElement("strong");
 label.textContent=name;small.textContent=detail||"";amount.textContent=fmt(reward);
 left.append(label,small);row.append(left,amount);container.append(row);
};
const stateMsg=(message,error=false)=>{$("status").textContent=message;$("status").className=error?"error":"muted"};
function terms(target) {
 const aliases={
  food:["Food","Safe Food"],
  wood:["Wood","Lumber","Safe Wood","Safe Lumber"],
  stone:["Stone","Safe Stone"],
  ore:["Ore","Safe Ore"]
 };
 const canonical=normalise(target);
 const expanded=canonical==="combined resources"
  ?Object.values(aliases).flat()
  :Object.entries(aliases).find(([,names])=>names.some(name=>normalise(name)===canonical))?.[1];
 if(expanded) {
  return [...new Set([...expanded,"Super Resources Chest","Super Resource Chest","Super Safe Resource Chest","Super Safe Resources Chest"])];
 }
 return [target];
}
function stableRecordKey(row){
 return [row.source,row.title,row.context?.subEvent,row.context?.detail,row.context?.level,row.context?.activity].map(normalise).join("|");
}
async function fetchSearch(term,signal) {
 const groups=[];let truncated=false;
 for(let page=0;page<20;page++){
  const args=new URLSearchParams({q:term,type:"all",drop:"Guaranteed",page:String(page),sort:"suggested"});
  const response=await fetch(SHEET+"/v3/search?"+args,{signal});
  if(!response.ok)throw Error("Reward search service returned "+response.status);
  const data=await response.json();
  if(!Array.isArray(data.groups))throw Error("Invalid reward search response");
  groups.push(...data.groups.filter(x=>x.source!=="boxes"));
  if(!data.hasMore)break;
  if(page===19)truncated=true;
 }
 return {groups,truncated};
}
async function calendarWindow(today,span,signal){
 const params=new URLSearchParams({from:today,to:dayAdd(today,span-1),kind:"all",includeAlways:"true"});
 let response;
 try{response=await fetch(CALENDAR+"?"+params,{signal})}
 catch(e){if(e.name==="AbortError")throw e;throw Error("Calendar connection failed. Check that the Calendar Worker is deployed and allows this site.")}
 if(!response.ok)throw Error("Calendar returned HTTP "+response.status);
 const data=await response.json();
 if(!Array.isArray(data.events))throw Error("Calendar response has no schedules");
 return data;
}
async function fetchCalendar(today,desiredDays,signal){
 // Current-day LIVE availability must succeed. A large future forecast should
 // never prevent a player from seeing today's confirmed recommendations.
 const current=await calendarWindow(today,1,signal);
 if(current.truncated)throw Error("Calendar has too many LIVE entries even for one day");
 if(desiredDays<=1)return {...current,daysChecked:1,forecastLimited:false};
 const spans=[Math.min(desiredDays,14),Math.min(desiredDays,7),Math.min(desiredDays,3)];
 for(const span of [...new Set(spans)].filter(n=>n>1)){
  try{
   const future=await calendarWindow(today,span,signal);
   if(!future.truncated)return {...future,daysChecked:span,forecastLimited:span<desiredDays};
  }catch(e){if(e.name==="AbortError")throw e}
 }
 return {...current,daysChecked:1,forecastLimited:true};
}
async function fetchAllRewards(target,signal){
 const requested=terms(target),searches=[],failures=[];
 // Limit simultaneous Worker requests to avoid overloading a busy search endpoint.
 for(let i=0;i<requested.length;i+=2){
  const batch=await Promise.allSettled(requested.slice(i,i+2).map(q=>fetchSearch(q,signal)));
  for(let j=0;j<batch.length;j++){
   const x=batch[j];
   if(x.status==="fulfilled")searches.push(x.value);
   else if(x.reason?.name==="AbortError")throw x.reason;
   else failures.push(requested[i+j]+": "+(x.reason?.message||"connection failed"));
  }
 }
 if(!searches.length)throw Error("Reward search connection failed for all guaranteed item queries. Check the Sheet Sync Worker.");
 return {searches,failures};
}
function mergeGroups(groups) {
 const unique=new Map();
 for(const row of groups){
  const key=stableRecordKey(row);
  let target=unique.get(key);
  if(!target){target={...row,items:[]};unique.set(key,target)}
  const seen=new Set(target.items.map(x=>JSON.stringify([x.item,x.quantity,x.classification,x.route])));
  for(const item of row.items||[]){
   const signature=JSON.stringify([item.item,item.quantity,item.classification,item.route]);
   if(!seen.has(signature)){target.items.push(item);seen.add(signature)}
  }
 }
 return [...unique.values()];
}
function show(rows,target,stamina,days,wasTruncated,index,today,windowDays,diagnostics){
 const forecast=yieldForecast(rows,index,{stamina,days,today});
 if(!forecast)throw Error("Enter a valid total stamina budget and a positive number of days.");
 const event=forecast.eventLines[0]||null,monster=forecast.bestMonster;
 const missing=$("no-results-explanation");
 missing.hidden=rows.length>0;
 if(!rows.length)missing.textContent="No confirmed LIVE sources have a quantified directly guaranteed "+target+" reward today. The Calendar returned "+diagnostics.confirmed+" confirmed entries today and the reward search returned "+diagnostics.groups+" guaranteed reward groups before LIVE matching. Potential drops and nested chest contents remain excluded.";
 $("recommend-title").textContent="Up to "+fmt(forecast.scenarioTotal)+" "+target+" in "+forecast.days+" days";
 $("recommend-intro").textContent="Estimated "+fmt(forecast.monsterTotal)+" from monster farming with your total stamina, plus up to "+fmt(forecast.eventsPotential)+" from qualifying LIVE event opportunities. Event earnings are conditional, not guaranteed automatically.";
 const summary=$("summary");summary.replaceChildren();
 for(const [name,value] of [["Monster farming",fmt(forecast.monsterTotal)],["Event opportunities",fmt(forecast.eventsPotential)],["Total potential",fmt(forecast.scenarioTotal)]]){
  const box=document.createElement("div"),label=document.createElement("span"),strong=document.createElement("strong");
  box.className="stat";label.className="muted";label.textContent=name;strong.textContent=value;box.append(label,strong);summary.append(box);
 }
 $("combined-estimate").textContent="Total stamina: "+fmt(forecast.budget)+" across "+forecast.days+" days ("+fmt(forecast.spent)+" allocated, "+fmt(forecast.staminaLeft)+" unallocated). Forecast period: "+forecast.today+" to "+forecast.end+" (UTC). No monster hunt speed or daily stamina regeneration is assumed.";
 $("event-name").textContent=event?event.name:"No qualifying LIVE event";
 $("event-reward").textContent=event?fmt(event.potential)+" "+target+" opportunity":"No quantified event opportunities";
 $("event-explanation").textContent=event?fmt(event.perCompletion)+" per qualifying completion, across "+event.opportunities+" confirmed Calendar date(s).":"No matching event with a recorded direct guaranteed reward is confirmed for today.";
 $("event-estimate").textContent=event?"Confirmed qualifying dates: "+event.dates.join(", ")+". The estimate assumes the stated milestone can be completed once on each date.":"No event amount has been assumed.";
 $("monster-name").textContent=monster?monster.name:"No eligible LIVE monster";
 $("monster-reward").textContent=monster?fmt(forecast.monsterTotal)+" "+target+" from "+fmt(forecast.hunts)+" hunts":"No quantified monster yield";
 $("monster-explanation").textContent=monster?fmt(monster.guaranteed)+" per hunt at "+fmt(monster.stamina)+" stamina. Selected for highest recorded guaranteed yield per stamina.":"No confirmed LIVE monster has a matching direct guaranteed reward and known stamina cost.";
 $("monster-estimate").textContent=monster?fmt(forecast.spent)+" stamina spent out of "+fmt(forecast.budget)+" total. All hunts must fit within your "+forecast.days+" days.":"Your stamina is not converted to rewards without an eligible monster.";
 const other=$("other-results");other.replaceChildren();
 for(const x of forecast.eventLines.slice(1,5))line(other,"Event · "+x.name,x.potential,x.opportunities+" confirmed dates; conditional completion");
 for(const x of rows.filter(x=>x.source!=="events"&&x.stamina>0&&x.guaranteed>0&&x.id!==monster?.id).sort((a,b)=>b.guaranteed/b.stamina-a.guaranteed/a.stamina).slice(0,4))
   line(other,"Monster · "+x.name,x.guaranteed,fmt(x.stamina)+" stamina per hunt");
 if(!other.children.length){const p=document.createElement("p");p.className="muted";p.textContent="No other matching guaranteed LIVE sources today.";other.append(p);}
 $("caveat").textContent=forecast.note+(windowDays<forecast.days?" The Calendar could verify only "+windowDays+" of the requested "+forecast.days+" days, so the event projection is incomplete.":"")+(wasTruncated?" Some reward searches were incomplete, and the estimated quantity may omit sources.":"")+" Resource chest conversion credits only the selected resource share; safe resources count toward the corresponding standard resource.";
 $("result").hidden=false;
}
let abort=null;
$("form").addEventListener("submit",async event=>{
 event.preventDefault();if(abort)abort.abort();abort=new AbortController();
 const target=$("item").value.trim(),stamina=$("stamina").value.trim(),days=$("days").value.trim();
 if(!target||parseAmount(stamina)===null||parseAmount(days)===null||parseAmount(days)<1||parseAmount(days)>60||!Number.isInteger(parseAmount(days))){stateMsg("Enter an item, valid total stamina and 1–60 whole days.",true);return}
 $("result").hidden=true;
 $("calculate").disabled=true;stateMsg("Loading LIVE availability and item rewards…");
 try{
  const today=dayUTC(),horizon=Math.min(60,Math.max(1,parseAmount(days)||60));
  const [calendar,rewards]=await Promise.all([
   fetchCalendar(today,horizon,abort.signal),
   fetchAllRewards(target,abort.signal)
  ]);
  const searches=rewards.searches;
  const index=liveIndex(calendar.events,today);
  const allGroups=mergeGroups(searches.flatMap(x=>x.groups));
  const rows=allGroups.map(row=>eligibleRecord(row,target,index,today)).filter(Boolean);
  show(rows,target,stamina,days,searches.some(x=>x.truncated)||rewards.failures.length>0,index,today,calendar.daysChecked,{confirmed:calendar.events.filter(x=>x.date===today&&x.status==="Confirmed").length,groups:allGroups.length});
  stateMsg(rows.length?"Showing "+rows.length+" confirmed LIVE matching sources for "+today+" (UTC); "+calendar.daysChecked+" Calendar day(s) checked.":"No quantified guaranteed matching LIVE rewards found today. See the explanation below."+(calendar.forecastLimited?" Future forecast is limited by Calendar response size or availability.":"")+(rewards.failures.length?" Some reward queries could not load; recommendations may be incomplete.":""));
 }catch(e){if(e.name!=="AbortError")stateMsg("Unable to produce a LIVE plan: "+e.message+". No fallback to unverified availability was used.",true)}
 finally{$("calculate").disabled=false}
});
// Start a clean one-time search even when the browser restores this page from cache.
window.addEventListener("pageshow",()=>{
 if(abort)abort.abort();
 $("form").reset();
 $("item").value="";
 $("stamina").value="";
 $("days").value="";
 $("suggestions").replaceChildren();
 $("result").hidden=true;
 $("calculate").disabled=false;
 stateMsg("Choose an item to start a new one-time LIVE search.");
});
let timer;
$("item").addEventListener("input",()=>{
 clearTimeout(timer);const query=$("item").value.trim();if(query.length<2)return;
 timer=setTimeout(async()=>{try{const r=await fetch(SHEET+"/v2/suggest?"+new URLSearchParams({q:query}));if(!r.ok)return;const data=await r.json(),list=$("suggestions");list.replaceChildren();for(const name of data.items||[]){const option=document.createElement("option");option.value=name;list.append(option)}}catch{}},240);
});
</script></body></html>
