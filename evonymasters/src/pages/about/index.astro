---
import SeoMetadata from '../../components/SeoMetadata.astro';
import SiteHeader from '../../components/SiteHeader.astro';
const tools=[
 {href:'/resources/',image:'/images/item-finder/ymir.svg',eyebrow:'Find your loot',title:'Need an item?',text:'Search rewards and discover which monsters, events and sources can help you find it.',cta:'Explore Item Finder'},
 {href:'/chests/',image:'/images/item-finder/box.svg',eyebrow:'Open the possibilities',title:'Wondering what’s inside?',text:'Explore recorded chest contents and compare possible rewards before choosing your next target.',cta:'Open Chest Finder'},
 {href:'/calendar/',image:'/images/item-finder/feasting-revelry.svg',eyebrow:'Stay a step ahead',title:'What’s happening next?',text:'Browse recorded event and monster schedules, and plan your next hunt.',cta:'Check the Calendar'},
 {href:'/loot-compass/',image:'/images/item-finder/box.svg',eyebrow:'Make stamina count',title:'Where should you farm?',text:'Compare recorded event rewards and monster opportunities with your stamina budget.',cta:'Try Loot Compass'},
 {href:'/troops/',image:'/images/banners/march-preset.webp',eyebrow:'Build the march',title:'Getting your layers right?',text:'Plan troop layers for different formations before taking them into battle.',cta:'Plan a March'},
 {href:'/training/',image:'/images/banners/troop-training.webp',eyebrow:'Train with a plan',title:'How much will it cost?',text:'Estimate troop training resources, Gold and Power from T1 through T16.',cta:'Calculate Training'}
];
---
<!doctype html><html lang="en"><head>
<SeoMetadata title="About EvonyMasters | Find Your Next Move in Evony" description="EvonyMasters is a player-built toolkit for finding monster rewards, exploring chests, tracking events and planning troops. Find what you need, faster."/>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="EvonyMasters is a player-built toolkit for finding monster rewards, exploring chests, tracking events and planning troops. Find what you need, faster."/>
<link rel="icon" href="/favicon.svg"/><title>About EvonyMasters | Find Your Next Move in Evony</title>
<style is:global>
:root{font:16px Inter,system-ui,sans-serif;color:#eef3f9;background:#091624}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% 10%,#183149 0,transparent 40%),#091624}a{color:#f2ce8e}
.wrap{max-width:1180px;margin:auto;padding:0 24px}.eyebrow{color:#f2c778;letter-spacing:.14em;text-transform:uppercase;font-size:.75rem;font-weight:850}
.about-hero{min-height:390px;display:flex;align-items:center;padding:64px 0 74px;background:linear-gradient(90deg,rgba(4,14,26,.96) 0%,rgba(5,17,31,.85) 48%,rgba(5,17,31,.22) 100%),url('/images/banners/home.webp') center/cover no-repeat;border-bottom:1px solid #9d7645}
.about-hero .wrap{width:100%}.about-hero h1{font:700 clamp(2.5rem,5.6vw,4.5rem)/1.1 Georgia,serif;color:#ffdf9c;max-width:790px;margin:14px 0 18px}.about-hero p{max-width:650px;font-size:1.13rem;line-height:1.7;color:#e6eef7;margin:0 0 25px}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:10px;padding:13px 18px;text-decoration:none;font-weight:850;background:#ecc57d;color:#17283b;border:1px solid #ecc57d}.btn.secondary{background:#17344f;color:#f7d89e;border-color:#9b7e52}
.content{padding-top:58px;padding-bottom:74px}.intro{text-align:center;max-width:740px;margin:0 auto 29px}.intro h2{font:700 clamp(1.9rem,4vw,2.7rem)/1.18 Georgia,serif;color:#ffdf9c;margin:12px 0}.intro p{color:#ccdaea;line-height:1.75;margin:0}
.tool-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tool-card{min-width:0;overflow:hidden;background:#132b43;border:1px solid #3b5870;border-radius:16px;display:flex;flex-direction:column;text-decoration:none;transition:transform .15s,border-color .15s}.tool-card:hover,.tool-card:focus-visible{transform:translateY(-3px);border-color:#d0a767}.tool-card img{width:100%;height:160px;object-fit:cover;background:#203b55}.tool-body{padding:21px 21px 23px;display:flex;flex-direction:column;flex:1}.tool-body .eyebrow{font-size:.67rem}.tool-body h3{font-size:1.28rem;color:#ffe0a6;margin:10px 0 8px}.tool-body p{line-height:1.65;color:#c8d8e6;margin:0 0 18px}.tool-body .card-link{margin-top:auto;color:#f5cb82;font-weight:850}
.story{margin:58px 0 0;padding:33px;background:#142940;border:1px solid #3b5870;border-radius:18px;display:grid;grid-template-columns:1.2fr .8fr;gap:38px;align-items:center}.story h2,.fine-print h2{color:#f7d394;font:700 1.65rem Georgia,serif;margin:9px 0 12px}.story p,.fine-print p{color:#cfdeeb;line-height:1.75}.story img{width:100%;max-height:240px;object-fit:contain}.fine-print{margin:46px 0 0;padding:0 2px}.fine-print p{max-width:930px}.closing{margin-top:40px;padding:24px 28px;border:1px solid #97764a;border-radius:14px;background:linear-gradient(100deg,#203b52,#14283f);display:flex;justify-content:space-between;align-items:center;gap:20px}.closing h2{font:700 1.5rem Georgia,serif;color:#ffe0a0;margin:0 0 6px}.closing p{color:#d1dfea;margin:0}
footer{margin-top:45px;border-top:1px solid #375168;padding-top:22px;color:#b8cadb;font-size:.88rem}
@media(max-width:900px){.tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.story{grid-template-columns:1fr}.story img{max-width:320px;justify-self:center}}
@media(max-width:600px){.wrap{padding:0 18px}.about-hero{min-height:330px;padding:49px 0 54px}.tool-grid{grid-template-columns:1fr}.tool-card img{height:180px}.story{padding:22px}.closing{flex-direction:column;align-items:flex-start}}
</style></head><body><SiteHeader active="about"/>
<main>
<section class="about-hero"><div class="wrap"><div class="eyebrow">Your Evony toolkit · Built for players</div><h1>Need something in Evony? You’re in the right place.</h1><p>Chasing a reward? Planning your next march? Trying to work out which chest is worth hunting? Welcome to EvonyMasters, where the answer is easier to find and your next move starts with a plan.</p><div class="hero-actions"><a class="btn" href="#find-your-tool">Find your tool ↓</a><a class="btn secondary" href="/resources/">Start with Item Finder</a></div></div></section>
<div class="wrap content">
<section id="find-your-tool" aria-labelledby="tool-heading"><div class="intro"><div class="eyebrow">Choose your quest</div><h2 id="tool-heading">What are you looking for today?</h2><p>No giant spreadsheet hunt required. Pick the problem you're solving, and we'll point you to the right EvonyMasters tool.</p></div>
<div class="tool-grid">{tools.map(tool=><a class="tool-card" href={tool.href}><img src={tool.image} alt="" loading="lazy"/><div class="tool-body"><div class="eyebrow">{tool.eyebrow}</div><h3>{tool.title}</h3><p>{tool.text}</p><span class="card-link">{tool.cta} →</span></div></a>)}</div></section>
<section class="story"><div><div class="eyebrow">Why we built it</div><h2>Less searching. More playing.</h2><p>Evony has no shortage of things to chase: monsters, materials, events, chests and troop goals. EvonyMasters brings recorded rewards and planning tools together so you can get to the useful part faster.</p><p>We're building a place you can return to whenever you need an answer, not just a static list of facts. Whether you're new to Evony or planning your next big push, there's a tool here for the job.</p></div><img src="/images/item-finder/ymir.svg" alt="Illustration of an Evony monster" loading="lazy"/></section>
<section class="fine-print"><h2>Good plans start with good information</h2><p>We use recorded reward information and published event schedules. Some rewards are conditional, some drops are only possible, and unknown or incomplete data should never be treated as a guarantee. Game rules and availability can change, so always double-check important decisions in-game.</p><h2>A player-made project</h2><p>EvonyMasters is an independent, unofficial fan site. It is not affiliated with, sponsored, approved or endorsed by Evony: The King's Return or its publisher. Game names and trademarks belong to their respective owners.</p></section>
<section class="closing"><div><h2>Found a missing reward? Have a brilliant idea?</h2><p>Help make this place more useful for the next player who comes looking.</p></div><a class="btn" href="/contact/">Send feedback →</a></section>
<footer><a href="/">Home</a> · <a href="/privacy/">Privacy</a> · <a href="/contact/">Feedback</a></footer>
</div>
</main></body></html>