---
import SiteHeader from '../../components/SiteHeader.astro';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content="Discover Evony rewards by item, monster, event and chest. Compare guaranteed and possible rewards without an endless list." />
<link rel="icon" href="/favicon.svg" />
<title>Item Finder | EvonyMasters</title>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0c1726;color:#edf2f8}*{box-sizing:border-box}
body{margin:0}a{color:inherit}.wrap{max-width:1140px;margin:0 auto;padding:0 22px}
.hero{background:linear-gradient(155deg,#14263b,#0f233b 72%);border-bottom:1px solid #37516e;padding:50px 0 34px}
.label-line{font-size:.82rem;color:#efc476;letter-spacing:.15em;font-weight:850;text-transform:uppercase}
h1{font-size:clamp(2.25rem,5vw,3.7rem);margin:12px 0 10px;letter-spacing:-.04em}
.intro{color:#bdcee1;max-width:690px;line-height:1.6}
.search-box{background:#fff;border:2px solid transparent;display:flex;align-items:center;gap:10px;border-radius:15px;padding:5px 15px;max-width:920px;margin-top:27px;color:#334155}
.search-box:focus-within{border-color:#f2c876}.search-box svg{width:22px;height:22px;flex:none}
.search-box input{border:0;outline:0;flex:1;min-height:56px;font-size:1.16rem;background:transparent;color:#17263b;min-width:0}
.search-box input::placeholder{color:#6e7d90}
.notice{font-size:.87rem;line-height:1.6;color:#bfd1e1;margin:12px 0 0}
.workspace{padding:24px 0 65px}.filter-panel{background:#152b42;border:1px solid #35516d;border-radius:16px;padding:22px}
.filter-panel h2{margin:0 0 12px;font-size:1rem;color:#f0d18e}
.filter-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.filter{font:inherit;border:1px solid #5b748d;border-radius:999px;padding:9px 15px;background:#102238;color:#d5e2f0;cursor:pointer;font-size:.92rem}
.filter:hover{background:#25425c}.filter[aria-pressed="true"]{background:#f3c974;color:#1a2735;border-color:#f3c974;font-weight:850}
.field{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
.field label{color:#d5e2ef;font-size:.87rem;font-weight:800}
.field select{background:#102238;color:white;border:1px solid #59748d;border-radius:8px;padding:10px 13px;font:inherit}
.field small{color:#b6cce1}.results-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin:25px 0 16px}
.results-header h2{font-size:1.35rem;margin:0}.results-header p{color:#b9cbdc;font-size:.85rem;margin:4px 0 0}
.group-list{display:grid;gap:12px}.group-card{border-radius:14px;border:1px solid #3d5874;background:#152c44;overflow:hidden}
.group-card summary{list-style:none;display:flex;align-items:center;gap:14px;padding:17px 20px;cursor:pointer}
.group-card summary::-webkit-details-marker{display:none}.group-card summary:focus-visible{outline:3px solid #f3c974;outline-offset:-3px}
.group-card[open] summary{border-bottom:1px solid #35536e}.source-icon{width:45px;height:45px;display:grid;place-items:center;border-radius:11px;background:#233f59;font-size:1.35rem;flex:none}
.source-info{flex:1;min-width:0}.source-info strong{font-size:1.05rem;color:#fff}.source-info small{display:block;color:#b9cddf;margin-top:5px;line-height:1.4}
.group-count{font-size:.8rem;color:#f1cf85;background:#2c4054;border-radius:99px;padding:7px 9px;white-space:nowrap}
.chevron{color:#a7bed3}.group-card[open] .chevron{transform:rotate(180deg)}
.reward-list{padding:12px 18px 20px}.reward-row{border-bottom:1px solid #314d69;padding:11px 3px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:start}
.reward-row:last-child{border-bottom:0}.reward-name{font-weight:740}.reward-path{font-size:.79rem;line-height:1.55;color:#adbed0;margin-top:5px;overflow-wrap:anywhere}
.reward-meta{text-align:right}.amount{color:#f5cf84;font-weight:850}.drop{display:block;font-size:.76rem;margin-top:5px;color:#e4d5b3}
.drop.guaranteed{color:#a2e6af}.drop.possible{color:#f4cd80}
.summary-note{font-size:.8rem;color:#abc2d7;margin-top:12px;line-height:1.5}
.empty{padding:40px 22px;border:1px dashed #4f718d;border-radius:14px;color:#c9d9e7;text-align:center;line-height:1.6}
#load-more{display:block;margin:22px auto 0;border:1px solid #bd974d;background:#f1c675;border-radius:8px;padding:12px 26px;color:#14253c;cursor:pointer;font-weight:850}
[hidden]{display:none!important}
footer{border-top:1px solid #29425d;padding:24px 0;color:#afc3d4;font-size:.83rem;line-height:1.55}
@media(max-width:570px){.hero{padding-top:34px}.filter-panel{padding:16px}.group-card summary{padding:14px}.group-count{font-size:.7rem}.source-icon{width:36px;height:36px}.reward-list{padding:10px 13px 15px}.search-box input{font-size:1rem}}
</style>
</head>
<body>
<SiteHeader active="resources" />
<main>
<section class="hero"><div class="wrap">
<div class="label-line">Player tools / Item Finder</div>
<h1>Find your free rewards</h1>
<p class="intro">Find which bosses, events, tasks and boxes offer the item you need. Results are grouped by source, so you can compare opportunities without scrolling through hundreds of repeated rewards.</p>
<div class="search-box">
<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="10.8" cy="10.8" r="7"/><path d="m16 16 5 5"/></svg>
<label for="query" style="position:absolute;clip:rect(0,0,0,0);width:1px;height:1px">Search for a reward or source</label>
<input id="query" type="search" placeholder="Try Refining Stone, Gems, Ymir…" list="item-suggestions" autocomplete="off" />
<datalist id="item-suggestions"></datalist>
</div>
<p class="notice">Rewards depend on in-game conditions. “Possible” means a chance of receiving an item, not a guaranteed quantity. Events are not assumed to be active unless verified.</p>
</div></section>
<section class="workspace wrap">
<div class="filter-panel">
<h2>Where can I get it?</h2>
<div id="type-filters" class="filter-row" aria-label="Reward source">
<button class="filter" type="button" aria-pressed="true" data-type="all">All sources</button>
<button class="filter" type="button" aria-pressed="false" data-type="events">Events & tasks</button>
<button class="filter" type="button" aria-pressed="false" data-type="bosses">Bosses</button>
<button class="filter" type="button" aria-pressed="false" data-type="event-bosses">Event bosses</button>
<button class="filter" type="button" aria-pressed="false" data-type="regular">Regular monsters</button>
<button class="filter" type="button" aria-pressed="false" data-type="boxes">Boxes</button>
</div>
<div class="field">
<label for="drop-filter">Reward chance</label>
<select id="drop-filter"><option value="all">All rewards</option><option value="Guaranteed">Guaranteed only</option><option value="Possible">Possible drops only</option><option value="Unspecified">Not classified</option></select>
<small>Unknown rewards are never counted as guaranteed.</small>
</div>
</div>
<div class="results-header">
<div><h2 id="heading">Search for an item to get started</h2><p id="description">Results are grouped by monster, event/activity or reward box.</p></div>
<p id="sync-status" aria-live="polite"></p>
</div>
<div id="feedback" class="empty">Type at least two characters to find reward sources. Your private spreadsheet is not exposed to visitors.</div>
<div id="results" class="group-list" aria-live="polite"></div>
<button id="load-more" type="button" hidden>Show more sources</button>
</section></main>
<footer><div class="wrap">EvonyMasters is an independent fan project. Data is maintained in a private spreadsheet and may change with game updates. Free-to-play eligibility and current availability are not yet verified for every source.</div></footer>
<script>
const API='https://evonymasters-sheet-sync.jaynmegepicadventure.workers.dev';
const query=document.querySelector('#query');
const filters=document.querySelector('#type-filters');
const drop=document.querySelector('#drop-filter');
const results=document.querySelector('#results');
const heading=document.querySelector('#heading');
const desc=document.querySelector('#description');
const feedback=document.querySelector('#feedback');
const more=document.querySelector('#load-more');
const syncStatus=document.querySelector('#sync-status');
const datalist=document.querySelector('#item-suggestions');
const labels={'events':'Event / activity',bosses:'Boss monster','event-bosses':'Event boss',regular:'Regular monster',boxes:'Reward box'};
const emojis={'events':'📅',bosses:'⚔️','event-bosses':'🐉',regular:'🧭',boxes:'📦'};
let type='all',page=0,serial=0,loadTimer,abort,hasMore=false,allCount=0;
const el=(tag,cls,text)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(text!=null)n.textContent=String(text);return n;};
const safe = value=>String(value??'').trim();
function groupCard(group){
  const details=el('details','group-card');
  const summary=el('summary');
  const glyph=el('span','source-icon',emojis[group.source]||'🎁');
  glyph.setAttribute('aria-hidden','true');
  const info=el('div','source-info');
  info.append(el('strong','',group.title));
  const context=group.context||{};
  const parts=[labels[group.source]||group.source];
  if(context.level)parts.push('Lv '+context.level);
  if(context.subEvent)parts.push(context.subEvent);
  if(context.detail)parts.push(context.detail);
  if(context.frequency)parts.push(context.frequency);
  if(context.stamina)parts.push(context.stamina+' stamina');
  info.append(el('small','',parts.join(' · ')));
  summary.append(glyph,info,el('span','group-count',group.matchingRewards+' matching '+(group.matchingRewards===1?'reward':'rewards')),el('span','chevron','⌄'));
  details.append(summary);
  const body=el('div','reward-list');
  for(const reward of group.items||[]){
    const line=el('div','reward-row');
    const left=el('div');
    left.append(el('div','reward-name',reward.item));
    if(reward.route?.length>1)left.append(el('div','reward-path','Via: '+reward.route.join(' → ')));
    const right=el('div','reward-meta');
    right.append(el('div','amount',reward.quantity||'Variable'));
    const kind=safe(reward.classification)||'Unspecified';
    right.append(el('span','drop '+kind.toLowerCase(),kind));
    line.append(left,right);body.append(line);
  }
  if(group.matchingRewards>(group.items||[]).length)body.append(el('p','summary-note','More matching entries exist for this source. Refine the item search to narrow the details.'));
  if(group.source==='events')body.append(el('p','summary-note','Availability and F2P eligibility are not yet verified. Check the event requirements in-game.'));
  if(group.source==='boxes')body.append(el('p','summary-note','This box may be obtainable from multiple sources. A match inside the box does not guarantee you will obtain the box.'));
  details.append(body);
  return details;
}
async function load({append=false}={}){
  const term=query.value.trim();
  if(!append){page=0;allCount=0;results.replaceChildren();more.hidden=true;}
  if(term.length<2){feedback.hidden=false;feedback.textContent='Type at least two characters to find reward sources.';heading.textContent='Search for an item to get started';desc.textContent='Results are grouped by monster, event/activity or reward box.';syncStatus.textContent='';return;}
  if(abort)abort.abort();
  abort=new AbortController();const current=++serial;
  feedback.hidden=false;feedback.textContent='Searching rewards…';
  heading.textContent='Results for “'+term+'”';
  const params=new URLSearchParams({q:term,type,drop:drop.value,page:String(page)});
  try{
    const response=await fetch(API+'/v2/search?'+params,{signal:abort.signal});
    if(!response.ok)throw Error('Search service returned '+response.status);
    const data=await response.json();
    if(current!==serial)return;
    if(!Array.isArray(data.groups))throw Error('Unexpected search response');
    for(const group of data.groups)results.append(groupCard(group));
    hasMore=Boolean(data.hasMore);allCount=data.total;
    more.hidden=!hasMore;
    desc.textContent=data.total+' matching '+(data.total===1?'source':'sources')+' · '+results.childElementCount+' shown. Expand a source to see its rewards.';
    syncStatus.textContent=data.updatedAt?'Data synced: '+new Date(data.updatedAt).toLocaleString():'';
    if(!data.groups.length&&!append){feedback.hidden=false;feedback.textContent='No matching sources. Try a different item name or change the filters.';}
    else feedback.hidden=true;
  }catch(error){
    if(error.name==='AbortError')return;
    if(append){feedback.hidden=false;feedback.textContent='Could not load more results. Try again.';}
    else{feedback.hidden=false;feedback.textContent='Live rewards are temporarily unavailable. Please try again shortly.';desc.textContent='The private spreadsheet has not been exposed.';}
  }
}
function schedule(){
 clearTimeout(loadTimer);if(abort)abort.abort();
 loadTimer=setTimeout(()=>load(),280);
}
filters.addEventListener('click',event=>{
 const target=event.target.closest('button[data-type]');
 if(!target)return;
 type=target.dataset.type;
 for(const button of filters.querySelectorAll('button'))button.setAttribute('aria-pressed',String(button===target));
 schedule();
});
drop.addEventListener('change',schedule);
query.addEventListener('input',()=>{
 schedule();
 clearTimeout(window._suggestDebounce);
 const term=query.value.trim();
 if(term.length<2){datalist.replaceChildren();return;}
 window._suggestDebounce=setTimeout(async()=>{
  try{
   const response=await fetch(API+'/v2/suggest?q='+encodeURIComponent(term));
   if(!response.ok)return;
   const data=await response.json();
   if(query.value.trim()!==term)return;
   datalist.replaceChildren(...(data.items||[]).map(v=>{const opt=document.createElement('option');opt.value=v;return opt;}));
  }catch{}
 },350);
});
more.addEventListener('click',()=>{if(hasMore){page++;load({append:true});}});
const initial=new URLSearchParams(location.search).get('q');
if(initial){query.value=initial;schedule();}
</script>
</body></html>
