---
import SiteHeader from '../../components/SiteHeader.astro';
import monsters from '../../data/monsters.json';
import items from '../../data/items.json';
import events from '../../data/events.json';
const types = [{value:'Regular',label:'Regular'},{value:'Boss',label:'Boss'},{value:'Event',label:'Event Boss'},{value:'Event Activity',label:'Event'}];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Find Evony monsters by reward, stamina and power. Guaranteed and possible drops are shown separately."/><link rel="icon" href="/favicon.svg"/><title>Find your resource | evonymasters</title>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#eaf0f8;background:#0c1726}*{box-sizing:border-box}body{margin:0}a{color:inherit}.wrap{max-width:1150px;margin:auto;padding:0 22px}header{border-bottom:1px solid #30445c;background:#11243a}.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:12px}.brand{font-size:1.45rem;font-weight:850;letter-spacing:-.04em;text-decoration:none}.brand span{color:#e6bc73}.nav small{color:#a9bcd0}.hero{padding:60px 0 40px;background:radial-gradient(circle at 80% 10%,#234667 0,transparent 55%)}.eyebrow{color:#e6bc73;text-transform:uppercase;letter-spacing:.17em;font-size:.76rem;font-weight:800}h1{font-size:clamp(2.3rem,5vw,4rem);line-height:1.07;margin:12px 0 16px;letter-spacing:-.045em}.intro{max-width:680px;color:#bbccdd;line-height:1.65;font-size:1.06rem}.panel{background:#152b43;border:1px solid #35516d;border-radius:18px;padding:24px;margin:26px 0 16px;box-shadow:0 15px 40px #0002}.filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px}label{font-size:.83rem;font-weight:700;color:#cfdeec;display:block;margin-bottom:8px}input,select{width:100%;border:1px solid #55708b;background:#0b1d30;color:#fff;padding:13px;border-radius:9px;font:inherit;min-height:48px}input:focus,select:focus{outline:2px solid #e6bc73;outline-offset:2px}input::placeholder{color:#a5b8cb}.note{font-size:.87rem;color:#b6c8d9;line-height:1.6}.results-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:28px 0 18px}h2{font-size:1.4rem;margin:0}.grid{margin-bottom:60px;overflow-x:auto;border:1px solid #35516d;border-radius:18px;background:linear-gradient(180deg,#172f49,#10243a);box-shadow:0 15px 40px #0003}.results-table{width:100%;border-collapse:separate;border-spacing:0;min-width:760px}.results-table th,.results-table td{padding:15px 18px;text-align:left;vertical-align:middle}.results-table th{position:sticky;top:0;z-index:1;background:#10243a;color:#e6bc73;font-size:.75rem;text-transform:uppercase;letter-spacing:.09em;border-bottom:1px solid #46627d;white-space:nowrap}.results-table td{font-size:.91rem;color:#eaf0f8;border-bottom:1px solid #2d465f}.results-table tbody tr{transition:background .15s ease,transform .15s ease}.results-table tbody tr:hover{background:#203b55}.results-table tbody tr:last-child td{border-bottom:0}.results-table a{font-weight:800;color:#fff;text-decoration:none}.results-table a:hover{color:#e6bc73}.results-table td:first-child{font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:#a9c3d9}.results-table .qty{font-weight:850;color:#f2ce88}.results-table .qty,.results-table .cost{white-space:nowrap}.results-table .cost{color:#b9ccdc}.results-table td:nth-child(3){font-weight:750;color:#a9bed1}@media(max-width:700px){.grid{border-radius:14px}.results-table th,.results-table td{padding:12px 14px}}.card{background:#14283f;border:2px solid #fff;border-radius:18px;overflow:hidden;box-shadow:0 5px 18px #0004}.card-top{display:flex;gap:14px;padding:18px;border-bottom:1px solid #30475d}.monster-img{width:80px;height:80px;border-radius:12px;object-fit:cover;background:#213d57;display:grid;place-items:center;font-size:2rem;flex-shrink:0}.card h3{margin:0 0 7px;font-size:1.2rem}.meta{color:#a9bed1;font-size:.85rem}.stats{display:flex;flex-wrap:wrap;gap:8px;margin-top:11px}.pill{font-size:.78rem;border:1px solid #58708a;border-radius:999px;padding:5px 9px}.card-body{padding:16px 18px}.reward-title{font-size:.79rem;text-transform:uppercase;letter-spacing:.07em;font-weight:800;margin:0 0 9px}.guaranteed{color:#9ce0ae}.possible{color:#f2ce88}.reward-list{display:flex;flex-direction:column;align-items:stretch;gap:7px;margin-bottom:18px}.reward{display:block;border:1px solid #466079;background:#203a52;border-radius:8px;padding:9px 11px;font-size:.86rem;line-height:1.5}.empty{border:1px dashed #56708b;border-radius:15px;padding:40px 24px;text-align:center;color:#c5d5e4;margin-bottom:60px}.empty strong{display:block;color:white;font-size:1.15rem;margin-bottom:8px}footer{border-top:1px solid #30445c;padding:24px 0;color:#a9bdcf;font-size:.82rem}datalist{color:#fff}@media(max-width:820px){.filters{grid-template-columns:1fr 1fr}}@media(max-width:530px){.filters{grid-template-columns:1fr}.hero{padding-top:35px}.nav small{display:none}.panel{padding:17px}}
</style></head><body>
<SiteHeader active="resources" />
<main><section class="hero"><div class="wrap"><div class="eyebrow"><a href="/">Player tools</a> / Resource Finder</div><h1>Find the resource you are missing</h1><p class="intro">Search monsters and events by the resource or reward you need. Find where it drops or which event offers it.</p>
<div class="panel"><div class="filters"><div><label for="query">Find your resource</label><input id="query" type="search" placeholder="Search monsters, events, resources or rewards…" list="suggestions" autocomplete="off"/><datalist id="suggestions"></datalist></div><div><label for="type">Type</label><select id="type"><option value="">All types</option>{types.map(type=><option value={type.value}>{type.label}</option>)}</select></div><div><label for="sort">Sort by</label><select id="sort"><option value="amount">Largest amount</option><option value="name">Name A–Z</option><option value="stamina">Lowest stamina</option><option value="power">Lowest power</option></select></div></div><p class="note">Search for the actual items, including recorded boss-chest contents and event rewards. Event rewards may depend on purchases, exchanges, milestones or chance; check the event requirements.</p></div></div></section>
<section class="wrap" aria-live="polite"><div class="results-head"><h2>Resource results</h2><span id="count" class="meta"></span></div><div id="results" class="grid"></div><div id="empty" class="empty" hidden><strong>No matching results</strong><span id="empty-text">Try another resource, reward, monster or event.</span></div></section></main>
<footer><div class="wrap">evonymasters is an independent fan project and is not affiliated with or endorsed by the game publisher. Monster data may change with game updates.</div></footer>
<script id="monster-data" type="application/json" set:html={JSON.stringify({monsters,items,events}).replace(/</g, "\\u003c")} />
<script>
  import { searchMonsters, suggestions } from '../../lib/search.mjs';
  const { monsters, items, events } = JSON.parse(document.querySelector('#monster-data').textContent);
  const byId = new Map(items.map(i => [i.id, i]));
  const query = document.querySelector('#query');
  const type = document.querySelector('#type');
  const sort = document.querySelector('#sort');
  const results = document.querySelector('#results');
  const empty = document.querySelector('#empty');
  const count = document.querySelector('#count');
  const emptyText = document.querySelector('#empty-text');
  const datalist = document.querySelector('#suggestions');
  const eventRewards = e => e.rewards.flatMap(r=>r.split(';').map(x=>x.trim()).filter(Boolean));
  const eventMatches = (e,term) => !term || [e.name,...eventRewards(e)].some(x=>x.toLocaleLowerCase().includes(term));
  const format = n => n == null ? 'Not verified' : new Intl.NumberFormat('en-US').format(n);
  function element(tag, className, value) { const el = document.createElement(tag); if(className) el.className=className; if(value != null) el.textContent=value; return el; }
  const normalize = value => value.toLocaleLowerCase().trim().replace(/s\\b/g,'');
  const rewardMatches = (r, term) => {
    if(!term) return true;
    const label=byId.get(r.itemId)?.name || r.itemId;
    return normalize(label+' '+r.itemId).includes(normalize(term));
  };
  const monsterNameMatches = (monster, term) => normalize(monster.name+' '+(monster.event||'')+' '+(monster.level==null?'':('lv '+monster.level+' level '+monster.level))).includes(normalize(term));
  const matchingMonsterRewards = (monster, term) => monsterNameMatches(monster,term) ? monster.rewards : monster.rewards.filter(r=>rewardMatches(r,term));
  const rewardAmount = r => Number(r.quantity) || 0;
  const textAmount = value => {
    const match=value.replace(/,/g,'').match(/(?:x|×|·)?\\s*(\\d+(?:\\.\\d+)?)\\s*([KMB])?/i);
    if(!match)return 0;
    const mult={K:1e3,M:1e6,B:1e9}[match[2]?.toUpperCase()]||1;
    return Number(match[1])*mult;
  };
  function rewards(container, monster, kind, term) {
    const matches = monster.rewards.filter(r=>r.kind===kind && rewardMatches(r,term));
    if(!matches.length) return;
    const title = element('p', 'reward-title '+(kind==='guaranteed'?'guaranteed':'possible'), kind==='guaranteed'?'Guaranteed reward':'Matching drop');
    container.append(title);
    const list = element('div','reward-list');
    for(const r of matches){const label=byId.get(r.itemId)?.name || r.itemId;const isChest=/^lv\\d+-boss-monster-chest$/.test(r.itemId);const reward=element(isChest?'a':'span','reward',`${label}${r.quantity == null?'':` · ${format(r.quantity)}${r.unit?' '+r.unit:''}`}${r.origin==='boss_chest'?' · from boss chest':r.origin==='other_chest'?' · from special chest':''}${r.notes&&r.notes!=='Included when the boss chest is obtained and opened'?' · '+r.notes:''}`);if(isChest)reward.href='/items/'+r.itemId+'/';list.append(reward);}
    container.append(list);
  }
  function render(){
    const term=query.value.trim().toLocaleLowerCase();
    if(!term){
      results.replaceChildren();
      count.textContent='';
      empty.hidden=true;
      return;
    }
    const monsterType=type.value==='Event Activity'?'__none__':type.value;
    let filtered=type.value==='Event Activity'?[]:searchMonsters(monsters,{query:query.value,item:'',type:monsterType,sort:sort.value==='amount'?'name':sort.value,items});
    let matchingEvents=(type.value===''||type.value==='Event Activity')?events.filter(e=>eventMatches(e,term)):[];
    if(sort.value==='amount'){
      filtered.sort((a,b)=>Math.max(0,...matchingMonsterRewards(b,term).map(rewardAmount))-Math.max(0,...matchingMonsterRewards(a,term).map(rewardAmount)) || a.name.localeCompare(b.name));
      matchingEvents.sort((a,b)=>Math.max(0,...eventRewards(b).filter(x=>normalize(b.name).includes(normalize(term))||normalize(x).includes(normalize(term))).map(textAmount))-Math.max(0,...eventRewards(a).filter(x=>normalize(a.name).includes(normalize(term))||normalize(x).includes(normalize(term))).map(textAmount)) || a.name.localeCompare(b.name));
    }else matchingEvents.sort((a,b)=>a.name.localeCompare(b.name));
    const total=filtered.length+matchingEvents.length;
    results.replaceChildren(); count.textContent=`${total} result${total===1?'':'s'}`;
    empty.hidden=total>0; emptyText.textContent='Try a different keyword, reward or type.';
    const table=element('table','results-table');
    const thead=document.createElement('thead');const headerRow=document.createElement('tr');
    for(const label of ['Type','Details','Live','Resource Type','Quantity','Cost'])headerRow.append(element('th','',label));
    thead.append(headerRow);table.append(thead);
    const tbody=document.createElement('tbody');

    for(const m of filtered){
      const matches=matchingMonsterRewards(m,term);
      for(const r of matches){
        const row=document.createElement('tr');
        row.append(element('td','',m.type==='Event'?'Event Monster':'Monster'));
        const detail=element('td');const displayName=m.level==null?m.name:`${m.name} Lv ${m.level}`;const bossLink=element('a','',displayName);bossLink.href='/bosses/'+m.id+'/';detail.append(bossLink);row.append(detail);
        row.append(element('td','','No'));
        row.append(element('td','',byId.get(r.itemId)?.name || r.itemId));
        row.append(element('td','qty',r.quantity==null?'—':format(r.quantity)+(r.unit?' '+r.unit:'')));
        row.append(element('td','cost',m.stamina==null?'—':format(m.stamina)+' Stamina'));
        tbody.append(row);
      }
    }

    for(const e of matchingEvents){
      const eventNameMatch=normalize(e.name).includes(normalize(term));
      for(const reward of eventRewards(e).filter(x=>eventNameMatch||normalize(x).includes(normalize(term)))){
        const row=document.createElement('tr');
        row.append(element('td','','Event'));
        const detail=element('td');const link=element('a','',e.name);link.href='/events/?q='+encodeURIComponent(query.value.trim()||e.name);detail.append(link);row.append(detail);
        row.append(element('td','','No'));
        const amount=textAmount(reward);
        const resourceName=reward.replace(/(?:x|×|·)?\\s*[\\d,]+(?:\\.\\d+)?\\s*[KMB]?\\b/ig,'').replace(/^[ ·x×:-]+|[ ·x×:-]+$/g,'').trim() || reward;
        row.append(element('td','',resourceName));
        row.append(element('td','qty',amount?format(amount):'—'));
        row.append(element('td','cost','—'));
        tbody.append(row);
      }
    }
    table.append(tbody);results.append(table);
  }
  for(const control of [query,type,sort])control.addEventListener(control===query?'input':'change',render);
  query.addEventListener('input',()=>{datalist.replaceChildren(...[...new Set([...suggestions(monsters,items,query.value),...events.flatMap(e=>[e.name,...eventRewards(e)]).filter(v=>v.toLowerCase().includes(query.value.trim().toLowerCase()))])].slice(0,12).map(value=>{const option=document.createElement('option');option.value=value;return option;}));});
  render();
</script></body></html>
