---
import SiteHeader from '../../components/SiteHeader.astro';
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content="Search Evony rewards and compare quantities, frequencies and ways to obtain them from monsters, events and boxes."/>
<link rel="icon" href="/favicon.svg"/><title>Item Finder | EvonyMasters</title>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0c1726;color:#ecf1f9}
*{box-sizing:border-box}body{margin:0}a{color:inherit}.wrap{max-width:1300px;margin:0 auto;padding:0 22px}
.hero{background:linear-gradient(110deg,#13273e,#102137 70%,#1b3347);border-bottom:1px solid #37516b;padding:28px 0 24px}
.eyebrow{color:#f2c778;font-size:.76rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
h1{font-size:clamp(2rem,4.2vw,3rem);letter-spacing:-.043em;line-height:1.1;margin:8px 0}
.intro{color:#c3d0dc;margin:0;line-height:1.6;max-width:780px;font-size:.98rem}
.searchbox{max-width:960px;margin-top:18px;background:#f9fbfd;border:2px solid transparent;border-radius:12px;padding:0 12px;display:flex;align-items:center;gap:12px;color:#4a6276}
.searchbox:focus-within{border-color:#f4c971}
.searchbox input{min-width:0;flex:1;border:0;background:transparent;color:#15283f;outline:0;padding:15px 0;font:inherit;font-size:1.08rem}
.searchbox button{font:inherit;background:#e4e9ed;color:#3c5569;border:0;border-radius:50%;height:28px;width:28px;cursor:pointer}
.searchbox button[hidden]{display:none}
.toolbar{padding:16px 0 12px;border-bottom:1px solid #2d455e;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.tabs{display:flex;gap:8px;flex-wrap:wrap}
.tab{border:1px solid #55728b;border-radius:999px;background:#12263b;color:#dfecf7;padding:10px 16px;font:inherit;cursor:pointer;font-size:.9rem}
.tab:hover{background:#27425e}.tab[aria-selected="true"]{background:#f3c76e;color:#17273a;border-color:#f3c76e;font-weight:850}
.sort-hint{color:#9fb7ce;font-size:.78rem}
.heading{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:9px;margin:20px 0 13px}
.heading h2{font-size:1.3rem;margin:0}
.heading p{font-size:.86rem;color:#b0c5d8;margin:4px 0 0}
.sync{font-size:.75rem;color:#9db4c9}
.table-frame{overflow-x:auto;border:1px solid #3e5974;border-radius:14px;background:linear-gradient(180deg,#152c45,#11263c)}
.results-table{border-collapse:separate;border-spacing:0;width:100%;min-width:990px}
.results-table th{background:#18324d;border-bottom:1px solid #59748c;padding:13px 14px;text-align:left;white-space:nowrap}
.results-table th button{font:inherit;font-weight:780;color:#e9c77c;border:0;background:transparent;text-align:left;cursor:pointer;padding:0}
.results-table th button:hover{text-decoration:underline}
.results-table th button:focus-visible{outline:2px solid #f4c877;outline-offset:4px}
.results-table th .arrow{display:inline-block;margin-left:6px;font-size:.75rem}
.results-table td{padding:10px 14px;border-bottom:1px solid #304c66;vertical-align:middle;font-size:.86rem}
.results-table tbody tr:last-child td{border-bottom:0}
.results-table tbody tr.main-row:hover{background:#213b55}
.source{display:flex;align-items:center;gap:10px;min-width:230px}
.source img{width:74px;height:54px;object-fit:cover;border-radius:8px;border:1px solid #50738d;background:#1d374f;flex:none}
.name{font-weight:820;color:#fff;font-size:.92rem;line-height:1.25}
.sub{font-size:.75rem;color:#b1c7d8;margin-top:4px}
.link-detail{display:inline-block;padding:0;border:0;background:transparent;color:#e7bd6b;font:inherit;cursor:pointer;font-size:.75rem;margin-top:5px;text-decoration:underline;text-underline-offset:3px}
.qty{font-weight:850;color:#f4ca78;font-size:1.05rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.meta{color:#cbd9e6;font-size:.84rem}
.chance{display:inline-block;border-radius:999px;padding:5px 10px;white-space:nowrap;background:#324963;color:#e2ebf3;font-size:.76rem}
.chance.guaranteed{background:#18533c;color:#b9f6c9}
.chance.possible{background:#57441e;color:#ffe0a1}
.chance.mixed{background:#504b36;color:#f6db9f}.chance.redeem{background:#2f4b7d;color:#cce7ff}.activity-tools{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:9px 0 3px;color:#c9dcec}.activity-tools select{border-radius:8px;padding:8px 12px;background:#1d3650;color:#fff;border:1px solid #627b95;font:inherit;font-size:.86rem}.detail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}.detail-field{border:1px solid #3d5872;border-radius:8px;padding:10px 12px}.detail-field b{display:block;font-size:.74rem;color:#e7c683;margin-bottom:4px}.detail-field span{color:#e5f0fa}.detail-section{padding:12px 0}.detail-section h3{font-size:.95rem;margin:0 0 10px;color:#f5d48b}
.live-filter{display:flex;align-items:center;gap:7px;white-space:nowrap;font-size:.87rem;color:#d5e4f0}.live-filter input{accent-color:#37c583;width:18px;height:18px}.live-indicator{color:#75e8a6;font-weight:850;white-space:nowrap}.note{max-width:310px;line-height:1.5;color:#cfdeeb}
.detail-row{background:#1b344d}.detail-row td{padding:14px 22px 17px}
.detail-content{display:flex;flex-wrap:wrap;gap:20px;align-items:start;color:#c5daea}
.detail-content ul{padding-left:20px;margin:8px 0;line-height:1.6}
.detail-content small{color:#b1c4d7}
.empty{border:1px dashed #4c6680;border-radius:13px;padding:32px;text-align:center;color:#c5d8e6}
[hidden]{display:none!important}
.load{display:block;margin:18px auto 35px;padding:11px 24px;border:1px solid #e0b66d;border-radius:9px;background:#f0c670;color:#13253a;font:inherit;font-weight:800;cursor:pointer}
footer{border-top:1px solid #314c66;color:#abc1d4;font-size:.82rem;padding:23px 0;line-height:1.6}
@media(max-width:700px){.hero{padding-top:26px}.wrap{padding:0 14px}.tabs{gap:6px}.tab{padding:8px 12px}.table-frame{margin:0 -14px;border-radius:0}.heading{margin-top:17px}.results-table{min-width:860px}}

.rewards-breakdown{width:100%;border-collapse:collapse;table-layout:auto;font-size:.88rem;color:#e6f0f9}
.rewards-breakdown th{padding:11px 12px;text-align:left;background:#29445f;color:#f5cd81;font-weight:800;border-bottom:2px solid #62809b}
.rewards-breakdown td{padding:10px 12px;text-align:left;white-space:normal;vertical-align:top;border-bottom:1px solid #395672}
.rewards-breakdown tbody tr:nth-child(even){background:#173047}
.rewards-breakdown tbody tr:nth-child(odd){background:#10283e}
.rewards-breakdown th:nth-child(2),.rewards-breakdown td:nth-child(2){text-align:right;white-space:nowrap}
.rewards-breakdown td:nth-child(3){font-weight:750;color:#b9e7c8}
.reward-detail{overflow-x:auto}
.reward-detail h3{margin:0 0 12px;color:#f0c77e;font-size:1rem}
.detail-row td{padding:0 13px 15px!important}

.searchbox #add-search{width:auto;height:auto;padding:9px 13px;border-radius:8px;background:#f1c776;color:#102538;font-weight:850;font-size:.84rem;white-space:nowrap}
.searchbox #add-search:disabled{opacity:.45;cursor:not-allowed}
.selected-items{display:flex;flex-wrap:wrap;gap:9px;margin-top:12px}
.selected-items:empty{display:none}
.item-chip{display:inline-flex;gap:10px;align-items:center;background:#17364b;border:1px solid #d6aa62;border-radius:999px;padding:7px 10px;color:#f9deb0;font-size:.84rem;font-weight:750}
.item-chip button{border:0;background:transparent;color:#ffe5b8;cursor:pointer;font:inherit;font-weight:900}
.search-instructions{font-size:.78rem;color:#c5d9e5;margin:9px 0 0}
.match-pill{display:block;color:#a2e4b5;font-weight:750;font-size:.72rem;margin-top:6px}
@media(max-width:600px){.searchbox{flex-wrap:wrap;padding:8px}.searchbox input{min-width:140px}.searchbox #add-search{width:100%}}

</style></head><body>
<SiteHeader active="resources"/>
<main><section class="hero banner-hero banner-resources"><div class="wrap">
<div class="eyebrow">Player Tools / Item Finder</div>
<h1>Item Finder. Hunt smarter. Loot bigger.</h1>
<p class="intro">Know what you need? Find out who drops it, which events hand it out and where your next haul is hiding.</p>
<div class="searchbox"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
<label for="query" style="position:absolute;width:1px;height:1px;clip:rect(0,0,0,0);overflow:hidden">Find a reward</label>
<input id="query" type="search" list="item-suggestions" placeholder="Search Gems, Refining Stone, Source of Life…" autocomplete="off"/>
<button id="add-search" type="button" aria-label="Add item to search">+ Add item</button><button id="clear-search" type="button" aria-label="Clear search" hidden>×</button>
<datalist id="item-suggestions"></datalist></div><div id="selected-items" class="selected-items" aria-live="polite"></div><p class="search-instructions">Add up to 3 items to discover sources that offer several rewards.</p></div></section>
<section class="wrap"><div class="toolbar">
<div class="tabs" id="tabs" role="tablist" aria-label="Reward source">
<button class="tab" role="tab" type="button" aria-selected="true" data-type="all">All</button>
<button class="tab" role="tab" type="button" aria-selected="false" data-type="events">Events</button>
<button class="tab" role="tab" type="button" aria-selected="false" data-type="all-bosses">Bosses</button>
<button class="tab" role="tab" type="button" aria-selected="false" data-type="boxes">Boxes</button>
</div><label class="live-filter"><input type="checkbox" id="live-only"> Show Live Only</label><span class="sort-hint">Click a column heading to sort all matching sources</span>
</div>

<div class="heading"><div><h2 id="results-heading">Find an item to get started</h2><p id="results-description">Find a monster, event or item and explore its rewards.</p></div><span class="sync" id="sync-status"></span></div>
<div id="empty" class="empty">Start typing an item name to see where it can be obtained.</div>
<div class="table-frame" id="table-frame" hidden>
<table class="results-table" aria-label="Item Finder comparison results"><thead><tr>
<th scope="col"><button data-sort="source" type="button">Source <span class="arrow"></span></button></th>
<th scope="col"><button data-sort="type" type="button">Type <span class="arrow"></span></button></th>
<th scope="col" data-event-column><button data-sort="activity" type="button">Activity <span class="arrow"></span></button></th><th scope="col" data-event-column><button data-sort="rewardActivity" type="button">Reward Activity <span class="arrow"></span></button></th>
<th scope="col"><button data-sort="quantity" type="button">Quantity <span class="arrow"></span></button></th>
<th scope="col"><button data-sort="availability" type="button">Availability <span class="arrow"></span></button></th>
<th scope="col"><button data-sort="chance" type="button">Reward chance <span class="arrow"></span></button></th>

</tr></thead><tbody id="results"></tbody></table></div>
<button id="load-more" class="load" type="button" hidden>Show more sources</button>
</section></main>

<script is:inline>
(()=>{
"use strict";
const API="https://evonymasters-sheet-sync.jaynmegepicadventure.workers.dev";
const query=document.getElementById("query"),clear=document.getElementById("clear-search"),tabs=document.getElementById("tabs"),
frame=document.getElementById("table-frame"),tbody=document.getElementById("results"),heading=document.getElementById("results-heading"),
desc=document.getElementById("results-description"),status=document.getElementById("sync-status"),empty=document.getElementById("empty"),
more=document.getElementById("load-more"),suggestions=document.getElementById("item-suggestions"),liveOnly=document.getElementById("live-only");
const addSearch=document.getElementById("add-search"),selectedBox=document.getElementById("selected-items");
let selectedItems=[],multiGroups=new Map(),calendarAvailability=null,calendarLoading=false;
const sourceKey=x=>String(x??"").toLowerCase().replace(/[’']/g,"").replace(/[^a-z0-9]+/g," ").trim().replace(/\\b(barbarians|monsters)\\b/g,v=>v==="barbarians"?"barbarian":"monster");
const calendarName=x=>sourceKey(x).replace(/\\s+lv\\s+\\d+$/,"");
function matchSchedule(row){
 if(!calendarAvailability)return null;
 const candidates=[row.title,row.context?.event].filter(Boolean).map(calendarName);
 const candidatesWithKind=[row.source==="events"?"Event":row.source==="event-bosses"?"Event Boss":row.source==="regular"?"Regular Monster":"Boss"];
 let schedules=[];
 for(const [k,entry] of calendarAvailability){
  const parts=k.split("|"),name=parts.slice(1).join("|");
  if(candidates.some(q=>q===name||q.length>9&&(name.startsWith(q+" ")||q.startsWith(name+" ")))&&(!candidatesWithKind.length||parts[0]===candidatesWithKind[0].toLowerCase()||row.context?.event))schedules.push(entry);
 }
 if(!schedules.length)return null;
 const active=schedules.some(x=>x.live);
 const dates=schedules.map(x=>x.next).filter(Boolean).sort();
 return {availability:active?"Live":dates.length?"Upcoming":"Unscheduled",nextAvailable:dates[0]||""};
}
async function refreshCalendar(){
 if(calendarLoading)return;
 calendarLoading=true;
 try{
  const today=new Date().toISOString().slice(0,10);
  const end=new Date(Date.parse(today+"T00:00:00Z")+92*86400000).toISOString().slice(0,10);
  const response=await fetch("https://evonymasters-calendar.jaynmegepicadventure.workers.dev/api/events?"+new URLSearchParams({from:today,to:end,kind:"all",includeAlways:"true"}));
  if(!response.ok)throw Error("Calendar unavailable");
  const data=await response.json(),index=new Map();
  for(const e of data.events||[]){
   const name=calendarName(e.name),kind=String(e.kind||"").toLowerCase(),key=kind+"|"+name;
   const state=index.get(key)||{live:false,next:""};
   if(e.date===today)state.live=true;
   else if(e.date>today&&(!state.next||e.date<state.next))state.next=e.date;
   index.set(key,state);
  }
  calendarAvailability=index;
  for(const td of tbody.querySelectorAll('[data-availability]'))if(td._group)fillAvailability(td,td._group);
  if(liveOnly.checked)renderCurrentResults();
 }catch{calendarAvailability=null;}finally{calendarLoading=false;}
}
function renderChips(){
 selectedBox.replaceChildren();
 for(const item of selectedItems){
  const chip=document.createElement("span");chip.className="item-chip";chip.append(document.createTextNode(item));
  const remove=document.createElement("button");remove.type="button";remove.textContent="×";remove.setAttribute("aria-label","Remove "+item);
  remove.addEventListener("click",()=>{selectedItems=selectedItems.filter(v=>v!==item);renderChips();schedule();});
  chip.append(remove);selectedBox.append(chip);
 }
 addSearch.disabled=selectedItems.length>=3;addSearch.textContent=selectedItems.length>=3?"3 items selected":"+ Add item";
}
function addItem(){
 const value=query.value.trim();
 if(value.length<2||selectedItems.some(x=>x.toLowerCase()===value.toLowerCase())||selectedItems.length>=3)return;
 selectedItems.push(value);query.value="";suggestions.replaceChildren();clear.hidden=true;renderChips();schedule();
}
addSearch.addEventListener("click",addItem);
query.addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();addItem();}});

let type="all",sort="suggested",direction="asc",page=0,token=0,controller=null,delay=null,suggestDelay=null,hasMore=false,recordCount=0;
function fillAvailability(td,row){
 td._group=row;
 const schedule=matchSchedule(row),state=schedule?.availability||row.availability||"Unknown";
 const nextAvailable=schedule?.nextAvailable||row.nextAvailable;
 td.className=state==="Live"?"live-indicator":"meta";
 td.textContent=state==="Live"?"● LIVE":state==="Upcoming"?"Upcoming · "+nextAvailable:state==="Not applicable"?"—":state==="Unscheduled"?"Unscheduled":"Not connected";
 td.title=state==="Live"?"Scheduled as available today (Evony UTC)":state==="Unknown"?"Calendar availability is not connected":state==="Upcoming"?"Next scheduled date in Evony UTC":"";
}
const names={events:"Event",bosses:"Boss","event-bosses":"Event boss",regular:"Regular monster",boxes:"Box"};
const art={
 "alchemy shop":"alchemy-shop","astral oracle":"astral-oracle","grace of star trail":"grace-of-star-trail",
 "crazy eggs":"crazy-eggs","feasting revelry":"feasting-revelry",ymir:"ymir",zombie:"zombie"
};
const toText=x=>String(x??"").trim();
const node=(tag,className,content)=>{const n=document.createElement(tag);if(className)n.className=className;if(content!==undefined)n.textContent=toText(content);return n;};
const artwork=row=>{
 const key=toText(row.title).toLowerCase().replace(/[^a-z0-9 ]/g,"").replace(/\s+/g," ").trim();
 const fallback=row.source==="boxes"?"box":["bosses","event-bosses","regular"].includes(row.source)?"boss":"event";
 return "/images/item-finder/"+(art[key]||fallback)+".svg";
};
const label=row=>names[row.source]||row.source;
function detailedRow(row){
 const details=node("tr","detail-row"),td=node("td");
 td.colSpan=["all","events"].includes(type)?7:5;
 const wrapper=node("div","reward-detail"),c=row.context||{};
 if(row.source==="boxes"){
  const link=node("a","link-detail","View chest contents");
  link.href="/chests/?q="+encodeURIComponent(row.title);
  wrapper.append(link);td.append(wrapper);details.append(td);return details;
 }
 const items=row.items||[];
 const table=node("table","rewards-breakdown");
 const thead=node("thead"),header=node("tr");
 for(const heading of ["Item","Quantity","Drop classification","Activity"])header.append(node("th","",heading));
 thead.append(header);table.append(thead);
 const body=node("tbody");
 for(const item of items){
  const tr=node("tr"),activity=item.details?.activity||item.details?.subEvent||c.rewardActivity||c.activity||"—";
  const cl=toText(item.classification);
  for(const val of [item.item,toText(item.quantity)||"—",cl&&cl!=="Unspecified"?cl:"—",activity])tr.append(node("td","",val));
  body.append(tr);
 }
 table.append(body);wrapper.append(table);
 if(row.source==="events"){
  const activity=c.activity||c.rewardActivity||c.subEvent;
  if(activity)wrapper.prepend(node("h3","",activity));
 }
 td.append(wrapper);details.append(td);return details;
}
function resultRow(row){
 const tr=node("tr","main-row");
 const source=node("td");
 const sourceLine=node("div","source");
 const img=document.createElement("img");img.src=artwork(row);img.alt="";img.loading="lazy";img.width=74;img.height=54;
 const info=node("div");info.append(node("div","name",row.title));
 if(row._matchedItems?.length>1)info.append(node("span","match-pill","Matches "+row._matchedItems.length+" items: "+row._matchedItems.join(", ")));
 const level=toText(row.context?.level),event=toText(row.context?.event);
 if(level||event)info.append(node("div","sub",[level?"Lv "+level:"",event].filter(Boolean).join(" · ")));
 const toggle=node("button","link-detail","Details");toggle.type="button";toggle.setAttribute("aria-expanded","false");
 const id="detail-"+Math.random().toString(36).slice(2);toggle.setAttribute("aria-controls",id);
 info.append(toggle);sourceLine.append(img,info);source.append(sourceLine);tr.append(source);
 tr.append(node("td","meta",label(row)));
 if(["all","events"].includes(type)){tr.append(node("td","meta",row.source==="events"?toText(row.context?.activity)||"—":"—"));tr.append(node("td","meta",row.source==="events"?toText(row.context?.rewardActivity)||"—":"—"));}
 tr.append(node("td","qty",row.quantityDisplay||"Variable"));
 const av=node("td","meta");av.dataset.availability="";fillAvailability(av,row);tr.append(av);
 const chanceCell=node("td"),chance=node("span","chance "+toText(row.chance).toLowerCase(),row.chance==="Unspecified"?"Data missing":(row.chance||"Data missing"));
 chanceCell.append(chance);tr.append(chanceCell);
 
 const extra=detailedRow(row);extra.hidden=true;extra.id=id;
 toggle.addEventListener("click",()=>{
  extra.hidden=!extra.hidden;
  toggle.setAttribute("aria-expanded",String(!extra.hidden));
  toggle.textContent=extra.hidden?"Details":"Hide details";
 });
 return [tr,extra];
}
function updateSortIndicators(){
 for(const btn of document.querySelectorAll("[data-sort]")){
  const active=btn.dataset.sort===sort;
  btn.querySelector(".arrow").textContent=active?(direction==="desc"?"▼":"▲"):"↕";
  btn.closest("th").setAttribute("aria-sort",active?(direction==="desc"?"descending":"ascending"):"none");
 }
}
const groupKey=g=>JSON.stringify([g.source,g.title,g.context?.level,g.context?.event,g.context?.subEvent,g.context?.activity,g.context?.detail]);
const currentTerms=()=>{const draft=query.value.trim(),list=[...selectedItems];if(draft.length>=2&&list.length<3&&!list.some(x=>x.toLowerCase()===draft.toLowerCase()))list.push(draft);return list;};
function renderCurrentResults(){
 tbody.replaceChildren();
 const groups=[...multiGroups.values()];
 const visible=liveOnly.checked?groups.filter(g=>(matchSchedule(g)?.availability||g.availability)==="Live"):groups;
 if(sort==="availability")visible.sort((a,b)=>{
  const rank=v=>({Live:0,Upcoming:1,Unscheduled:2,Unknown:3}[matchSchedule(v)?.availability||v.availability]??3);
  return rank(a)-rank(b)||a.title.localeCompare(b.title);
 });
 if(sort==="source")visible.sort((a,b)=>a.title.localeCompare(b.title));
 for(const group of visible)tbody.append(...resultRow(group));
 frame.hidden=!visible.length;empty.hidden=!!visible.length;
 if(!visible.length)empty.textContent=liveOnly.checked?"No matching live sources in the loaded results.":"No matching sources.";
 desc.textContent=visible.length+" sources shown"+(selectedItems.length?" · matching up to "+selectedItems.length+" selected items":"")+(hasMore?" · more available":"");
 more.hidden=!hasMore;
}
async function fetchResults(append=false){
 const terms=currentTerms();
 if(!append){page=0;multiGroups.clear();tbody.replaceChildren();frame.hidden=true;more.hidden=true;}
 if(!terms.length){empty.hidden=false;empty.textContent="Type at least two characters or add up to three items.";heading.textContent="Find an item to get started";desc.textContent="Search items to find their sources.";return;}
 if(controller)controller.abort();controller=new AbortController();const current=++token;
 heading.textContent=terms.length===1?'Results for “'+terms[0]+'”':"Sources for "+terms.join(" + ");
 empty.hidden=false;empty.textContent="Searching selected items…";
 try{
  const batches=await Promise.all(terms.map(async term=>{
   const params=new URLSearchParams({q:term,type,sort,direction,page:String(page),liveOnly:"false"});
   const response=await fetch(API+"/v3/search?"+params,{signal:controller.signal});
   if(!response.ok)throw Error("Search returned HTTP "+response.status);
   const data=await response.json();
   if(!Array.isArray(data.groups))throw Error("Invalid search results");
   return {term,data};
  }));
  if(current!==token)return;
  hasMore=batches.some(x=>x.data.hasMore);
  recordCount=batches.reduce((sum,x)=>sum+x.data.total,0);
  liveOnly.disabled=batches.every(x=>x.data.availabilityConfigured===false)&&!calendarAvailability;
  for(const {term,data} of batches)for(const group of data.groups){
   const id=groupKey(group),old=multiGroups.get(id);
   if(!old){multiGroups.set(id,{...group,items:[...group.items||[]],_matchedItems:[term]});continue;}
   if(!old._matchedItems.includes(term))old._matchedItems.push(term);
   const seen=new Set(old.items.map(item=>JSON.stringify([item.item,item.quantity,item.classification,item.route])));
   for(const item of group.items||[]){
    const key=JSON.stringify([item.item,item.quantity,item.classification,item.route]);
    if(!seen.has(key)){old.items.push(item);seen.add(key);}
   }
   old._matchedItems.sort((a,b)=>terms.indexOf(a)-terms.indexOf(b));
   old.quantityDisplay="See details";
   if(group.availability==="Live")old.availability="Live";
  }
  renderCurrentResults();
  if(!calendarAvailability)refreshCalendar();
 }catch(error){
  if(error.name==="AbortError")return;
  empty.hidden=false;empty.textContent="Search is temporarily unavailable. Please try again.";
  if(!append)frame.hidden=true;more.hidden=true;
 }
}
function schedule(){clearTimeout(delay);if(controller)controller.abort();delay=setTimeout(()=>fetchResults(),280);}
query.addEventListener("input",()=>{
 clear.hidden=!query.value; schedule();clearTimeout(suggestDelay);
 const term=query.value.trim();if(term.length<2){suggestions.replaceChildren();return;}
 suggestDelay=setTimeout(async()=>{
  try{
   const r=await fetch(API+"/v2/suggest?q="+encodeURIComponent(term));
   if(!r.ok)return;
   const data=await r.json();
   if(query.value.trim()!==term)return;
   suggestions.replaceChildren(...(data.items||[]).map(v=>{const opt=document.createElement("option");opt.value=v;return opt;}));
  }catch{}
 },320);
});
clear.addEventListener("click",()=>{query.value="";selectedItems=[];renderChips();clear.hidden=true;query.dispatchEvent(new Event("input"));query.focus();});
tabs.addEventListener("click",e=>{
 const button=e.target.closest("button[data-type]");if(!button)return;
 type=button.dataset.type;
 for(const th of document.querySelectorAll("[data-event-column]"))th.hidden=!["all","events"].includes(type);
 if(!["all","events"].includes(type)&&["activity","rewardActivity"].includes(sort)){sort="suggested";direction="asc";updateSortIndicators();}
 for(const tab of tabs.querySelectorAll("button"))tab.setAttribute("aria-selected",String(tab===button));
 schedule();
});

liveOnly.addEventListener("change",()=>{sort=liveOnly.checked?"availability":"suggested";direction="asc";updateSortIndicators();renderCurrentResults();});
document.querySelectorAll("[data-sort]").forEach(btn=>btn.addEventListener("click",()=>{
 const value=btn.dataset.sort;
 if(value===sort)direction=direction==="asc"?"desc":"asc";
 else{sort=value;direction=value==="quantity"?"asc":"asc";}
 updateSortIndicators();schedule();
}));
more.addEventListener("click",()=>{if(hasMore){page++;fetchResults(true);}});
updateSortIndicators();
const initial=new URLSearchParams(location.search).get("q");
if(initial)query.value=initial;
renderChips();refreshCalendar();
clear.hidden=!query.value;if(query.value.trim().length>=2)schedule();
})();
</script></body></html>