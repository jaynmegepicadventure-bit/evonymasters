---
import monsters from '../../data/monsters.json';
import items from '../../data/items.json';
export function getStaticPaths(){return monsters.map(monster=>({params:{id:monster.id},props:{monster}}));}
const {monster}=Astro.props;
const byId=new Map(items.map(i=>[i.id,i]));
const fmt=n=>n==null?'Not yet verified':new Intl.NumberFormat('en-US').format(n);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{monster.name} | evonymasters</title><style>:root{font-family:system-ui;color:#eaf0f8;background:#0c1726}body{margin:0}header,main,footer{padding:24px max(24px,calc((100vw - 1000px)/2))}header,footer{background:#11243a}a{color:#e6bc73}h1{font-size:clamp(2rem,5vw,3.5rem)}.panel{background:#152b43;border:1px solid #35516d;border-radius:16px;padding:22px;margin:20px 0}.boss-image{width:min(100%,440px);height:260px;object-fit:contain;display:block;background:#213d57;border:1px solid #35516d;border-radius:16px;margin:20px 0}.stats{display:flex;flex-wrap:wrap;gap:15px}.reward{padding:10px 0;border-bottom:1px solid #35516d}.muted{color:#b6c8d9}</style></head><body><header><a href="/">← evonymasters Monster Finder</a></header><main><h1>{monster.name}</h1>{monster.image&&<img class="boss-image" src={monster.image} alt={monster.name+" boss artwork"} loading="lazy"/>}<p class="muted">{monster.type}{monster.level==null?'':' · Level '+monster.level}{monster.event?' · '+monster.event:''}</p><div class="panel stats"><span>Power: {fmt(monster.power)}</span><span>Stamina: {fmt(monster.stamina)}</span></div><section class="panel"><h2>Guaranteed rewards</h2>{monster.rewards.filter(r=>r.kind==='guaranteed').length===0?<p class="muted">None confirmed yet.</p>:monster.rewards.filter(r=>r.kind==='guaranteed').map(r=><div class="reward">{/^lv\d+-boss-monster-chest$/.test(r.itemId)?<a href={'/items/'+r.itemId+'/'}>{byId.get(r.itemId)?.name||r.itemId}</a>:byId.get(r.itemId)?.name||r.itemId}{r.quantity==null?'':' · '+fmt(r.quantity)}{r.origin==='boss_chest'?' · from boss chest':r.origin==='other_chest'?' · from event chest':''}</div>)}</section><section class="panel"><h2>Possible rewards and chest contents</h2>{monster.rewards.filter(r=>r.kind==='possible').map(r=><div class="reward">{/^lv\d+-boss-monster-chest$/.test(r.itemId)?<a href={'/items/'+r.itemId+'/'}>{byId.get(r.itemId)?.name||r.itemId}</a>:byId.get(r.itemId)?.name||r.itemId}{r.quantity==null?'':' · '+fmt(r.quantity)+(r.unit?' '+r.unit:'')}{r.origin==='boss_chest'?' · from boss chest':r.origin==='other_chest'?' · from event chest':''}</div>)}</section><p class="muted">Data status: {monster.verification?.inGameVerified?'Verified in game':'Guide-sourced; not yet verified in game'}. Rewards and events may change.</p><p class="muted">Research attribution: Evony TKR Guide and other cited public guides. This is an independent summary, not a reproduction of their pages.</p></main><footer>Independent fan-made reference. Not affiliated with the game publisher.</footer></body></html>