---
import SeoMetadata from '../../components/SeoMetadata.astro';
import monsters from '../../data/monsters.json';
import items from '../../data/items.json';
export function getStaticPaths(){return monsters.map(monster=>({params:{id:monster.id},props:{monster}}));}
const {monster}=Astro.props;
const byId=new Map(items.map(i=>[i.id,i]));
const fmt=n=>n==null?'Not yet verified':new Intl.NumberFormat('en-US').format(n);
const chestIds=new Set((monster.chests||[]).map(c=>c.itemId));
const stats='stats' in monster ? monster.stats : null;
const otherRewards=monster.rewards.filter(r=>r.origin!=='boss_chest' && !(r.origin==='direct'&&chestIds.has(r.itemId)));
const category=monster.type==='Event'?'Event Boss':monster.type==='Regular'?'Regular Monster':'Boss Monster';
const label=monster.name+' Evony '+category;
const levelText=monster.level==null?'':' Level '+monster.level;
const pageTitle=monster.name+' Evony'+levelText+' Rewards & Chests | EvonyMasters';
const description='Evony '+monster.name+': '+(monster.level==null?'':'level '+monster.level+' ')+category.toLowerCase()+' rewards, '+(monster.stamina==null?'stamina not verified':monster.stamina+' stamina')+', '+(monster.power==null?'power not verified':new Intl.NumberFormat('en-US').format(monster.power)+' power')+' and recorded chest drops.';
const related=monsters.filter(x=>x.id!==monster.id&&x.type===monster.type).sort((a,b)=>Math.abs((a.level??0)-(monster.level??0))-Math.abs((b.level??0)-(monster.level??0))||a.name.localeCompare(b.name)).slice(0,5);
---
<!doctype html>
<html lang="en"><head><SeoMetadata title={pageTitle} description={description}/><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{pageTitle}</title>
<style>:root{font-family:system-ui;color:#eaf0f8;background:#0c1726}body{margin:0}header,main,footer{padding:24px max(24px,calc((100vw - 1000px)/2))}header,footer{background:#11243a}a{color:#e6bc73}h1{font-size:clamp(2rem,5vw,3.5rem)}.panel{background:#152b43;border:1px solid #35516d;border-radius:16px;padding:22px;margin:20px 0}.boss-image{width:min(100%,440px);height:260px;object-fit:contain;display:block;background:#213d57;border:1px solid #35516d;border-radius:16px;margin:20px 0}.stats{display:flex;flex-wrap:wrap;gap:15px}.reward{padding:10px 0;border-bottom:1px solid #35516d}.muted{color:#b6c8d9}.live-state{font-weight:800;color:#bfd2e2}.live-state.live{color:#79e7a3}.chest{border:1px solid #466079;border-radius:12px;padding:16px;margin:14px 0}.chest h3{margin:0 0 10px;color:#f2ce88}.chest ul{margin:0;padding-left:23px;line-height:1.7}.intro{line-height:1.7;color:#d5e3f0;max-width:880px}.related-list{display:flex;flex-wrap:wrap;gap:10px;list-style:none;padding:0}.related-list a{display:inline-block;padding:10px 13px;border:1px solid #57718b;border-radius:9px;color:#f1cc84;background:#18334d;text-decoration:none}.related-list a:hover{text-decoration:underline}.note{line-height:1.6;color:#bbcede}</style></head>
<body><header><a href="/bosses/">← Boss Directory</a> · <a href="/resources/">Resource Finder</a> · <a href="/">EvonyMasters Home</a></header>
<main><h1>{monster.name} Evony {category} Rewards</h1><p class="intro">Explore recorded rewards and chest contents for {monster.name}{monster.level==null?'':', level '+monster.level} in Evony. {monster.stamina==null?'Stamina cost has not been verified.':'Recorded stamina cost: '+fmt(monster.stamina)+'.'} {monster.power==null?'Power has not been verified.':'Recorded monster power: '+fmt(monster.power)+'.'} Review possible drops separately from guaranteed rewards, and check availability before planning your hunt.</p><p class="live-state" id="monster-availability" data-name={monster.name.replace(/\s*-\s*Level\s*\d+$/i,"")} data-level={monster.level||""} data-kind={monster.type==="Event"?"Event Boss":monster.type==="Regular"?"Regular Monster":"Boss"}>Checking UTC availability…</p><p><a href="/calendar/">See event &amp; monster calendar →</a></p>{monster.image&&<img class="boss-image" src={monster.image} alt={monster.name+" boss artwork"} loading="lazy"/>}
<p class="muted">{monster.type}{monster.level==null?'':' · Level '+monster.level}{monster.event?' · '+monster.event:''}</p>
<div class="panel stats"><span>Power: {fmt(monster.power)}</span><span>Stamina: {fmt(monster.stamina)}</span></div>
{stats&&<section class="panel"><h2>Monster stats</h2><div class="stats"><span>Monarch EXP: {fmt(stats.monarchExp)}</span><span>General EXP: {fmt(stats.generalExp)}</span><span>Prestige: {fmt(stats.prestige)}</span><span>Alliance Points: {fmt(stats.alliancePoints)}</span><span>Alliance Honor: {fmt(stats.allianceHonor)}</span></div></section>}
<section class="panel"><h2>Monster chests</h2>
{(monster.chests||[]).length===0?<p class="muted">Chest details have not been documented for this monster.</p>:(monster.chests||[]).map(chest=><div class="chest"><h3>{chest.name}</h3>{chest.contents.length?<ul>{chest.contents.map(item=><li>{item.name}{item.quantity==null?'':' x'+fmt(item.quantity)}{item.unit?' '+item.unit:''}</li>)}</ul>:<p class="muted">Contents not documented.</p>}{chest.notes&&<p class="muted">{chest.notes}</p>}</div>)}
</section>
<section class="panel"><h2>Other recorded rewards</h2>{otherRewards.length===0?<p class="muted">No additional rewards documented.</p>:(["guaranteed","possible"] as const).map(kind=>otherRewards.some(r=>r.kind===kind)&&<div><h3>{kind==="guaranteed"?"Base rewards":"Possible drops"}</h3>{otherRewards.filter(r=>r.kind===kind).map(r=><div class="reward">{byId.get(r.itemId)?.name||r.itemId}{r.quantity==null?'':' · '+fmt(r.quantity)+(r.unit?' '+r.unit:'')}{r.origin==='other_chest'?' · from another chest':''}{r.notes?' · '+r.notes:''}</div>)}</div>)}</section>
<section class="panel" aria-labelledby="understand-rewards"><h2 id="understand-rewards">Understanding {monster.name} rewards</h2><p class="note">This page lists recorded rewards and chest contents from the site's source data. A possible drop is not guaranteed, and a reward listed inside another chest requires obtaining and opening that chest first. Missing values are shown as not yet verified, not as zero. Check in-game details for current drops and event availability.</p></section>
{related.length>0&&<section class="panel" aria-labelledby="related-monsters"><h2 id="related-monsters">Related Evony monsters</h2><p class="note">Compare other recorded {monster.type.toLowerCase()} monsters and their rewards.</p><ul class="related-list">{related.map(other=><li><a href={'/bosses/'+encodeURIComponent(other.id)+'/'}>{other.name}{other.level==null?'':' · Lv'+other.level}</a></li>)}</ul></section>}
</main><script is:inline>
(async()=>{const badge=document.getElementById("monster-availability"),today=new Date().toISOString().slice(0,10),end=new Date(Date.parse(today+"T00:00:00Z")+92*86400000).toISOString().slice(0,10);try{const r=await fetch("https://evonymasters-calendar.jaynmegepicadventure.workers.dev/api/events?"+new URLSearchParams({from:today,to:end,kind:badge.dataset.kind,includeAlways:"true"}));if(!r.ok)throw Error("Calendar unavailable");const data=await r.json(),name=badge.dataset.name.toLowerCase(),specific=(name+" · lv "+badge.dataset.level).toLowerCase();let live=false,next="";for(const e of data.events||[]){const candidate=e.name.toLowerCase();if(candidate!==name&&candidate!==specific)continue;if(e.date===today)live=true;else if(!next||e.date<next)next=e.date;}badge.classList.toggle("live",live);badge.textContent=live?"● LIVE · Scheduled today (UTC)":next?"Upcoming · "+next+" UTC":"No upcoming schedule recorded"}catch{badge.textContent="Availability temporarily unavailable"}})();
</script></body></html>
