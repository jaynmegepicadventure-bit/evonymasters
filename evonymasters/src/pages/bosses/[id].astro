---
import SheetMonsterPage from '../../components/SheetMonsterPage.astro';
import LegacyMonsterPage from '../../components/LegacyMonsterPage.astro';
import directory from '../../data/monster-directory-sheet.json';
import sheetRecords from '../../data/monster-rewards-sheet.json';
import monsters from '../../data/monsters.json';
import {bossPageId} from '../../lib/boss-page-path.mjs';

export function getStaticPaths(){
 const sheetPages=sheetRecords.map(sheetMonster=>{
  const id=bossPageId(sheetMonster,directory);
  const monster=monsters.find(record=>record.id===id)||null;
  return {params:{id},props:{monster,sheetMonster}};
 });
 const used=new Set(sheetPages.map(page=>page.params.id));
 const legacyPages=monsters.filter(monster=>!used.has(monster.id))
  .map(monster=>({params:{id:monster.id},props:{monster,sheetMonster:null}}));
 return [...sheetPages,...legacyPages];
}
const {monster,sheetMonster}=Astro.props;
---
{sheetMonster
 ? <SheetMonsterPage monster={sheetMonster}/>
 : <LegacyMonsterPage monster={monster}/>
}
