---
import monsters from '../../data/monsters.json';
import items from '../../data/items.json';
export function getStaticPaths(){return monsters.map(monster=>({params:{id:monster.id},props:{monster}}));}
const {monster}=Astro.props;
const byId=new Map(items.map(i=>[i.id,i]));
const fmt=n=>n==null?'Not yet verified':new Intl.NumberFormat('en-US').format(n);
const chestIds=new Set((monster.chests||[]).map(c=>c.itemId));
const otherRewards=monster.rewards.filter(r=>r.origin!=='boss_chest' && !(r.origin==='direct'&&chestIds.has(r.itemId)));
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{monster.name} | evonymasters</title>
<style>:root{font-family:system-ui;color:#eaf0f8;background:#0c1726}body{margin:0}header,main,footer{padding:24px max(24px,calc((100vw - 1000px)/2))}header,footer{background:#11243a}a{color:#e6bc73}h1{font-size:clamp(2rem,5vw,3.5rem)}.panel{background:#152b43;border:1px solid #35516d;border-radius:16px;padding:22px;margin:20px 0}.boss-image{width:min(100%,440px);height:260px;object-fit:contain;display:block;background:#213d57;border:1px solid #35516d;border-radius:16px;margin:20px 0}.stats{display:flex;flex-wrap:wrap;gap:15px}.reward{padding:10px 0;border-bottom:1px solid #35516d}.muted{color:#b6c8d9}.chest{border:1px solid #466079;border-radius:12px;padding:16px;margin:14px 0}.chest h3{margin:0 0 10px;color:#f2ce88}.chest ul{margin:0;padding-left:23px;line-height:1.7}</style></head>
<body><header><a href="/resources/">← Resource Finder</a> · <a href="/">evonymasters Home</a></header>
<main><h1>{monster.name}</h1>{monster.image&&<img class="boss-image" src={monster.image} alt={monster.name+" boss artwork"} loading="lazy"/>}
<p class="muted">{monster.type}{monster.level==null?'':' · Level '+monster.level}{monster.event?' · '+monster.event:''}</p>
<div class="panel stats"><span>Power: {fmt(monster.power)}</span><span>Stamina: {fmt(monster.stamina)}</span></div>
<section class="panel"><h2>Monster chests</h2>
{(monster.chests||[]).length===0?<p class="muted">Chest details have not been documented for this monster.</p>:(monster.chests||[]).map(chest=><div class="chest"><h3>{chest.name}</h3>{chest.contents.length?<ul>{chest.contents.map(item=><li>{item.name}{item.quantity==null?'':' x'+fmt(item.quantity)}{item.unit?' '+item.unit:''}</li>)}</ul>:<p class="muted">Contents not documented.</p>}{chest.notes&&<p class="muted">{chest.notes}</p>}{chest.sourceUrl&&<p><a href={chest.sourceUrl}>Chest source</a></p>}</div>)}
</section>
<section class="panel"><h2>Other recorded rewards</h2>{otherRewards.length===0?<p class="muted">No additional rewards documented.</p>:otherRewards.map(r=><div class="reward">{byId.get(r.itemId)?.name||r.itemId}{r.quantity==null?'':' · '+fmt(r.quantity)+(r.unit?' '+r.unit:'')}{r.origin==='other_chest'?' · from another chest':''}</div>)}</section>
<p class="muted">Data status: {monster.verification?.inGameVerified?'Verified in game':'Guide sourced; not yet verified in game'}. Rewards and events may change.</p>
</main><footer>Independent fan made reference. Not affiliated with the game publisher.</footer></body></html>
