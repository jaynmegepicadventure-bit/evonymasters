---
import SeoMetadata from '../../components/SeoMetadata.astro';
import SiteHeader from '../../components/SiteHeader.astro';
const types=[
 {id:'ranged',label:'Ranged',icon:'🏹',defaultSize:7393200,base:10000},
 {id:'mounted',label:'Cavalry',icon:'🐎',defaultSize:7480700,base:10000},
 {id:'ground',label:'Ground',icon:'⚔️',defaultSize:7500000,base:10000},
 {id:'bigSiege',label:'Big Siege',icon:'🏰',defaultSize:6013200,base:1000},
 {id:'smallSiege',label:'Small Siege',icon:'💣',defaultSize:5749450,base:1000},
 {id:'soloSiege',label:'Solo Siege',icon:'🎯',defaultSize:5549800,base:1000}
];
const tiers=[14,15,16];
---
<!doctype html>
<html lang="en">
<head><SeoMetadata title="Evony March Preset & Troop Layer Calculator | EvonyMasters" description="Build Evony march presets and calculate troop layers for ranged, cavalry, ground and siege formations. Set march size and choose upper tiers T14–T16."/><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="Build Evony march presets and calculate troop layers for ranged, cavalry, ground and siege formations. Set march size and choose upper tiers T14–T16."/>
<link rel="icon" href="/favicon.svg"/><title>Evony March Preset & Troop Layer Calculator | EvonyMasters</title>
<style>
:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#07111e;color:#ecf1f7}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% 0,#172c43,#07111e 62%)}
main{max-width:1590px;padding:32px 20px 70px;margin:auto}h1{margin:0 0 8px;font-size:clamp(1.9rem,3vw,2.8rem);color:#f0c77c}
p{line-height:1.55;color:#b9cbdc}.top{margin-bottom:21px}.top p{max-width:960px;margin:8px 0}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:19px 0}
button{font:inherit;cursor:pointer}.toolbar button{border:1px solid #9f825d;background:#1a354d;color:#ffe2ac;border-radius:8px;padding:10px 14px;font-weight:750}
.mode-selector{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin:16px 0}
.mode-selector button{padding:10px 16px;border:1px solid #607994;border-radius:8px;background:#12283c;color:#e4ecf4;font-weight:800}
.mode-selector button[aria-pressed="true"]{background:#f0c77c;color:#091a2b;border-color:#f0c77c}
.preset-tips{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:14px 0 4px}
.preset-tip{display:flex;gap:10px;align-items:flex-start;padding:12px 13px;border-radius:11px;background:#132b40;border:1px solid #36536b;min-width:0}
.preset-tip strong{display:block;color:#f0c77c;font-size:.84rem;margin-bottom:4px}
.preset-tip span:not(.tip-symbol){display:block;color:#c3d5e3;font-size:.78rem;line-height:1.45}
.tip-symbol{display:grid;place-items:center;flex:none;width:32px;height:32px;border-radius:9px;background:#213e55;font-size:1.1rem}
@media(max-width:900px){.preset-tips{grid-template-columns:1fr}.preset-tip{padding:11px 13px}}
.enki-pro-tip{display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap;padding:11px 15px;margin:10px 0 4px;border:1px solid #48627a;border-radius:11px;background:linear-gradient(105deg,#173249,#10283a)}
.enki-pro-heading{display:flex;align-items:center;gap:7px;flex:none;color:#f0c77c;font-size:.85rem;white-space:nowrap}
.enki-credit{color:#adc7d8;font-size:.74rem;font-weight:500}
.enki-pro-body{flex:1;min-width:260px}
.enki-pro-body p{color:#c9d9e7;font-size:.78rem;line-height:1.5;margin:0 0 7px}
.enki-pro-body p:last-child{margin-bottom:0}
.enki-tier-chips{display:flex;gap:6px;flex-wrap:wrap;margin:5px 0 8px}
.enki-tier-chips span{display:inline-flex;align-items:center;gap:7px;border:1px solid #526a7f;border-radius:7px;padding:5px 8px;background:#203c50;color:#e9f1fa;font-size:.77rem}
.enki-tier-chips b{color:#f0c77c}
@media(max-width:900px){.enki-pro-tip{gap:8px}.enki-pro-body{min-width:0;width:100%}}
.custom-layer-field{margin-top:12px}.custom-layer-field[hidden]{display:none}
.layer-size-row{border:1px solid #536b7e;background:#1a354d;border-radius:8px;padding:10px 12px;display:flex;justify-content:space-between;gap:10px;margin:12px 0 8px;font-size:.85rem;font-weight:750}
.layer-size-row output{color:#f3c678;font-variant-numeric:tabular-nums}
.scroller{overflow-x:auto;padding-bottom:14px;scrollbar-color:#648099 #102338}
.cols{display:grid;grid-template-columns:repeat(6,minmax(245px,1fr));gap:12px;min-width:1510px;align-items:stretch}
.card{background:#12283c;border:1px solid #3c5871;border-radius:14px;padding:15px;min-width:0;display:flex;flex-direction:column}
.card h2{font-size:1.28rem;color:#efc276;margin:0 0 15px;white-space:nowrap}
.field{font-weight:750;font-size:.84rem;color:#dae6f0;display:block}.march{width:100%;display:block;margin-top:7px;background:#091a2b;border:1px solid #607994;border-radius:8px;color:white;font:inherit;font-weight:700;padding:12px;min-width:0}
.tiers-head{display:flex;justify-content:space-between;align-items:center;margin:16px 0 8px;gap:5px;font-size:.78rem;color:#c3d2df}
.tiers-head button{padding:5px 7px;border:1px solid #577188;color:#d7e8f6;border-radius:6px;background:#213d55}
.tiers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.tier{display:flex;flex-direction:row;align-items:center;justify-content:center;gap:7px;padding:10px 6px;border:1px solid #3e5c73;background:#1a354c;border-radius:6px;font-size:.74rem;white-space:nowrap;cursor:pointer}
.tier input{accent-color:#edbf71;margin:0;width:15px;height:15px}
.results{margin-top:17px;padding-top:12px;border-top:1px solid #3b5268;flex:1}
.results h3{font-size:.91rem;color:#efc77e;margin:0 0 8px}
/* Rows are inserted by client JavaScript, so selectors must be global rather than Astro-scoped. */
:global(.result-row){display:grid;grid-template-columns:minmax(38px,auto) minmax(0,1fr);column-gap:18px;align-items:center;min-height:37px;padding:8px 10px;border-bottom:1px solid #30485d;background:rgba(4,18,30,.14);font-size:.91rem}
:global(.result-row:nth-child(even)){background:rgba(50,79,104,.17)}
:global(.result-row .tier-label){font-weight:800;color:#efcf99;text-align:left;white-space:nowrap}
:global(.result-row .value){display:block;text-align:right;justify-self:end;font-variant-numeric:tabular-nums;font-weight:800;color:#f4eedb;white-space:nowrap}
.rows{border:1px solid #30485d;border-radius:9px;overflow:hidden}
:global(.result-row:last-child){border-bottom:0}
.summary{margin:0 0 10px;display:flex;justify-content:space-between;align-items:center;font-weight:800;font-size:.93rem}
.summary output{color:#f3c678;font-variant-numeric:tabular-nums}
.stat{color:#b3c8d9;font-size:.74rem;margin:9px 0 0}.stat strong{color:#eaf1f8}.warn{color:#ffd38b;font-size:.78rem;padding:8px;border:1px solid #a9844c;border-radius:6px}
.tip{font-size:.78rem;color:#a9bccf}
@media(max-width:700px){main{padding:24px 12px 55px}.cols{min-width:0;grid-template-columns:1fr}.scroller{overflow:visible}.card{padding:17px} .tiers{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(min-width:701px) and (max-width:1250px){.cols{min-width:1210px;grid-template-columns:repeat(6,1fr)} .tiers{grid-template-columns:repeat(3,minmax(0,1fr))}.tier{flex-direction:row;justify-content:center;gap:5px}}
@media print{.site-header,.toolbar,.tiers-head button{display:none!important}body{background:white;color:black}.scroller{overflow:visible}.cols{display:grid;grid-template-columns:repeat(3,1fr);min-width:0}.card{break-inside:avoid;color:black;background:white}:global(.result-row .value){color:black}}
.march-guide{margin-top:36px;padding:24px;background:#132c42;border:1px solid #405c73;border-radius:14px}
.march-guide h2{font-size:1.45rem;color:#f3ce8d;margin:0 0 12px}
.march-guide h3{font-size:1.1rem;color:#f3ce8d;margin:20px 0 8px}
.march-guide p,.march-guide li{color:#d0dfeb;line-height:1.65}
.march-guide ol{padding-left:22px;display:grid;gap:8px}
.march-guide strong{color:#f5d5a0}
.march-guide a{color:#f2cc89;text-underline-offset:3px}
.compact-guide{padding:0;margin-top:12px}.compact-guide summary{cursor:pointer;padding:15px 20px;color:#f3ce8d;font-weight:800;list-style-position:inside}.compact-guide summary:hover{background:#223e53}.compact-guide .guide-body{padding:0 20px 18px}.compact-guide .guide-body h2{font-size:1.18rem}
.compact-help-link{font-size:.86rem;margin:12px 0;color:#b9cbdc}.compact-help-link a{color:#f2ce8b}
</style></head>
<body><SiteHeader active="troops"/><main>
<div class="top banner-hero banner-march-preset"><h1>Evony March Preset & Troop Layer Calculator</h1><p>Put your march capacity to work. Enter your march size, tick any upper tiers you've unlocked and see a ready-to-use troop layer breakdown. Lower tiers are built into the plan automatically. Ranged, cavalry and ground layers adjust to your march capacity; siege presets keep their separate rules.</p></div>
<div class="preset-tips" aria-label="Quick PvP march tips">
 <div class="preset-tip"><span class="tip-symbol" aria-hidden="true">⚔️</span><div><strong>Recommended PvP march presets</strong><span>A smart starting point, not a guaranteed win. Tune for your buffs and opponent.</span></div></div>
 <div class="preset-tip"><span class="tip-symbol" aria-hidden="true">📈</span><div><strong>Layers grow with your march</strong><span>Minimum 1K, then +1K per full million (4M = 4K). From 7M, use 10K. Larger T7–T11 layers can still apply.</span></div></div>
 <div class="preset-tip"><span class="tip-symbol" aria-hidden="true">🏹</span><div><strong>Still below T13?</strong><span>No problem. The calculator builds around your highest available tiers. Treat lower-tier PvP presets as a starting point and adjust for your roster.</span></div></div>
</div>
<aside class="enki-pro-tip" aria-label="March setting pro tip from Enki_007">
 <div class="enki-pro-heading"><span aria-hidden="true">💡</span><strong>March Setting Pro Tip</strong><span class="enki-credit">from Enki_007</span></div>
 <div class="enki-pro-body"><p>For <strong>Sea Rush</strong>, use the event's maximum allowed layers, then build around your top tier:</p>
 <div class="enki-tier-chips" aria-label="Example with T15 unlocked"><span><b>T15</b> Everything left</span><span><b>T14</b> 300K</span><span><b>T13</b> 200K</span></div>
 <p>Or simply fill the event's maximum layers and give <strong>all remaining troops to T15</strong>. The same approach works for <strong>Kingdom Arena</strong>, where Enki_007 uses <strong>10K layers</strong>.</p></div>
</aside>
<div class="mode-selector" role="group" aria-label="Troop layer calculator mode"><strong>Layer mode:</strong><button type="button" id="mode-recommended" aria-pressed="true">Recommended</button><button type="button" id="mode-custom" aria-pressed="false">Custom layers</button></div>
<div class="toolbar"><button type="button" id="clear">Clear march sizes</button><button type="button" id="print">Print results</button></div>
<div class="scroller"><div class="cols">{types.map(t=><section class="card" data-type={t.id}>
<h2>{t.icon} {t.label}</h2>
<label class="field">March size<input class="march" type="text" inputmode="numeric" autocomplete="off" value="" aria-label={t.label+' march size'}/></label>
{t.base!==1000&&<label class="field custom-layer-field" hidden>Custom support troops per layer<input class="march custom-layer" type="text" inputmode="numeric" value="1000" aria-label={t.label+' custom support layer size'}/></label>}
<div class="tiers-head"><strong>Upper troop tiers</strong><span>T3–T13 included</span></div>
<div class="tiers">{tiers.map(tier=><label class="tier"><input type="checkbox" class="tier-input" value={tier} checked={false}/><span>T{tier}</span></label>)}</div>
<div class="results"><div class="layer-size-row"><span>Support layer size</span><output class="layer-size">0</output></div><div class="summary"><span>Main troop formation</span><output class="formation-total">0</output></div>
<div class="summary"><span>Other troop layers</span><output class="other-per-layer">0 each</output></div>
<h3>Calculated layers</h3><div class="rows" aria-live="polite"></div><p class="warn" hidden></p></div>
</section>)}</div></div>

<p class="compact-help-link">More Evony march preset answers: <a href="/qa/">March layering questions &amp; answers</a></p>
<details class="march-guide compact-guide"><summary>How to use the march calculator</summary><div class="guide-body">
<h2 id="march-guide-title">How to calculate Evony march presets and troop layers</h2>
<p>Use the Evony March Preset calculator to plan troop-layer distributions for ranged, cavalry, ground and siege formations. Each formation has its own march-size field and calculated troop allocation, so you can compare several setups before using them in-game.</p>
<ol>
<li><strong>Choose a formation.</strong> Review the ranged, cavalry, ground, Big Siege, Small Siege or Solo Siege preset.</li>
<li><strong>Enter your march capacity.</strong> Type the total number of troops your march can carry for that formation. Ranged, cavalry and ground use a minimum of 1,000 per support layer, increasing by 1,000 with every full million march size (e.g. 3M = 3,000), and 10,000 from 7M upward. High-capacity T7–T11 special allocations still apply. Siege retains its own presets.</li>
<li><strong>Choose a layer mode.</strong> Recommended automatically sizes combat support layers; Custom layers lets you enter a support-layer size separately for each ranged, cavalry and ground formation. Siege is unaffected.</li>
<li><strong>Select unlocked upper tiers.</strong> Tick T14, T15 and T16 only when those troops are available to you. The calculator also includes its built-in lower-tier layers.</li>
<li><strong>Review the allocation.</strong> Check the calculated layers, reserved troops and total march before copying the composition into the game.</li>
</ol>
<p>Presets are planning aids rather than guaranteed combat outcomes. Check your available troops, march capacity, buffs and current game mechanics before applying a formation.</p>
<h3>Calculate the resources to train those troops</h3>
<p>Open the <a href="/training/">Evony Troop Training Calculator</a> to estimate training resources for T1–T16 units, or use <a href="/resources/">Item Finder</a> to locate recorded resource rewards.</p>
</div></details>
</main>
<script>
import {calculateFormation, displayFormationLayers} from '../../lib/troop-layers.mjs';
const format=n=>n.toLocaleString('en-US');
const baseTiers=Array.from({length:11},(_,i)=>i+3);
const cards=[...document.querySelectorAll('.card')];
let layerMode='recommended';
function setLayerMode(mode){
 layerMode=mode;
 document.getElementById('mode-recommended').setAttribute('aria-pressed',String(mode==='recommended'));
 document.getElementById('mode-custom').setAttribute('aria-pressed',String(mode==='custom'));
 for(const card of cards){
  const customField=card.querySelector('.custom-layer-field');
  if(customField)customField.hidden=mode!=='custom';
  calculate(card);
 }
}
document.getElementById('mode-recommended').addEventListener('click',()=>setLayerMode('recommended'));
document.getElementById('mode-custom').addEventListener('click',()=>setLayerMode('custom'));
const parseMarch=value=>{const digits=String(value).replace(/[^0-9]/g,'');return digits?Math.min(1e10,Number(digits)):0;};
const formatted=value=>format(parseMarch(value));
function calculate(card){
 const type=card.dataset.type;
 const selected=[...baseTiers,...card.querySelectorAll('.tier-input:checked')].map(t=>typeof t==='number'?t:Number(t.value));
 const custom=card.querySelector('.custom-layer');
 const selectedLayer=layerMode==='custom'&&custom?parseMarch(custom.value):undefined;
 const result=calculateFormation(type,parseMarch(card.querySelector('.march').value),selected,selectedLayer===undefined?{}:{layerSize:Math.max(1000,Math.min(1000000,selectedLayer))});
 const presentation=displayFormationLayers(result);
 card.querySelector('.layer-size').textContent=result.march?format(result.layerSize??1000)+' per layer': '0';
 const rows=card.querySelector('.rows');rows.replaceChildren();
 for(const item of presentation.rows){
  const row=document.createElement('div');row.className='result-row';
  const label=document.createElement('span');label.className='tier-label';label.textContent='T'+item.tier;
  const value=document.createElement('strong');value.className='value';value.textContent=format(item.count);
  row.append(label,value);rows.append(row);
 }
 const mainTroops=result.rows.reduce((sum,row)=>sum+row.count,0);
 card.querySelector('.formation-total').textContent=format(mainTroops);
 const perLayer=result.march?result.otherLayers/(3*Math.max(9,...result.tiers)):0;
 card.querySelector('.other-per-layer').textContent=format(perLayer)+' each';
 const warning=card.querySelector('.warn');
 warning.hidden=!result.unallocated;
 warning.textContent=result.total>result.march?'March too small for the required layers by '+format(result.total-result.march):'Cannot allocate '+format(result.unallocated)+' troops without an available top tier.';
}
function formatMarch(input){
 const before=input.value,caret=input.selectionStart??before.length;
 const digitsBefore=before.slice(0,caret).replace(/\D/g,'').length;
 const next=formatted(before);
 input.value=next;
 if(document.activeElement===input){
  let pos=0,seen=0;
  while(pos<next.length&&seen<digitsBefore){if(/\d/.test(next[pos]))seen++;pos++;}
  input.setSelectionRange(pos,pos);
 }
}
for(const card of cards){
 const input=card.querySelector('.march');
 input.addEventListener('input',()=>{formatMarch(input);calculate(card);});
 input.addEventListener('blur',()=>{formatMarch(input);});
 card.querySelectorAll('.tier-input').forEach(box=>box.addEventListener('change',()=>calculate(card)));
 const custom=card.querySelector('.custom-layer');
 if(custom)custom.addEventListener('input',()=>{formatMarch(custom);calculate(card);});
 calculate(card);
}
document.getElementById('clear').addEventListener('click',()=>cards.forEach(c=>{c.querySelector('.march').value='0';calculate(c);}));
document.getElementById('print').addEventListener('click',()=>window.print());
</script></body></html>