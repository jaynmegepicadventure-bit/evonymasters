---
import SiteHeader from '../../components/SiteHeader.astro';
const types=[
 {id:'ranged',label:'Ranged',icon:'🏹',defaultSize:7393200,base:10000},
 {id:'mounted',label:'Cavalry',icon:'🐎',defaultSize:7480700,base:10000},
 {id:'ground',label:'Ground',icon:'🛡️',defaultSize:7500000,base:10000},
 {id:'bigSiege',label:'BIG Siege',icon:'🏰',defaultSize:6013200,base:1000},
 {id:'smallSiege',label:'Small Siege',icon:'🏰',defaultSize:5749450,base:1000},
 {id:'soloSiege',label:'Solo Siege',icon:'🏰',defaultSize:5549800,base:1000}
];
const tiers=[14,15,16];
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="Calculate Evony troop layers with the formulas and allocations from the Troop Layers 2024 workbook."/>
<link rel="icon" href="/favicon.svg"/><title>March Preset | EvonyMasters</title>
<style>
:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#07111e;color:#ecf1f7}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% 0,#172c43,#07111e 62%)}
main{max-width:1590px;padding:32px 20px 70px;margin:auto}h1{margin:0 0 8px;font-size:clamp(1.9rem,3vw,2.8rem);color:#f0c77c}
p{line-height:1.55;color:#b9cbdc}.top{margin-bottom:21px}.top p{max-width:960px;margin:8px 0}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:19px 0}
button{font:inherit;cursor:pointer}.toolbar button{border:1px solid #9f825d;background:#1a354d;color:#ffe2ac;border-radius:8px;padding:10px 14px;font-weight:750}
.scroller{overflow-x:auto;padding-bottom:14px;scrollbar-color:#648099 #102338}
.cols{display:grid;grid-template-columns:repeat(6,minmax(245px,1fr));gap:12px;min-width:1510px;align-items:stretch}
.card{background:#12283c;border:1px solid #3c5871;border-radius:14px;padding:15px;min-width:0;display:flex;flex-direction:column}
.card h2{font-size:1.28rem;color:#efc276;margin:0 0 15px;white-space:nowrap}
.field{font-weight:750;font-size:.84rem;color:#dae6f0;display:block}.march{width:100%;display:block;margin-top:7px;background:#091a2b;border:1px solid #607994;border-radius:8px;color:white;font:inherit;font-weight:700;padding:12px;min-width:0}
.tiers-head{display:flex;justify-content:space-between;align-items:center;margin:16px 0 8px;gap:5px;font-size:.78rem;color:#c3d2df}
.tiers-head button{padding:5px 7px;border:1px solid #577188;color:#d7e8f6;border-radius:6px;background:#213d55}
.tiers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.tier{display:flex;flex-direction:row;align-items:center;justify-content:center;gap:7px;padding:10px 6px;border:1px solid #3e5c73;background:#1a354c;border-radius:6px;font-size:.74rem;white-space:nowrap;cursor:pointer}
.tier input{accent-color:#edbf71;margin:0;width:15px;height:15px}
.results{margin-top:17px;padding-top:12px;border-top:1px solid #3b5268;flex:1}
.results h3{font-size:.91rem;color:#efc77e;margin:0 0 8px}
/* Rows are inserted by client JavaScript, so selectors must be global rather than Astro-scoped. */
:global(.result-row){display:grid;grid-template-columns:minmax(38px,auto) minmax(0,1fr);column-gap:18px;align-items:center;min-height:37px;padding:8px 10px;border-bottom:1px solid #30485d;background:rgba(4,18,30,.14);font-size:.91rem}
:global(.result-row:nth-child(even)){background:rgba(50,79,104,.17)}
:global(.result-row .tier-label){font-weight:800;color:#efcf99;text-align:left;white-space:nowrap}
:global(.result-row .value){display:block;text-align:right;justify-self:end;font-variant-numeric:tabular-nums;font-weight:800;color:#f4eedb;white-space:nowrap}
.rows{border:1px solid #30485d;border-radius:9px;overflow:hidden}
:global(.result-row:last-child){border-bottom:0}
.summary{margin-top:11px;display:flex;justify-content:space-between;align-items:center;font-weight:800;font-size:.93rem}
.summary output{color:#f3c678;font-variant-numeric:tabular-nums}
.stat{color:#b3c8d9;font-size:.74rem;margin:9px 0 0}.stat strong{color:#eaf1f8}.warn{color:#ffd38b;font-size:.78rem;padding:8px;border:1px solid #a9844c;border-radius:6px}
.tip{font-size:.78rem;color:#a9bccf}
@media(max-width:700px){main{padding:24px 12px 55px}.cols{min-width:0;grid-template-columns:1fr}.scroller{overflow:visible}.card{padding:17px} .tiers{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(min-width:701px) and (max-width:1250px){.cols{min-width:1210px;grid-template-columns:repeat(6,1fr)} .tiers{grid-template-columns:repeat(3,minmax(0,1fr))}.tier{flex-direction:row;justify-content:center;gap:5px}}
@media print{.site-header,.toolbar,.tiers-head button{display:none!important}body{background:white;color:black}.scroller{overflow:visible}.cols{display:grid;grid-template-columns:repeat(3,1fr);min-width:0}.card{break-inside:avoid;color:black;background:white}:global(.result-row .value){color:black}}
</style></head>
<body><SiteHeader active="troops"/><main>
<div class="top"><h1>March Preset</h1><p>Built from the Troop Layers 2024 workbook. Enter march sizes and select which upper troop tiers you have (T14–T16). T3–T13 are always included. T1–T9 defaults for all four troop types and T10+ defaults for the other three types are reserved before the main formation is calculated.</p></div>
<div class="toolbar"><button type="button" id="clear">Clear march sizes</button><button type="button" id="reset">Restore Excel examples</button><button type="button" id="print">Print results</button></div>
<div class="scroller"><div class="cols">{types.map(t=><section class="card" data-type={t.id}>
<h2>{t.icon} {t.label}</h2>
<label class="field">March size<input class="march" type="text" inputmode="numeric" autocomplete="off" value="" aria-label={t.label+' march size'}/></label>
<div class="tiers-head"><strong>Upper troop tiers</strong><span>T3–T13 included</span></div>
<div class="tiers">{tiers.map(tier=><label class="tier"><input type="checkbox" class="tier-input" value={tier} checked={false}/><span>T{tier}</span></label>)}</div>
<div class="results"><h3>Calculated layers</h3><div class="rows" aria-live="polite"></div>
<div class="stat">Own T1–T9 defaults: <strong class="own-base">0</strong></div><div class="stat">Other 3 troop types: <strong class="reserved">0</strong></div><div class="stat">Extra fixed layers: <strong class="extra-fixed">0</strong></div><div class="stat excel-adjustment-row" hidden>Additional Excel layer reserve: <strong class="excel-adjustment">0</strong></div><p class="warn" hidden></p>
<div class="stat">Main formation troops: <strong class="remaining">0</strong></div>
<div class="summary"><span>Total march</span><output class="total">0</output></div></div>
</section>)}</div></div>
<p class="tip">The workbook contains six separate formations, including three Siege variants. T1–T9 include default layers across all four troop types. Other troop types above T9 are deducted before proportional top-tier allocations. Percentages remain hidden.</p>
</main>
<script>
import {calculateFormation, displayFormationLayers, REFERENCE_EXAMPLES} from '../../lib/troop-layers.mjs';
const format=n=>n.toLocaleString('en-US');
const baseTiers=Array.from({length:11},(_,i)=>i+3);
const cards=[...document.querySelectorAll('.card')];
const parseMarch=value=>{const digits=String(value).replace(/[^0-9]/g,'');return digits?Math.min(1e10,Number(digits)):0;};
const formatted=value=>format(parseMarch(value));
function calculate(card){
 const type=card.dataset.type;
 const selected=[...baseTiers,...card.querySelectorAll('.tier-input:checked')].map(t=>typeof t==='number'?t:Number(t.value));
 const result=calculateFormation(type,parseMarch(card.querySelector('.march').value),selected);
 const presentation=displayFormationLayers(result);
 const rows=card.querySelector('.rows');rows.replaceChildren();
 for(const item of presentation.rows){
  const row=document.createElement('div');row.className='result-row';
  const label=document.createElement('span');label.className='tier-label';label.textContent='T'+item.tier;
  const value=document.createElement('strong');value.className='value';value.textContent=format(item.count);
  row.append(label,value);rows.append(row);
 }
 card.querySelector('.reserved').textContent=format(presentation.otherSupport);
 card.querySelector('.own-base').textContent=format(result.ownLayers);
 card.querySelector('.extra-fixed').textContent=format(result.extraFixed);
 const excelRow=card.querySelector('.excel-adjustment-row');
 excelRow.hidden=!result.excelAdjustment;
 card.querySelector('.excel-adjustment').textContent=format(result.excelAdjustment);
 const warning=card.querySelector('.warn');
 warning.hidden=!result.unallocated;
 warning.textContent=result.total>result.march?'March too small for the required layers by '+format(result.total-result.march):'Cannot allocate '+format(result.unallocated)+' troops without an available top tier.';
 card.querySelector('.remaining').textContent=format(result.remaining);
 card.querySelector('.total').textContent=format(result.total);
}
function formatMarch(input){
 const before=input.value,caret=input.selectionStart??before.length;
 const digitsBefore=before.slice(0,caret).replace(/\D/g,'').length;
 const next=formatted(before);
 input.value=next;
 if(document.activeElement===input){
  let pos=0,seen=0;
  while(pos<next.length&&seen<digitsBefore){if(/\d/.test(next[pos]))seen++;pos++;}
  input.setSelectionRange(pos,pos);
 }
}
for(const card of cards){
 const input=card.querySelector('.march');
 input.addEventListener('input',()=>{formatMarch(input);calculate(card);});
 input.addEventListener('blur',()=>{formatMarch(input);});
 card.querySelectorAll('.tier-input').forEach(box=>box.addEventListener('change',()=>calculate(card)));
 calculate(card);
}
document.getElementById('clear').addEventListener('click',()=>cards.forEach(c=>{c.querySelector('.march').value='0';calculate(c);}));
document.getElementById('reset').addEventListener('click',()=>cards.forEach(c=>{
 const example=REFERENCE_EXAMPLES[c.dataset.type];
 c.querySelector('.march').value=format(example.size);
 c.querySelectorAll('.tier-input').forEach(i=>i.checked=example.tiers.includes(Number(i.value)));
 calculate(c);
}));
document.getElementById('print').addEventListener('click',()=>window.print());
</script></body></html>