---
import SiteHeader from '../../components/SiteHeader.astro';
import defaults from '../../data/troop-layer-percentages.json';
const types=[{key:'ground',name:'Ground',icon:'🛡️'},{key:'ranged',name:'Archers',icon:'🏹'},{key:'mounted',name:'Mounted',icon:'🐎'},{key:'siege',name:'Siege',icon:'🏰'}];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><title>Troop Layer Calculator | EvonyMasters</title>
<style>
:root{font-family:Inter,system-ui,sans-serif;color:#eef4fb;background:#07111e}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#20344c,#07111e 62%)}main{max-width:1300px;padding:34px 20px 80px;margin:auto}h1{font-size:clamp(2rem,4vw,3.2rem);color:#f2cb7d;margin:0 0 10px}p{line-height:1.55;color:#b9cadc}.intro{margin-bottom:26px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.troop{background:#12283d;border:1px solid #48617a;border-radius:14px;padding:19px;min-width:0}.troop h2{color:#f3cc81;font-size:1.4rem;margin:0 0 15px}.field{display:block;font-size:.83rem;color:#d0dfed;font-weight:700;margin-bottom:13px}.field input{display:block;width:100%;margin-top:7px;padding:12px;border-radius:8px;border:1px solid #627c95;background:#071725;color:white;font:inherit}.field input:focus-visible,.tier input:focus-visible,button:focus-visible{outline:2px solid #ffd28c;outline-offset:3px}.tier-header{display:flex;justify-content:space-between;gap:8px;align-items:center;margin:17px 0 7px;color:#c6d9e8;font-size:.79rem}.tier-header button{border:1px solid #61768d;border-radius:6px;background:#234057;color:#e8eff6;cursor:pointer;padding:5px}.tier-list{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.tier{display:flex;gap:4px;align-items:center;justify-content:center;padding:8px 3px;border:1px solid #415d74;border-radius:7px;background:#1a3349;font-size:.76rem;cursor:pointer}.tier input{accent-color:#e6ba68}.out{margin-top:17px;padding-top:14px;border-top:1px solid #496177}.out h3{font-size:.92rem;color:#f1cc85;margin:0 0 10px}.layer{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid #28435b;font-size:.88rem}.layer strong{font-variant-numeric:tabular-nums;color:#f9f0d7}.summary{display:flex;align-items:center;justify-content:space-between;margin-top:12px;font-weight:800}.summary output{color:#e8bf76}.notice{font-size:.82rem;color:#a6bbcd}.actions{margin:18px 0;display:flex;flex-wrap:wrap;gap:8px}button.action{border:1px solid #bb955e;background:#2d4556;color:#fff1d1;border-radius:8px;padding:10px 14px;font-weight:750;cursor:pointer}@media(max-width:1100px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:610px){.grid{grid-template-columns:1fr}main{padding:25px 14px}}@media print{.site-header,.actions,.tier-header button{display:none}body{background:#fff;color:#000}.troop{break-inside:avoid}}
</style></head><body><SiteHeader/><main><h1>Troop Layer Calculator</h1><p><a href="/admin/" style="color:#f2cb7d">Admin settings</a></p><p class="intro">Enter your march size for each troop type and tick the tiers you own. Your troop layers are calculated automatically. Percentages are kept off this player-facing page.</p>
<div class="actions"><button type="button" class="action" id="all-tiers">Select all tiers</button><button type="button" class="action" id="reset">Reset calculator</button><button type="button" class="action" id="print">Print results</button></div>
<div class="grid">{types.map(type=><section class="troop" data-type={type.key}><h2>{type.icon} {type.name}</h2><label class="field">March size<input class="march" type="number" inputmode="numeric" min="0" step="1" value="0" aria-label={type.name+' march size'}/></label><div class="tier-header"><strong>Available troop tiers</strong><button type="button" class="select-tiers">All / None</button></div><div class="tier-list">{defaults.tiers.map(tier=><label class="tier"><input type="checkbox" class="tier-choice" value={tier} checked/>{tier}</label>)}</div><div class="out"><h3>Calculated layers</h3><div class="layers" aria-live="polite"></div><div class="summary"><span>Total troops</span><output class="total">0</output></div></div></section>)}</div><p class="notice">Each troop type is calculated independently. The highest selected tier receives the highest-tier weight, followed by the second-highest and so on. Percentages are editable in admin and remain hidden from players.</p></main>
<script define:vars={{defaults}}>
const key='evonymasters.troopCalc.percentages.v2';const format=n=>Math.round(n).toLocaleString();
function valid(config){return config&&config.types&&['ground','ranged','mounted','siege'].every(k=>Array.isArray(config.types[k])&&config.types[k].length===16&&config.types[k].every(n=>Number.isFinite(n)&&n>=0));}
let settings=defaults;try{const saved=JSON.parse(localStorage.getItem(key)||'null');if(valid(saved))settings=saved;}catch{}
function calculate(card){const type=card.dataset.type;const raw=Number(card.querySelector('.march').value);const size=Number.isFinite(raw)?Math.min(10000000000,Math.max(0,Math.floor(raw))):0;const selected=[...card.querySelectorAll('.tier-choice')].filter(i=>i.checked).map(i=>Number(i.value.slice(1))-1);const weights=settings.types[type];selected.sort((a,b)=>b-a);let denom=selected.reduce((s,i,rank)=>s+weights[rank],0);if(!denom&&selected.length)denom=selected.length;const portions=selected.map((i,rank)=>({i,exact:size*(denom===selected.length&&!weights.slice(0,selected.length).some(w=>w>0)?1:weights[rank])/denom}));let allocated=portions.reduce((s,p)=>s+Math.floor(p.exact),0);portions.sort((a,b)=>(b.exact%1)-(a.exact%1)||b.i-a.i);for(let i=0;i<size-allocated&&i<portions.length;i++)portions[i].extra=1;portions.sort((a,b)=>b.i-a.i);const results=card.querySelector('.layers');results.replaceChildren();for(const p of portions){const line=document.createElement('div');line.className='layer';const name=document.createElement('span');name.textContent='T'+(p.i+1);const count=document.createElement('strong');count.textContent=format(Math.floor(p.exact)+(p.extra||0));line.append(name,count);results.append(line);}if(!portions.length){const msg=document.createElement('p');msg.className='notice';msg.textContent='Select at least one tier.';results.append(msg);}card.querySelector('.total').textContent=format(portions.reduce((s,p)=>s+Math.floor(p.exact)+(p.extra||0),0));}
const cards=[...document.querySelectorAll('.troop')];for(const c of cards){c.querySelector('.march').addEventListener('input',()=>calculate(c));c.querySelectorAll('.tier-choice').forEach(t=>t.addEventListener('change',()=>calculate(c)));c.querySelector('.select-tiers').addEventListener('click',()=>{const boxes=[...c.querySelectorAll('.tier-choice')];const next=!boxes.every(b=>b.checked);boxes.forEach(b=>b.checked=next);calculate(c);});calculate(c);}
document.getElementById('all-tiers').addEventListener('click',()=>cards.forEach(c=>{c.querySelectorAll('.tier-choice').forEach(b=>b.checked=true);calculate(c);}));
document.getElementById('reset').addEventListener('click',()=>cards.forEach(c=>{c.querySelector('.march').value='0';c.querySelectorAll('.tier-choice').forEach(b=>b.checked=true);calculate(c);}));
document.getElementById('print').addEventListener('click',()=>window.print());
window.addEventListener('storage',e=>{if(e.key===key){try{const next=JSON.parse(e.newValue);settings=valid(next)?next:defaults;}catch{settings=defaults;}cards.forEach(c=>calculate(c));}});
</script></body></html>