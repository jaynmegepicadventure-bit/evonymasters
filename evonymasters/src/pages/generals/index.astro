---
import SiteHeader from '../../components/SiteHeader.astro';
import buffs from '../../data/buffs.json';
const types=['General','Monarch','Research','Equipment'];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Search Evony generals and their recorded buffs and debuffs."/><link rel="icon" href="/favicon.svg"/><title>General Buff Finder | evonymasters</title>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#eaf0f8;background:#0c1726}*{box-sizing:border-box}body{margin:0}a{color:inherit}.wrap{max-width:1150px;margin:auto;padding:0 22px}.hero{padding:60px 0 40px;background:radial-gradient(circle at 80% 10%,#234667 0,transparent 55%)}.eyebrow{color:#e6bc73;text-transform:uppercase;letter-spacing:.17em;font-size:.76rem;font-weight:800}h1{font-size:clamp(2.3rem,5vw,4rem);line-height:1.07;margin:12px 0 16px;letter-spacing:-.045em}.intro{max-width:720px;color:#bbccdd;line-height:1.65;font-size:1.06rem}.panel{background:#152b43;border:1px solid #35516d;border-radius:18px;padding:24px;margin:26px 0 16px;box-shadow:0 15px 40px #0002}.filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px}label{font-size:.83rem;font-weight:700;color:#cfdeec;display:block;margin-bottom:8px}input,select{width:100%;border:1px solid #55708b;background:#0b1d30;color:#fff;padding:13px;border-radius:9px;font:inherit;min-height:48px}input:focus,select:focus{outline:2px solid #e6bc73;outline-offset:2px}input::placeholder{color:#a5b8cb}.note,.meta{color:#b6c8d9;font-size:.87rem;line-height:1.6}.results-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:28px 0 18px}h2{font-size:1.4rem;margin:0}.grid{margin-bottom:60px;overflow-x:auto;border:1px solid #35516d;border-radius:18px;background:linear-gradient(180deg,#172f49,#10243a);box-shadow:0 15px 40px #0003}.results-table{width:100%;border-collapse:separate;border-spacing:0;min-width:900px}.results-table th,.results-table td{padding:15px 18px;text-align:left;vertical-align:middle}.results-table th{background:#10243a;color:#e6bc73;font-size:.75rem;text-transform:uppercase;letter-spacing:.09em;border-bottom:1px solid #46627d;white-space:nowrap}.results-table td{font-size:.91rem;border-bottom:1px solid #2d465f}.results-table tbody tr:hover{background:#203b55}.results-table tbody tr:last-child td{border-bottom:0}.value{font-weight:850;color:#f2ce88;white-space:nowrap}.empty{border:1px dashed #56708b;border-radius:15px;padding:40px 24px;text-align:center;color:#c5d5e4;margin-bottom:60px}.empty strong{display:block;color:white;font-size:1.15rem;margin-bottom:8px}footer{border-top:1px solid #30445c;padding:24px 0;color:#a9bdcf;font-size:.82rem}@media(max-width:820px){.filters{grid-template-columns:1fr 1fr}}@media(max-width:530px){.filters{grid-template-columns:1fr}.hero{padding-top:35px}.panel{padding:17px}}
</style></head><body>
<SiteHeader active="generals" />
<main><section class="hero"><div class="wrap"><div class="eyebrow"><a href="/">Player tools</a> / Generals</div><h1>Find buffs and debuffs</h1><p class="intro">Search generals and other buff sources by name, buff, debuff, or condition. General specialties, ascending stars, covenants and base general buffs can be tracked independently.</p>
<div class="panel"><div class="filters"><div><label for="query">Find a buff or general</label><input id="query" type="search" placeholder="Search general, buff, debuff or condition…" autocomplete="off"/></div><div><label for="type">Type</label><select id="type"><option value="">All types</option>{types.map(t=><option value={t}>{t}</option>)}</select></div><div><label for="sort">Sort by</label><select id="sort"><option value="value">Largest value</option><option value="name">Name A–Z</option><option value="buff">Buff name A–Z</option></select></div></div><p class="note">Results stay hidden until you search. The data structure supports General, Monarch, Research and Equipment sources; General-specific fields include specialties, base buff, stars and covenants.</p></div></div></section>
<section class="wrap" aria-live="polite"><div class="results-head"><h2>Buff results</h2><span id="count" class="meta"></span></div><div id="results" class="grid"></div><div id="empty" class="empty" hidden><strong>No matching results</strong><span>Try another name, buff, debuff or condition.</span></div></section></main>
<footer><div class="wrap">evonymasters is an independent fan project and is not affiliated with or endorsed by the game publisher.</div></footer>
<script id="buff-data" type="application/json" set:html={JSON.stringify(buffs).replace(/</g,"\\u003c")} />
<script>
const data=JSON.parse(document.querySelector('#buff-data').textContent);const query=document.querySelector('#query'),type=document.querySelector('#type'),sort=document.querySelector('#sort'),results=document.querySelector('#results'),count=document.querySelector('#count'),empty=document.querySelector('#empty');
const el=(tag,cls,text)=>{const x=document.createElement(tag);if(cls)x.className=cls;if(text!=null)x.textContent=text;return x};const fmt=v=>v==null?'—':(typeof v==='number'?new Intl.NumberFormat('en-US',{maximumFractionDigits:2}).format(v):v);
function render(){const q=query.value.trim().toLowerCase();results.replaceChildren();if(!q){count.textContent='';empty.hidden=true;return}let rows=data.filter(r=>(!type.value||r.type===type.value)&&Object.values(r).some(v=>String(v??'').toLowerCase().includes(q)));if(sort.value==='value')rows.sort((a,b)=>(Number(b.buffValue)||0)-(Number(a.buffValue)||0));else if(sort.value==='buff')rows.sort((a,b)=>(a.buffName||'').localeCompare(b.buffName||''));else rows.sort((a,b)=>(a.name||'').localeCompare(b.name||''));count.textContent=`${rows.length} result${rows.length===1?'':'s'}`;empty.hidden=rows.length>0;if(!rows.length)return;const table=el('table','results-table'),head=document.createElement('thead'),hr=document.createElement('tr');for(const h of ['Type','Name','Buff / Debuff','Value','Condition','Source Breakdown'])hr.append(el('th','',h));head.append(hr);table.append(head);const body=document.createElement('tbody');for(const r of rows){const tr=document.createElement('tr');tr.append(el('td','',r.type));tr.append(el('td','',r.name));tr.append(el('td','',r.buffName));tr.append(el('td','value',(r.buffDebuff==='debuff'?'-':'+')+fmt(r.buffValue)+(r.unit==='percent'?'%':r.unit?' '+r.unit:'')));tr.append(el('td','',r.condition||'—'));const parts=[['General Buff',r.generalBuff],['Specialty 1',r.specialty1],['Specialty 2',r.specialty2],['Specialty 3',r.specialty3],['Specialty 4',r.specialty4],['Star 1',r.star1],['Star 2',r.star2],['Star 3',r.star3],['Star 4',r.star4],['Star 5',r.star5],['Covenant 1',r.covenant1],['Covenant 2',r.covenant2],['Covenant 3',r.covenant3],['Covenant 4',r.covenant4],['Covenant 5',r.covenant5]].filter(x=>x[1]!=null).map(x=>x[0]+': '+fmt(x[1])+(r.unit==='percent'?'%':''));tr.append(el('td','',parts.join(' · ')||'—'));body.append(tr)}table.append(body);results.append(table)}
for(const x of [query,type,sort])x.addEventListener(x===query?'input':'change',render);render();
</script></body></html>